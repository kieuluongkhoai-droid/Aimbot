local InfoLabel = Instance.new("TextLabel")
InfoLabel.Size = UDim2.new(1, -20, 0, 25)
InfoLabel.Position = UDim2.new(0, 10, 0, 190)
InfoLabel.BackgroundTransparency = 1
InfoLabel.Text = "Status: Ready."
InfoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
InfoLabel.TextSize = 10
InfoLabel.Font = Enum.Font.Gotham
InfoLabel.Parent = MainFrame

local activeClone = nil
local viewingClone = true
local aiEnabled = true

local function getCornerPos(refCF)
    return CFrame.new(refCF.Position + Vector3.new(600, 15, 600))
end

SpawnBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChildOfClass("Humanoid") then
        InfoLabel.Text = "Status: Character not found!"
        return
    end
    
    local hrp = character.HumanoidRootPart
    local currentCF = hrp.CFrame
    
    if activeClone then pcall(function() activeClone:Destroy() end) activeClone = nil end
    
    -- 1. Tạo Clone ở vị trí hiện tại (giữ nguyên ở chỗ cũ để AI điều khiển)
    character.Archivable = true
    activeClone = character:Clone()
    character.Archivable = false
    activeClone.Name = "DirectClone"
    activeClone.Parent = workspace
    activeClone:SetPrimaryPartCFrame(currentCF)
    
    -- 2. Đưa cơ thể thật (Real Body) đến góc bản đồ
    hrp.CFrame = getCornerPos(currentCF)
    
    local cloneHrp = activeClone:FindFirstChild("HumanoidRootPart")
    local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
    
    if cloneHum then Camera.CameraSubject = cloneHum end
    viewingClone = true
    aiEnabled = true
    
    SwitchCamBtn.Text = "👁️ 3. View: [ CLONE ]"
    InfoLabel.Text = "Status: Real body at corner. Clone active."
    
    if _G.DirectSwapConnection then _G.DirectSwapConnection:Disconnect() end
    
    -- Vòng lặp AI điều khiển Clone săn mục tiêu khi AI bật
    _G.DirectSwapConnection = RunService.RenderStepped:Connect(function()
        if activeClone and cloneHum and cloneHrp and aiEnabled then
            local targetHrp = nil
            local minDist = math.huge
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (plr.Character.HumanoidRootPart.Position - cloneHrp.Position).Magnitude
                    if d < minDist then
                        minDist = d
                        targetHrp = plr.Character.HumanoidRootPart
                    end
                end
            end
            if targetHrp then
                cloneHum:MoveTo(targetHrp.Position)
            end
        end
    end)
end)

-- Nút Swap: Đổi chỗ trực tiếp vị trí cho nhau giữa Real Body và Clone, đồng thời bật/tắt AI tương ứng
SwapBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") or not activeClone then
        InfoLabel.Text = "Status: Spawn system first!"
        return
    end
    
    local realHrp = character.HumanoidRootPart
    local cloneHrp = activeClone:FindFirstChild("HumanoidRootPart")
    
    -- Lưu lại tọa độ hiện tại của cả 2 bên
    local realCF = realHrp.CFrame
    local cloneCF = cloneHrp.CFrame
    
    -- Đổi chỗ vị trí cho nhau ngay lập tức
    realHrp.CFrame = cloneCF
    cloneHrp.CFrame = realCF
    
    -- Đảo trạng thái AI: Nếu Real Body vừa nhảy ra vị trí của Clone -> Tắt AI để bạn tự điều khiển. Ngược lại -> Bật AI cho Clone.
    aiEnabled = not aiEnabled
    
    if aiEnabled then
        InfoLabel.Text = "Status: Swapped! Clone is now active with AI."
    else
        InfoLabel.Text = "Status: Swapped! Real body is now active here."
    end
end)

SwitchCamBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not activeClone then
        InfoLabel.Text = "Status: Spawn system first!"
        return
    end
    
    viewingClone = not viewingClone
    local realHum = character:FindFirstChildOfClass("Humanoid")
    local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
    
    if viewingClone then
        if cloneHum then Camera.CameraSubject = cloneHum end
        SwitchCamBtn.Text = "👁️ 3. View: [ CLONE ]"
        SwitchCamBtn.TextColor3 = Color3.fromRGB(100, 200, 255)
        InfoLabel.Text = "Status: Viewing Clone"
    else
        if realHum then Camera.CameraSubject = realHum end
        SwitchCamBtn.Text = "👁️ 3. View: [ REAL BODY ]"
        SwitchCamBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        InfoLabel.Text = "Status: Viewing Real Body"
    end
end)

ResetBtn.MouseButton1Click:Connect(function()
    if _G.DirectSwapConnection then
        _G.DirectSwapConnection:Disconnect()
        _G.DirectSwapConnection = nil
    end
    if activeClone then pcall(function() activeClone:Destroy() end) activeClone = nil end
    
    local character = LocalPlayer.Character
    if character then
        local realHum = character:FindFirstChildOfClass("Humanoid")
        if realHum then 
            Camera.CameraSubject = realHum 
        end
    end
    
    viewingClone = false
    aiEnabled = true
    SwitchCamBtn.Text = "👁️ 3. View: [ REAL BODY ]"
    InfoLabel.Text = "Status: Reset completed."
end)
