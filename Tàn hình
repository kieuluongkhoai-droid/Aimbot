-- Logic Thu nhỏ / Mở rộng (Minimize/Maximize)
local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        MinimizeBtn.Text = "+"
        ToggleBtn.Visible = false
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 200, 0, 35)}):Play()
    else
        MinimizeBtn.Text = "-"
        ToggleBtn.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 200, 0, 95)}):Play()
    end
end)

-- Biến trạng thái Clone
local isCloneActive = false
local cloneChar = nil

-- Hàm xử lý chuyển đổi Hitbox
local function setupCloning(state)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart

    if state then
        -- KÍCH HOẠT: Tạo Clone lên trời
        character.Archivable = true
        cloneChar = character:Clone()
        character.Archivable = false
        
        cloneChar.Name = "ClientHitboxClone"
        
        -- Dọn dẹp script thừa trong clone
        for _, v in ipairs(cloneChar:GetDescendants()) do
            if v:IsA("LocalScript") or v:IsA("Script") then
                v:Destroy()
            end
        end
        
        -- Đưa clone lên trời (5000 mét)
        for _, part in ipairs(cloneChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CFrame = part.CFrame + Vector3.new(0, 5000, 0)
            end
        end
        
        cloneChar.Parent = workspace
        
        -- Làm mờ nhân vật thật bên dưới để tránh trực quan
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.LocalTransparencyModifier = 0.5
            end
        end

        ToggleBtn.Text = "Status: CLONE [SKY]"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
        isCloneActive = true
    else
        -- TẮT: Xóa Clone, trả về bình thường
        if cloneChar then
            cloneChar:Destroy()
            cloneChar = nil
        end
        
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.LocalTransparencyModifier = 0
            end
        end

        ToggleBtn.Text = "Status: Body [SAFE]"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        isCloneActive = false
    end
end

-- Xử lý nút bấm đổi trạng thái
ToggleBtn.MouseButton1Click:Connect(function()
    setupCloning(not isCloneActive)
end)

-- Vòng lặp đồng bộ Camera và chống Anti-Cheat Server Check
RunService.Heartbeat:Connect(function()
    local character = LocalPlayer.Character
    if character and isCloneActive and cloneChar then
        pcall(function()
            -- Cố định camera bám sát người chơi thực tế dưới đất
            Camera.CameraSubject = character:FindFirstChildOfClass("Humanoid")
        end)
    end
end)

-- Xử lý khi nhân vật chết hoặc reset
LocalPlayer.CharacterAdded:Connect(function()
    isCloneActive = false
    if cloneChar then
        cloneChar:Destroy()
        cloneChar = nil
    end
    ToggleBtn.Text = "Status: Body [SAFE]"
    ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
end)
