-- Logic thu nhỏ UI
local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        MinimizeBtn.Text = "+"
        ToggleBtn.Visible = false
        SwapBtn.Visible = false
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 220, 0, 35)}):Play()
    else
        MinimizeBtn.Text = "-"
        ToggleBtn.Visible = true
        SwapBtn.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 220, 0, 140)}):Play()
    end
end)

-- Biến trạng thái
local cloneChar = nil
local isAnchorActive = false

local function setModelTransparency(model, transparency)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Decal") then
            part.Transparency = transparency
        end
    end
end

-- Khởi tạo Clone
local function initializeClone()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    if not cloneChar or not cloneChar.Parent then
        character.Archivable = true
        cloneChar = character:Clone()
        character.Archivable = false
        
        for _, v in ipairs(cloneChar:GetDescendants()) do
            if v:IsA("LocalScript") or v:IsA("Script") then v:Destroy() end
        end
        cloneChar.Name = "TwoButtonClone"
        cloneChar.Parent = workspace
        cloneChar:SetPrimaryPartCFrame(character.HumanoidRootPart.CFrame)
        setModelTransparency(cloneChar, 0)
    end
end

-- Nút 1: Bật/Tắt trạng thái bảo vệ (Hitbox thật lên trời, Clone ở dưới tháp)
ToggleBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local realHrp = character.HumanoidRootPart

    if not isAnchorActive then
        initializeClone()
        local cloneHrp = cloneChar:FindFirstChild("HumanoidRootPart")
        if cloneHrp then
            local currentPos = realHrp.CFrame
            
            -- Đưa hitbox thật lên trời 3000m để né đòn
            realHrp.CFrame = currentPos + Vector3.new(0, 3000, 0)
            -- Đặt Clone xuống dưới tháp
            cloneHrp.CFrame = currentPos
            
            setModelTransparency(character, 1)
            setModelTransparency(cloneChar, 0)
            
            if cloneChar:FindFirstChild("Humanoid") then
                Camera.CameraSubject = cloneChar.Humanoid
            end
            
            isAnchorActive = true
            ToggleBtn.Text = "🛡️ Mode: ON (Protected)"
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
        end
    else
        local cloneHrp = cloneChar and cloneChar:FindFirstChild("HumanoidRootPart")
        if cloneHrp then
            realHrp.CFrame = cloneHrp.CFrame
        end
        
        if cloneChar then
            cloneChar:Destroy()
            cloneChar = nil
        end
        
        setModelTransparency(character, 0)
        if character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = character.Humanoid
        end
        
        isAnchorActive = false
        ToggleBtn.Text = "🛡️ Mode: OFF (Normal)"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
    end
end)

-- Nút 2: Chức năng Hoán đổi vị trí độc lập giữa Nhân vật gốc và Clone
SwapBtn.MouseButton1Click:Connect(function()
    if not isAnchorActive or not cloneChar then return end
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local realHrp = character.HumanoidRootPart
    local cloneHrp = cloneChar:FindFirstChild("HumanoidRootPart")
    
    if cloneHrp then
        -- Lưu tạm tọa độ hiện tại của cả hai
        local realCF = realHrp.CFrame
        local cloneCF = cloneHrp.CFrame
        
        -- Thực hiện hoán đổi tọa độ cho nhau
        realHrp.CFrame = cloneCF
        cloneHrp.CFrame = realCF
        
        -- Tự động chuyển góc nhìn Camera và độ mờ theo vị trí thực tế sau khi đổi chỗ
        if realHrp.Position.Y < 1000 then
            setModelTransparency(character, 0)
            setModelTransparency(cloneChar, 1)
            if character:FindFirstChild("Humanoid") then
                Camera.CameraSubject = character.Humanoid
            end
        else
            setModelTransparency(character, 1)
            setModelTransparency(cloneChar, 0)
            if cloneChar:FindFirstChild("Humanoid") then
                Camera.CameraSubject = cloneChar.Humanoid
            end
        end
    end
end)

-- Reset khi nhân vật chết hoặc hồi sinh
LocalPlayer.CharacterAdded:Connect(function()
    isAnchorActive = false
    if cloneChar then
        cloneChar:Destroy()
        cloneChar = nil
    end
    ToggleBtn.Text = "🛡️ Mode: OFF (Normal)"
    ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
end)
