local activeClone = nil
local activeSeat = nil
local viewingClone = true
local isRealSeated = true -- true: Real body đang ngồi ở ghế, false: Real body đang đứng ở vị trí clone

SpawnBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChildOfClass("Humanoid") then
        InfoLabel.Text = "Status: Character not found!"
        return
    end
    
    local hrp = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local currentCF = hrp.CFrame
    
    if activeClone then pcall(function() activeClone:Destroy() end) activeClone = nil end
    if activeSeat then pcall(function() activeSeat:Destroy() end) activeSeat = nil end
    
    -- 1. Tạo ghế ô tô ẩn ngay dưới vị trí hiện tại
    activeSeat = Instance.new("Seat")
    activeSeat.Name = "HiddenArmorSeat"
    activeSeat.Size = Vector3.new(3, 1, 3)
    activeSeat.CFrame = currentCF
    activeSeat.Anchored = false
    activeSeat.CanCollide = false
    activeSeat.Transparency = 1
    activeSeat.Parent = workspace
    
    -- Cho nhân vật thật ngồi xuống ghế
    humanoid.Sit = true
    task.wait(0.1)
    activeSeat:Sit(humanoid)
    
    -- Tàng hình nhân vật thật
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = 1
        end
    end
    
    -- 2. Tạo Clone xuất hiện trên mặt đất (cách một khoảng nhỏ)
    character.Archivable = true
    activeClone = character:Clone()
    character.Archivable = false
    activeClone.Name = "AI_Swap_Clone"
    activeClone.Parent = workspace
    activeClone:SetPrimaryPartCFrame(currentCF + Vector3.new(0, 3, 0))
    
    local cloneHrp = activeClone:FindFirstChild("HumanoidRootPart")
    local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
    
    if cloneHum then Camera.CameraSubject = cloneHum end
    viewingClone = true
    isRealSeated = true
    
    SwitchCamBtn.Text = "👁️ 3. View: [ CLONE ]"
    SwapBtn.Text = "🔄 2. Swap Pos: [ REAL BODY: SEATED ]"
    InfoLabel.Text = "Status: Real body seated securely. Clone active."
    
    if _G.SwapProxyConnection then _G.SwapProxyConnection:Disconnect() end
    
    -- 3. AI điều khiển Clone săn mục tiêu
    _G.SwapProxyConnection = RunService.RenderStepped:Connect(function()
        if activeClone and cloneHum and cloneHrp then
            local targetHrp = nil
            local minDist = math.huge
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (plr.Character.HumanoidRootPart.Position - cloneHrp.Position).Magnitude
                    if d < minDist then
                        minDist = d
                        targetHrp = plr.Character.HumanoidRootPart
                    end
                end
            end
            if targetHrp then
                cloneHum:MoveTo(targetHrp.Position)
            end
        end
    end)
end)

-- Nút SWAP vị trí qua lại cực kỳ linh hoạt
SwapBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") or not activeClone or not activeSeat then
        InfoLabel.Text = "Status: Spawn system first!"
        return
    end
    
    local realHrp = character.HumanoidRootPart
    local realHum = character:FindFirstChildOfClass("Humanoid")
    local cloneHrp = activeClone:FindFirstChild("HumanoidRootPart")
    
    if isRealSeated then
        -- TRƯỜNG HỢP 1: Từ Real Body (Đang ngồi ghế) -> Đổi chỗ với Clone
        -- Hủy trạng thái ngồi của Real body, dịch chuyển Real body lên vị trí của Clone
        realHum.Sit = false
        task.wait(0.05)
        realHrp.CFrame = cloneHrp.CFrame
        
        -- Mang ghế và bắt Clone dịch chuyển xuống dưới ngồi vào ghế
        activeSeat.CFrame = realHrp.CFrame - Vector3.new(0, 3, 0)
        local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
        if cloneHum then
            cloneHum.Sit = true
            activeSeat:Sit(cloneHum)
        end
        
        isRealSeated = false
        SwapBtn.Text = "🔄 2. Swap Pos: [ REAL BODY: STANDING ]"
        SwapBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        InfoLabel.Text = "Status: Swapped! Real body is now at Clone pos."
    else
        -- TRƯỜNG HỢP 2: Từ vị trí Clone -> Trở lại vị trí Real Body (Ngồi ghế)
        local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
        if cloneHum then cloneHum.Sit = false end
        task.wait(0.05)
        
        -- Đưa Clone ra chỗ khác hoặc cho nó đứng dậy
        cloneHrp.CFrame = realHrp.CFrame + Vector3.new(0, 3, 0)
        
        -- Kéo Real body trở lại vị trí chiếc ghế ở dưới và cho ngồi xuống cố định
        realHrp.CFrame = activeSeat.CFrame + Vector3.new(0, 2, 0)
        realHum.Sit = true
        activeSeat:Sit(realHum)
        
        isRealSeated = true
        SwapBtn.Text = "🔄 2. Swap Pos: [ REAL BODY: SEATED ]"
        SwapBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        InfoLabel.Text = "Status: Swapped back! Real body is safely seated."
    end
end)

SwitchCamBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not activeClone then
        InfoLabel.Text = "Status: Spawn system first!"
        return
    end
    
    viewingClone = not viewingClone
    local realHum = character:FindFirstChildOfClass("Humanoid")
    local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
    
    if viewingClone then
        if cloneHum then Camera.CameraSubject = cloneHum end
        SwitchCamBtn.Text = "👁️ 3. View: [ CLONE ]"
        SwitchCamBtn.TextColor3 = Color3.fromRGB(100, 200, 255)
        InfoLabel.Text = "Status: Viewing Clone"
    else
        if realHum then Camera.CameraSubject = realHum end
        SwitchCamBtn.Text = "👁️ 3. View: [ REAL BODY ]"
        SwitchCamBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        InfoLabel.Text = "Status: Viewing Real Body"
    end
end)

ResetBtn.MouseButton1Click:Connect(function()
    if _G.SwapProxyConnection then
        _G.SwapProxyConnection:Disconnect()
        _G.SwapProxyConnection = nil
    end
    if activeClone then pcall(function() activeClone:Destroy() end) activeClone = nil end
    if activeSeat then pcall(function() activeSeat:Destroy() end) activeSeat = nil end
    
    local character = LocalPlayer.Character
    if character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 0
            end
        end
        local realHum = character:FindFirstChildOfClass("Humanoid")
        if realHum then 
            realHum.Sit = false
            Camera.CameraSubject = realHum 
        end
    end
    
    viewingClone = false
    isRealSeated = true
    SwapBtn.Text = "🔄 2. Swap Pos: [ REAL BODY: SEATED ]"
    SwitchCamBtn.Text = "👁️ 3. View: [ REAL BODY ]"
    InfoLabel.Text = "Status: Reset completed."
end)
