--[[
    King Tower - Chaos Godmode & Server Damage Breaker Hub
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

if _G.ChaosGodConnection then
    pcall(function() _G.ChaosGodConnection:Disconnect() end)
    _G.ChaosGodConnection = nil
end

pcall(function()
    if CoreGui:FindFirstChild("ChaosGodUI") then
        CoreGui.ChaosGodUI:Destroy()
    end
end)

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ChaosGodUI"
ScreenGui.ResetOnSpawn = false
pcall(function() ScreenGui.Parent = CoreGui end)
if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 260, 0, 180)
MainFrame.Position = UDim2.new(0, 50, 0, 150)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICornerMain = Instance.new("UICorner")
UICornerMain.CornerRadius = UDim.new(0, 12)
UICornerMain.Parent = MainFrame

local UIStroke = Instance.new("UIStroke")
UIStroke.Thickness = 2
UIStroke.Color = Color3.fromRGB(255, 50, 50)
UIStroke.Parent = MainFrame

local TitleLabel = Instance.new("TextLabel")
TitleLabel.Size = UDim2.new(1, 0, 0, 35)
TitleLabel.BackgroundTransparency = 1
TitleLabel.Text = "🔥 Chaos Godmode Hub"
TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TitleLabel.TextSize = 11
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.Parent = MainFrame

local Container = Instance.new("Frame")
Container.Size = UDim2.new(1, -20, 0, 90)
Container.Position = UDim2.new(0, 10, 0, 40)
Container.BackgroundTransparency = 1
Container.Parent = MainFrame

local GodToggleBtn = Instance.new("TextButton")
GodToggleBtn.Size = UDim2.new(1, 0, 0, 38)
GodToggleBtn.Position = UDim2.new(0, 0, 0, 0)
GodToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
GodToggleBtn.TextColor3 = Color3.fromRGB(255, 50, 50)
GodToggleBtn.TextSize = 11
GodToggleBtn.Font = Enum.Font.GothamBold
GodToggleBtn.Text = "💀 Chaos Godmode: [ OFF ]"
GodToggleBtn.Parent = Container

local UIC_1 = Instance.new("UICorner") UIC_1.CornerRadius = UDim.new(0, 6) UIC_1.Parent = GodToggleBtn

local ResetBtn = Instance.new("TextButton")
ResetBtn.Size = UDim2.new(1, 0, 0, 38)
ResetBtn.Position = UDim2.new(0, 0, 0, 46)
ResetBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
ResetBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
ResetBtn.TextSize = 11
ResetBtn.Font = Enum.Font.GothamBold
ResetBtn.Text = "🔄 Reset Normal State"
ResetBtn.Parent = Container

local UIC_2 = Instance.new("UICorner") UIC_2.CornerRadius = UDim.new(0, 6) UIC_2.Parent = ResetBtn

local InfoLabel = Instance.new("TextLabel")
InfoLabel.Size = UDim2.new(1, -20, 0, 25)
InfoLabel.Position = UDim2.new(0, 10, 0, 140)
InfoLabel.BackgroundTransparency = 1
InfoLabel.Text = "Status: Ready."
InfoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
InfoLabel.TextSize = 10
InfoLabel.Font = Enum.Font.Gotham
InfoLabel.Parent = MainFrame

local isGodActive = false

GodToggleBtn.MouseButton1Click:Connect(function()
    isGodActive = not isGodActive
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        InfoLabel.Text = "Status: Character not found!"
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if isGodActive then
        GodToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        GodToggleBtn.Text = "💀 Chaos Godmode: [ ACTIVE ]"
        InfoLabel.Text = "Status: Server damage calculation blinded!"
        
        if humanoid then
            humanoid.MaxHealth = math.huge
            humanoid.Health = math.huge
            humanoid.BreakJointsOnDeath = false
        end
        
        -- Chặn đứng mọi kết nối va chạm vật lý truyền về server gây mất máu
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanTouch = false
                part.CanQuery = false
            end
        end
        
        -- Vòng lặp "ép xác" server: khóa cứng máu ở mức vô hạn liên tục từng mili-giây
        if _G.ChaosGodConnection then _G.ChaosGodConnection:Disconnect() end
        _G.ChaosGodConnection = RunService.Heartbeat:Connect(function()
            if character and character.Parent and humanoid then
                if humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = humanoid.MaxHealth
                end
                -- Nếu server cố tình ép chết nhân vật, lập tức can thiệp xóa trạng thái chết
                if humanoid:GetState() == Enum.HumanoidStateType.Dead then
                    humanoid:ChangeState(Enum.HumanoidStateType.Running)
                end
            end
        end)
    else
        GodToggleBtn.TextColor3 = Color3.fromRGB(255, 50, 50)
        GodToggleBtn.Text = "💀 Chaos Godmode: [ OFF ]"
        InfoLabel.Text = "Status: Chaos Mode Disabled."
        
        if _G.ChaosGodConnection then
            _G.ChaosGodConnection:Disconnect()
            _G.ChaosGodConnection = nil
        end
        
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanTouch = true
                part.CanQuery = true
            end
        end
    end
end)

ResetBtn.MouseButton1Click:Connect(function()
    if _G.ChaosGodConnection then
        _G.ChaosGodConnection:Disconnect()
        _G.ChaosGodConnection = nil
    end
    isGodActive = false
    GodToggleBtn.TextColor3 = Color3.fromRGB(255, 50, 50)
    GodToggleBtn.Text = "💀 Chaos Godmode: [ OFF ]"
    InfoLabel.Text = "Status: Reset completed."
end)

LocalPlayer.CharacterAdded:Connect(function()
    if _G.ChaosGodConnection then
        _G.ChaosGodConnection:Disconnect()
        _G.ChaosGodConnection = nil
    end
    isGodActive = false
end)
