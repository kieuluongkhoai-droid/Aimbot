    return btn
end

local skyCloneBtn = createButton(45, "Bật Sky Clone & Free Cam: TẮT")
local antiKBBtn = createButton(85, "Bật Micro Anti-KB (Siêu Nhạy): TẮT")
local resetBtn = createButton(125, "Khôi Phục / Reset Nhân Vật")

-- Biến trạng thái
local skyActive = false
local antiKBActive = false

local cloneModel = nil
local skyConnection = nil
local antiKBConnection = nil
local freeCamConnection = nil

local lastSafeCFrame = nil
local lastCheckTick = 0
local freeCamCF = nil

-- =====================================================================
-- PHẦN 1: SKY CLONE & TỰ ĐỘNG CHUYỂN CAMERA SANG CLONE / FREE CAM
-- =====================================================================
skyCloneBtn.MouseButton1Click:Connect(function()
    skyActive = not skyActive
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not rootPart or not humanoid or not head then return end
    
    if skyActive then
        skyCloneBtn.Text = "Bật Sky Clone & Free Cam: BẬT"
        skyCloneBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        lastSafeCFrame = rootPart.CFrame
        freeCamCF = rootPart.CFrame
        
        -- 1. Tạo bản sao giả lập (Clone) đặt ở trên trời cao (+15 mét)
        char.Archivable = true
        cloneModel = char:Clone()
        cloneModel.Name = "SkyVisualClone"
        
        for _, desc in pairs(cloneModel:GetDescendants()) do
            if desc:IsA("Script") or desc:IsA("LocalScript") then
                desc:Destroy()
            end
        end
        
        -- Tàng hình toàn bộ Clone (người khác hoàn toàn không thấy) nhưng giữ nguyên bộ phận tự nhiên
        for _, v in pairs(cloneModel:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
                v.CanCollide = false
                v.Anchored = true
            elseif v:IsA("Decal") then
                v.Transparency = 1
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then handle.Transparency = 1 end
            end
        end
        cloneModel.Parent = workspace
        
        -- 2. Tàng hình tuyệt đối nhân vật gốc (đảm bảo người khác không nhìn thấy nhân vật gốc)
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
                v.CanCollide = false
            elseif v:IsA("Decal") then
                v.Transparency = 1
            end
        end
        
        -- 3. Chuyển Camera ngay lập tức sang đầu của Clone ở trên trời
        local cloneHead = cloneModel:FindFirstChild("Head")
        if cloneHead then
            camera.CameraSubject = cloneHead
        else
            camera.CameraSubject = humanoid
        end
        
        -- 4. Vòng lặp đồng bộ Clone trên trời và biến cơ thể gốc thành Free Cam
        skyConnection = RunService.RenderStepped:Connect(function()
            if char and rootPart and cloneModel then
                pcall(function()
                    local cloneRoot = cloneModel:FindFirstChild("HumanoidRootPart")
                    if cloneRoot then
                        -- Đẩy Clone lên trời cao (+15 mét) so với vị trí gốc
                        cloneRoot.CFrame = rootPart.CFrame + Vector3.new(0, 15, 0)
                        
                        for _, realPart in pairs(char:GetChildren()) do
                            if realPart:IsA("BasePart") then
                                local clonePart = cloneModel:FindFirstChild(realPart.Name)
                                if clonePart and realPart ~= rootPart then
                                    clonePart.CFrame = realPart.CFrame + Vector3.new(0, 15, 0)
                                end
                            end
                        end
                    end
                    
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
            end
        end)
    else
        skyCloneBtn.Text = "Bật Sky Clone & Free Cam: TẮT"
        skyCloneBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        
        if skyConnection then
            skyConnection:Disconnect()
            skyConnection = nil
        end
        if cloneModel then
            cloneModel:Destroy()
            cloneModel = nil
        end
        if humanoid then
            camera.CameraSubject = humanoid
        end
        player.Character:BreakJoints()
    end
end)

-- =====================================================================
-- PHẦN 2: MICRO-SENSITIVE SMART ANTI-KB (SIÊU NHẠY CHO MỌI CHIÊU NHẸ)
-- =====================================================================
antiKBBtn.MouseButton1Click:Connect(function()
    antiKBActive = not antiKBActive
    
    if antiKBActive then
        antiKBBtn.Text = "Bật Micro Anti-KB (Siêu Nhạy): BẬT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local char = player.Character
        if not char then return end
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not rootPart or not humanoid then return end
        
        lastSafeCFrame = rootPart.CFrame
        
        antiKBConnection = RunService.Heartbeat:Connect(function(dt)
            if not char or not rootPart or not humanoid then return end
            
            pcall(function()
                local velocity = rootPart.AssemblyLinearVelocity
                local floorMaterial = humanoid.FloorMaterial
                
                local isJumpingOrIntentional = (humanoid:GetState() == Enum.HumanoidStateType.Jumping) or 
                                               (humanoid:GetState() == Enum.HumanoidStateType.Freefall and velocity.Y > -15) or
                                               (floorMaterial ~= Enum.Material.Air)
                
                if isJumpingOrIntentional then
                    if floorMaterial ~= Enum.Material.Air and math.abs(velocity.Y) < 3 then
                        lastSafeCFrame = rootPart.CFrame
                    end
                else
                    local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
                    local isMicroKnockbacked = (horizontalSpeed > 18) or (velocity.Y < -25)
                    
                    if isMicroKnockbacked then
                        if lastSafeCFrame then
                            rootPart.CFrame = lastSafeCFrame
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                    else
                        if tick() - lastCheckTick > 0.3 then
                            lastCheckTick = tick()
                            if floorMaterial ~= Enum.Material.Air then
                                lastSafeCFrame = rootPart.CFrame
                            end
                        end
                    end
                end
                
                for _, child in pairs(rootPart:GetChildren()) do
                    if child:IsA("BodyVelocity") or child:IsA("BodyPosition") or child:IsA("LinearVelocity") or child:IsA("VectorForce") then
                        child:Destroy()
                    end
                end
            end)
        end)
    else
        antiKBBtn.Text = "Bật Micro Anti-KB (Siêu Nhạy): TẮT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        
        if antiKBConnection then
            antiKBConnection:Disconnect()
            antiKBConnection = nil
        end
    end
end)

-- Nút Reset toàn bộ
resetBtn.MouseButton1Click:Connect(function()
    if skyConnection then skyConnection:Disconnect() end
    if antiKBConnection then antiKBConnection:Disconnect() end
    if cloneModel then cloneModel:Destroy() end
    if player.Character then
        player.Character:BreakJoints()
    end
end)

print("Đã tải xong hệ thống Free Cam & Sky Clone hoàn chỉnh!")
