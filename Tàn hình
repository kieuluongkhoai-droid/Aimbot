SwapPositionsBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") or not cloneChar or not cloneChar:FindFirstChild("HumanoidRootPart") then
        InfoLabel.Text = "Status: Cannot swap, NPC or real body missing!"
        return
    end
    
    local realHrp = character.HumanoidRootPart
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")
    local cloneHrp = cloneChar.HumanoidRootPart
    local cloneHumanoid = cloneChar:FindFirstChildOfClass("Humanoid")
    
    local realCF = realHrp.CFrame
    local cloneCF = cloneHrp.CFrame
    
    if antiTpConnection then antiTpConnection:Disconnect() end
    
    realHrp.AssemblyLinearVelocity = Vector3.zero
    realHrp.AssemblyAngularVelocity = Vector3.zero
    realHrp.CFrame = cloneCF
    cloneHrp.CFrame = realCF
    
    if realHrp.Position.Y < 500 then
        if realHumanoid then 
            realHumanoid.Sit = false 
            realHumanoid.PlatformStand = false 
        end
        InfoLabel.Text = "Status: Real Body Swapped to Ground!"
    else
        if realHumanoid then 
            realHumanoid.Sit = true 
        end
        InfoLabel.Text = "Status: Real Body Swapped back to Sky Y=600 & Seated!"
        
        targetSkyCFrame = realHrp.CFrame
        antiTpConnection = RunService.Heartbeat:Connect(function()
            if skyPlatform and character and realHrp then
                if realHrp.Position.Y > 500 and (realHrp.Position.Y < 580 or realHrp.Position.Y > 650) then
                    realHrp.AssemblyLinearVelocity = Vector3.zero
                    realHrp.AssemblyAngularVelocity = Vector3.zero
                    realHrp.CFrame = targetSkyCFrame
                    if realHumanoid then realHumanoid.Sit = true end
                end
            end
        end)
    end
end)

