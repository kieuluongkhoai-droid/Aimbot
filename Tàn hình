-- Nút Bật/Tắt chính
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(1, -20, 0, 40)
ToggleBtn.Position = UDim2.new(0, 10, 0, 42)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
ToggleBtn.TextSize = 13
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.Text = "Status: OFF (Normal)"
ToggleBtn.Parent = MainFrame

local UICornerBtn = Instance.new("UICorner")
UICornerBtn.CornerRadius = UDim.new(0, 8)
UICornerBtn.Parent = ToggleBtn

-- Logic ẩn/hiện bảng điều khiển
local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        MinimizeBtn.Text = "+"
        ToggleBtn.Visible = false
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 210, 0, 35)}):Play()
    else
        MinimizeBtn.Text = "-"
        ToggleBtn.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 210, 0, 95)}):Play()
    end
end)

-- Biến lưu trữ trạng thái game
local isGodActive = false
local visualDummy = nil

local function toggleGodMode(state)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart

    if state then
        -- 1. Tạo hình nộm hiển thị dưới tháp để nhìn và tung chiêu
        character.Archivable = true
        visualDummy = character:Clone()
        character.Archivable = false
        
        for _, v in ipairs(visualDummy:GetDescendants()) do
            if v:IsA("LocalScript") or v:IsA("Script") then v:Destroy() end
        end
        visualDummy.Name = "TowerVisualDummy"
        visualDummy.Parent = workspace
        
        -- 2. Đưa hitbox thật lên trời cao (né mọi đòn đấm/đẩy trên tháp)
        hrp.CFrame = hrp.CFrame + Vector3.new(0, 4000, 0)
        
        ToggleBtn.Text = "Status: ON (God Mode)"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
        isGodActive = true
    else
        -- Tắt: Kéo hitbox thật về vị trí của hình nộm và xóa hình nộm
        if visualDummy then
            if visualDummy:FindFirstChild("HumanoidRootPart") then
                hrp.CFrame = visualDummy.HumanoidRootPart.CFrame
            end
            visualDummy:Destroy()
            visualDummy = nil
        end
        
        ToggleBtn.Text = "Status: OFF (Normal)"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        isGodActive = false
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    toggleGodMode(not isGodActive)
end)

-- Giúp camera bám sát hình nộm dưới tháp để chơi mượt mà
RunService.RenderStepped:Connect(function()
    if isGodActive and visualDummy and visualDummy:FindFirstChild("Humanoid") then
        pcall(function()
            Camera.CameraSubject = visualDummy.Humanoid
        end)
    else
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            Camera.CameraSubject = char.Humanoid
        end
    end
end)

-- Reset trạng thái khi chết hoặc đổi tầng/vào trận mới
LocalPlayer.CharacterAdded:Connect(function()
    isGodActive = false
    if visualDummy then
        visualDummy:Destroy()
        visualDummy = nil
    end
    ToggleBtn.Text = "Status: OFF (Normal)"
    ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
end)
