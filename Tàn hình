-- Logic ẩn/hiện bảng điều khiển
local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        MinimizeBtn.Text = "+"
        ToggleBtn.Visible = false
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 210, 0, 35)}):Play()
    else
        MinimizeBtn.Text = "-"
        ToggleBtn.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 210, 0, 95)}):Play()
    end
end)

-- Biến trạng thái
local isInfiniteActive = false
local visualDummy = nil
local shieldConnection = nil

local function toggleInfiniteShield(state)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart

    if state then
        -- 1. Tạo hình nộm để bạn nhìn và đánh nhau dưới tháp
        character.Archivable = true
        visualDummy = character:Clone()
        character.Archivable = false
        
        for _, v in ipairs(visualDummy:GetDescendants()) do
            if v:IsA("LocalScript") or v:IsA("Script") then v:Destroy() end
        end
        visualDummy.Name = "InfiniteShieldDummy"
        visualDummy.Parent = workspace
        
        -- 2. Đưa hitbox thật lên trời cao
        hrp.CFrame = hrp.CFrame + Vector3.new(0, 4000, 0)
        
        -- 3. Tạo vòng lặp vô hạn (Infinite Loop) liên tục duy trì hoặc tái tạo ForceField trên client
        shieldConnection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if char then
                local hasShield = false
                for _, v in ipairs(char:GetChildren()) do
                    if v:IsA("ForceField") then
                        hasShield = true
                        break
                    end
                end
                -- Nếu game tự động xóa khiên theo thời gian, script sẽ tự động tạo lại cái mới ngay lập tức
                if not hasShield then
                    local newShield = Instance.new("ForceField")
                    newShield.Visible = true
                    newShield.Parent = char
                end
            end
        end)

        ToggleBtn.Text = "Status: ON (Infinite Shield)"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
        isInfiniteActive = true
    else
        -- Tắt: Ngắt kết nối duy trì khiên, xóa hình nộm và đưa hitbox về chỗ cũ
        if shieldConnection then
            shieldConnection:Disconnect()
            shieldConnection = nil
        end
        
        if visualDummy then
            if visualDummy:FindFirstChild("HumanoidRootPart") then
                hrp.CFrame = visualDummy.HumanoidRootPart.CFrame
            end
            visualDummy:Destroy()
            visualDummy = nil
        end
        
        for _, v in ipairs(character:GetChildren()) do
            if v:IsA("ForceField") then
                v:Destroy()
            end
        end

        ToggleBtn.Text = "Status: OFF (Infinite)"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        isInfiniteActive = false
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    toggleInfiniteShield(not isInfiniteActive)
end)

-- Đồng bộ Camera bám sát hình nộm dưới tháp
RunService.RenderStepped:Connect(function()
    if isInfiniteActive and visualDummy and visualDummy:FindFirstChild("Humanoid") then
        pcall(function()
            Camera.CameraSubject = visualDummy.Humanoid
        end)
    else
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            Camera.CameraSubject = char.Humanoid
        end
    end
end)

-- Reset khi hồi sinh nhân vật mới
LocalPlayer.CharacterAdded:Connect(function()
    isInfiniteActive = false
    if shieldConnection then
        shieldConnection:Disconnect()
        shieldConnection = nil
    end
    if visualDummy then
        visualDummy:Destroy()
        visualDummy = nil
    end
    ToggleBtn.Text = "Status: OFF (Infinite)"
    ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
end)
