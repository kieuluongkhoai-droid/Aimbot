--[[
    King Tower - Anti-Conflict Safe Decoy Script
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- DỌN DẸP SẠCH SẼ CÁC KẾT NỐI VÀ GIAO DIỆN CŨ TRƯỚC KHI CHẠY (CHỐNG XUNG ĐỘT)
if _G.SafeDecoyConnection then
    pcall(function() _G.SafeDecoyConnection:Disconnect() end)
    _G.SafeDecoyConnection = nil
end

pcall(function()
    if CoreGui:FindFirstChild("SafeDecoyUI") then
        CoreGui.SafeDecoyUI:Destroy()
    end
end)

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SafeDecoyUI"
ScreenGui.ResetOnSpawn = false
pcall(function() ScreenGui.Parent = CoreGui end)
if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 260, 0, 160)
MainFrame.Position = UDim2.new(0, 50, 0, 150)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICornerMain = Instance.new("UICorner")
UICornerMain.CornerRadius = UDim.new(0, 10)
UICornerMain.Parent = MainFrame

local TitleLabel = Instance.new("TextLabel")
TitleLabel.Size = UDim2.new(1, 0, 0, 30)
TitleLabel.BackgroundTransparency = 1
TitleLabel.Text = "Safe Decoy Hub (Anti-Conflict)"
TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TitleLabel.TextSize = 11
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.Parent = MainFrame

local DeployBtn = Instance.new("TextButton")
DeployBtn.Size = UDim2.new(1, -20, 0, 40)
DeployBtn.Position = UDim2.new(0, 10, 0, 45)
DeployBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
DeployBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
DeployBtn.TextSize = 11
DeployBtn.Font = Enum.Font.GothamBold
DeployBtn.Text = "🎯 Spawn Decoy & Free Body"
DeployBtn.Parent = MainFrame

local UIC_1 = Instance.new("UICorner") UIC_1.CornerRadius = UDim.new(0, 6) UIC_1.Parent = DeployBtn

local InfoLabel = Instance.new("TextLabel")
InfoLabel.Size = UDim2.new(1, -20, 0, 30)
InfoLabel.Position = UDim2.new(0, 10, 0, 110)
InfoLabel.BackgroundTransparency = 1
InfoLabel.Text = "Status: Ready."
InfoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
InfoLabel.TextSize = 10
InfoLabel.Font = Enum.Font.Gotham
InfoLabel.Parent = MainFrame

local activeDecoy = nil

DeployBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        InfoLabel.Text = "Status: Character not found!"
        return 
    end
    
    local startCF = character.HumanoidRootPart.CFrame
    
    if activeDecoy and activeDecoy.Parent then
        activeDecoy:Destroy()
        activeDecoy = nil
    end
    
    -- 1. Đổi tên cơ thể chính để ngắt xung đột định danh trực tiếp
    character.Name = "SafeRealBody"
    
    -- 2. Tạo Clone mồi nhử mang tag Player
    character.Archivable = true
    activeDecoy = character:Clone()
    character.Archivable = false
    
    activeDecoy.Name = LocalPlayer.Name
    activeDecoy.Parent = workspace
    activeDecoy:SetPrimaryPartCFrame(startCF + Vector3.new(3, 0, 0))
    
    local decoyHumanoid = activeDecoy:FindFirstChildOfClass("Humanoid")
    if decoyHumanoid then
        decoyHumanoid.Sit = true -- Chống anti-cheat quét bay nhảy
        decoyHumanoid.MaxHealth = math.huge
        decoyHumanoid.Health = math.huge
    end
    
    -- Thiết lập hitbox mạng cho Clone
    for _, part in ipairs(activeDecoy:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
            pcall(function() part:SetNetworkOwner(LocalPlayer) end)
        end
    end
    
    -- Đưa camera về clone để kiểm chứng
    if decoyHumanoid then
        Camera.CameraSubject = decoyHumanoid
    end
    
    InfoLabel.Text = "Status: Success! Decoy deployed safely."
end)

-- Dọn dẹp tự động khi nhân vật chết hoặc reset
LocalPlayer.CharacterAdded:Connect(function()
    if activeDecoy then
        activeDecoy:Destroy()
        activeDecoy = nil
    end
    InfoLabel.Text = "Status: Reset."
end)
