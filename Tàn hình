-- EVENT: Create and activate clone with custom movement physics loop and collision hitbox support (Godmode enabled).
SpawnCloneBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local startCF = character.HumanoidRootPart.CFrame
    
    if cloneChar and cloneChar.Parent then
        cloneChar:Destroy()
        cloneChar = nil
    end
    
    character.Archivable = true
    cloneChar = character:Clone()
    character.Archivable = false
    
    for _, v in ipairs(cloneChar:GetDescendants()) do
        if v:IsA("LocalScript") or v:IsA("Script") then v:Destroy() end
    end
    cloneChar.Name = "MovablePathfinderClone"
    cloneChar.Parent = workspace
    cloneChar:SetPrimaryPartCFrame(startCF)
    
    local cloneHumanoid = cloneChar:FindFirstChildOfClass("Humanoid")
    local cloneHrp = cloneChar:FindFirstChild("HumanoidRootPart")
    
    if cloneHumanoid then
        cloneHumanoid.PlatformStand = false
        cloneHumanoid.AutoRotate = true
        Camera.CameraSubject = cloneHumanoid
        
        -- GODMODE FEATURE: Lock health and prevent taking damage permanently
        cloneHumanoid.MaxHealth = math.huge
        cloneHumanoid.Health = math.huge
        cloneHumanoid.HealthChanged:Connect(function()
            if cloneHumanoid and cloneHumanoid.Health < cloneHumanoid.MaxHealth then
                cloneHumanoid.Health = cloneHumanoid.MaxHealth
            end
        end)
    end
    
    for _, part in ipairs(cloneChar:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
            part.CanTouch = false
            part.CanQuery = false
        end
    end
    
    if cloneMoveConnection then cloneMoveConnection:Disconnect() end
    cloneMoveConnection = RunService.RenderStepped:Connect(function()
        if cloneChar and cloneChar.Parent and cloneHumanoid and cloneHrp and not isCloneLocked then
            local moveDir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
                moveDir = moveDir + Vector3.new(0, 0, -1)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
                moveDir = moveDir + Vector3.new(0, 0, 1)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
                moveDir = moveDir + Vector3.new(-1, 0, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
                moveDir = moveDir + Vector3.new(1, 0, 0)
            end
            
            if moveDir.Magnitude > 0 then
                local camLook = Camera.CFrame.LookVector
                camLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
                local camRight = Camera.CFrame.RightVector
                camRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
                
                local worldDir = (camRight * moveDir.X + camLook * -moveDir.Z).Unit
                cloneHumanoid:Move(worldDir, false)
            end
        end
    end)
    
    InfoLabel.Text = "Status: Clone Spawned with Godmode!"
end)

