local activeClone = nil
local isControllingClone = false
local isAIActive = false

SpawnPuppetBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        InfoLabel.Text = "Status: Character not found!"
        return
    end
    
    local hrp = character.HumanoidRootPart
    local startCF = hrp.CFrame
    
    if activeClone and activeClone.Parent then
        activeClone:Destroy()
        activeClone = nil
    end
    
    -- 1. Tạo Clone làm hình nhân phía trên
    character.Archivable = true
    activeClone = character:Clone()
    character.Archivable = false
    
    activeClone.Name = LocalPlayer.Name .. "_PuppetClone"
    activeClone.Parent = workspace
    activeClone:SetPrimaryPartCFrame(startCF + Vector3.new(0, 3, 0))
    
    local cloneHrp = activeClone:FindFirstChild("HumanoidRootPart")
    local cloneHumanoid = activeClone:FindFirstChildOfClass("Humanoid")
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- 2. Ẩn thân xác thật ngay xuống dưới chân (hoặc chìm xuống đất một chút để né sát thương vùng)
    hrp.CFrame = startCF - Vector3.new(0, 10, 0)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Transparency = 1 -- Tàng hình thân thật ở dưới đất
        end
    end
    
    -- Thiết lập hiển thị cho Clone rõ ràng ở trên
    for _, part in ipairs(activeClone:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
            part.Transparency = 0
        end
    end
    
    -- Mặc định chuyển camera lên Clone và BẬT AI cho Clone
    if cloneHumanoid then
        Camera.CameraSubject = cloneHumanoid
    end
    isControllingClone = true
    isAIActive = true
    SwitchCamBtn.Text = "👁️ Switch View: [ CLONE AI ]"
    SwitchCamBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
    
    InfoLabel.Text = "Status: Real body hidden, Clone active!"
    
    -- 3. Hệ thống AI tự động tìm và dịch chuyển Clone theo kẻ địch gần nhất
    if _G.PuppetConnection then _G.PuppetConnection:Disconnect() end
    
    local aiTimer = 0
    _G.PuppetConnection = RunService.RenderStepped:Connect(function(dt)
        if isAIActive and activeClone and cloneHumanoid and cloneHrp then
            aiTimer = aiTimer + dt
            if aiTimer >= 0.4 then
                aiTimer = 0
                local nearestTarget = nil
                local shortestDist = math.huge
                
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local targetHrp = player.Character.HumanoidRootPart
                        local dist = (targetHrp.Position - cloneHrp.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            nearestTarget = targetHrp
                        end
                    end
                end
                
                if nearestTarget then
                    cloneHumanoid:MoveTo(nearestTarget.Position)
                end
            end
        end
    end)
end)

-- Nút chuyển đổi qua lại giữa Real Body và Clone AI
SwitchCamBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not activeClone then
        InfoLabel.Text = "Status: Spawn clone first!"
        return
    end
    
    isControllingClone = not isControllingClone
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")
    local cloneHumanoid = activeClone:FindFirstChildOfClass("Humanoid")
    
    if isControllingClone then
        -- Chuyển góc nhìn lên Clone -> Bật AI
        if cloneHumanoid then Camera.CameraSubject = cloneHumanoid end
        isAIActive = true
        SwitchCamBtn.Text = "👁️ Switch View: [ CLONE AI ]"
        SwitchCamBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        InfoLabel.Text = "Status: Controlling Clone (AI ON)"
    else
        -- Chuyển góc nhìn về Real Body -> Tắt AI của Clone để bạn tự do đứng ẩn nấp
        if realHumanoid then Camera.CameraSubject = realHumanoid end
        isAIActive = false
        SwitchCamBtn.Text = "👁️ Switch View: [ REAL BODY ]"
        SwitchCamBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        InfoLabel.Text = "Status: Controlling Real Body (AI OFF)"
    end
end)

ResetBtn.MouseButton1Click:Connect(function()
    if _G.PuppetConnection then
        _G.PuppetConnection:Disconnect()
        _G.PuppetConnection = nil
    end
    if activeClone then
        activeClone:Destroy()
        activeClone = nil
    end
    isAIActive = false
    isControllingClone = false
    
    local character = LocalPlayer.Character
    if character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
                part.Transparency = 0
            end
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then Camera.CameraSubject = humanoid end
    end
    
    SwitchCamBtn.Text = "👁️ Switch View: [ REAL BODY ]"
    SwitchCamBtn.TextColor3 = Color3.fromRGB(100, 200, 255)
    InfoLabel.Text = "Status: Reset completed."
end)

