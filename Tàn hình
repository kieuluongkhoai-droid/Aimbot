local activeDecoy = nil
local fixedHeightY = 0
local isAIActive = false

DeployBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        InfoLabel.Text = "Status: Character not found!"
        return 
    end
    
    local startCF = character.HumanoidRootPart.CFrame
    fixedHeightY = startCF.Y
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")
    local realHrp = character.HumanoidRootPart
    
    if activeDecoy and activeDecoy.Parent then
        activeDecoy:Destroy()
        activeDecoy = nil
    end
    
    -- 1. XỬ LÝ CƠ THỂ GỐC (GHOST BODY)
    character.Name = "GhostRealBody"
    if realHumanoid then realHumanoid:Destroy() end
    
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.Transparency = 0.5
        end
    end
    
    -- 2. TẠO CLONE MỒI NHỬ (DECOY)
    character.Archivable = true
    activeDecoy = character:Clone()
    character.Archivable = false
    
    activeDecoy.Name = LocalPlayer.Name
    activeDecoy.Parent = workspace
    activeDecoy:SetPrimaryPartCFrame(startCF + Vector3.new(3, 0, 0))
    
    local decoyHumanoid = activeDecoy:FindFirstChildOfClass("Humanoid")
    local decoyHrp = activeDecoy:FindFirstChild("HumanoidRootPart")
    
    if decoyHumanoid then
        decoyHumanoid.PlatformStand = false
        decoyHumanoid.AutoRotate = true
        decoyHumanoid.Sit = false -- Cho phép đứng dậy để AI điều khiển đi lại
        decoyHumanoid.MaxHealth = math.huge
        decoyHumanoid.Health = math.huge
        decoyHumanoid.HealthChanged:Connect(function()
            if decoyHumanoid.Health < decoyHumanoid.MaxHealth then
                decoyHumanoid.Health = decoyHumanoid.MaxHealth
            end
        end)
    end
    
    for _, part in ipairs(activeDecoy:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
            part.CanTouch = true
            part.CanQuery = true
            part.Transparency = 0
            pcall(function() part:SetNetworkOwner(LocalPlayer) end)
        end
    end
    
    if realHrp then 
        Camera.CameraSubject = realHrp 
    end
    
    -- 3. VÒNG LẶP ĐIỀU KHIỂN CƠ THỂ GỐC & HỆ THỐNG AI CHO CLONE
    if _G.MasterDecoyConnection then _G.MasterDecoyConnection:Disconnect() end
    _G.MasterDecoyConnection = RunService.RenderStepped:Connect(function(dt)
        -- Điều khiển Ghost Body bằng bàn phím
        if character and character.Parent and realHrp then
            local moveDir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
                moveDir = moveDir + Vector3.new(0, 0, -1)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
                moveDir = moveDir + Vector3.new(0, 0, 1)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
                moveDir = moveDir + Vector3.new(-1, 0, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
                moveDir = moveDir + Vector3.new(1, 0, 0)
            end
            
            if moveDir.Magnitude > 0 then
                local camLook = Camera.CFrame.LookVector
                camLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
                local camRight = Camera.CFrame.RightVector
                camRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
                
                local worldDir = (camRight * moveDir.X + camLook * -moveDir.Z).Unit
                local currentPos = realHrp.Position
                local targetPos = currentPos + (worldDir * (30 * dt))
                
                realHrp.CFrame = CFrame.new(targetPos.X, fixedHeightY, targetPos.Z)
                realHrp.AssemblyLinearVelocity = Vector3.zero
            else
                local currentPos = realHrp.Position
                realHrp.CFrame = CFrame.new(currentPos.X, fixedHeightY, currentPos.Z)
                realHrp.AssemblyLinearVelocity = Vector3.zero
            end
        end
        
        -- HỆ THỐNG AI TỰ ĐỘNG CHO CLONE (Tự động tìm và đi theo mục tiêu gần nhất)
        if isAIActive and activeDecoy and decoyHumanoid and decoyHrp then
            local nearestTarget = nil
            local shortestDist = math.huge
            
            -- Quét tất cả người chơi khác trong server làm mục tiêu cho AI
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHrp = player.Character.HumanoidRootPart
                    local dist = (targetHrp.Position - decoyHrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestTarget = targetHrp
                    end
                end
            end
            
            -- Nếu tìm thấy mục tiêu, AI điều khiển Clone di chuyển đuổi theo
            if nearestTarget then
                decoyHumanoid:MoveTo(nearestTarget.Position)
            else
                -- Nếu không có ai, AI cho Clone đi quanh quẩn gần Ghost Body
                if character and character.Parent and character:FindFirstChild("HumanoidRootPart") then
                    local ghostHrp = character.HumanoidRootPart
                    if (ghostHrp.Position - decoyHrp.Position).Magnitude > 15 then
                        decoyHumanoid:MoveTo(ghostHrp.Position + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5)))
                    end
                end
            end
        end
    end)
    
    InfoLabel.Text = "Status: AI Decoy & Ghost Active!"
end)

-- BẬT / TẮT AI MODE
AIToggleBtn.MouseButton1Click:Connect(function()
    isAIActive = not isAIActive
    if isAIActive then
        AIToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        AIToggleBtn.Text = "🤖 AI Mode: [ ACTIVE ]"
        InfoLabel.Text = "Status: AI Bot Controller Enabled."
    else
        AIToggleBtn.TextColor3 = Color3.fromRGB(255, 200, 100)
        AIToggleBtn.Text = "🤖 AI Mode: [ OFF ]"
        InfoLabel.Text = "Status: AI Bot Controller Disabled."
        if activeDecoy and activeDecoy:FindFirstChildOfClass("Humanoid") then
            activeDecoy:FindFirstChildOfClass("Humanoid"):MoveTo(activeDecoy.HumanoidRootPart.Position)
        end
    end
end)

local toggleState = false
CamToggleBtn.MouseButton1Click:Connect(function()
    toggleState = not toggleState
    local realChar = workspace:FindFirstChild("GhostRealBody")
