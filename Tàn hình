local InfoLabel = Instance.new("TextLabel")
InfoLabel.Size = UDim2.new(1, -20, 0, 25)
InfoLabel.Position = UDim2.new(0, 10, 0, 160)
InfoLabel.BackgroundTransparency = 1
InfoLabel.Text = "Status: Ready."
InfoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
InfoLabel.TextSize = 10
InfoLabel.Font = Enum.Font.Gotham
InfoLabel.Parent = MainFrame

local activeClone = nil
local viewingClone = true
local hideOffset = 12

SpawnBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        InfoLabel.Text = "Status: Character not found!"
        return
    end
    
    local hrp = character.HumanoidRootPart
    local currentCF = hrp.CFrame
    
    if activeClone then
        pcall(function() activeClone:Destroy() end)
        activeClone = nil
    end
    
    -- Tạo Clone làm Proxy hiển thị trên mặt đất
    character.Archivable = true
    activeClone = character:Clone()
    character.Archivable = false
    activeClone.Name = "AI_Proxy_Clone"
    activeClone.Parent = workspace
    activeClone:SetPrimaryPartCFrame(currentCF)
    
    local cloneHrp = activeClone:FindFirstChild("HumanoidRootPart")
    local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
    
    -- Giấu cơ thể thật xuống dưới lòng đất (tàng hình + vô hiệu hóa va chạm để né sát thương map)
    hrp.CFrame = currentCF - Vector3.new(0, hideOffset, 0)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Transparency = 1
        end
    end
    
    -- Đưa camera mặc định nhìn vào Clone
    if cloneHum then Camera.CameraSubject = cloneHum end
    viewingClone = true
    SwitchCamBtn.Text = "👁️ View: [ CLONE PROXY ]"
    SwitchCamBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
    InfoLabel.Text = "Status: Real body hidden, AI proxy active."
    
    -- AI làm cầu nối: Lấy tọa độ di chuyển của bạn dưới đất và bắt Clone ở trên chạy theo đúng hướng đó
    if _G.ProxyConnection then _G.ProxyConnection:Disconnect() end
    
    _G.ProxyConnection = RunService.RenderStepped:Connect(function()
        if character and character.Parent and activeClone and cloneHum and hrp and cloneHrp then
            -- Tính toán vị trí tương ứng của thân thật trên mặt đất (Cộng lại đúng khoảng độ sâu đã giấu)
            local targetPositionOnSurface = hrp.Position + Vector3.new(0, hideOffset, 0)
            
            -- Ép AI điều khiển Clone di chuyển theo đúng vị trí bạn đang lái bên dưới
            cloneHum:MoveTo(targetPositionOnSurface)
        end
    end)
end)

-- Nút đổi góc nhìn linh hoạt giữa Clone Proxy và Cơ thể thật bên dưới
SwitchCamBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not activeClone then
        InfoLabel.Text = "Status: Spawn clone first!"
        return
    end
    
    viewingClone = not viewingClone
    local realHum = character:FindFirstChildOfClass("Humanoid")
    local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
    
    if viewingClone then
        if cloneHum then Camera.CameraSubject = cloneHum end
        SwitchCamBtn.Text = "👁️ View: [ CLONE PROXY ]"
        SwitchCamBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        InfoLabel.Text = "Status: Camera on Clone Proxy"
    else
        if realHum then Camera.CameraSubject = realHum end
        SwitchCamBtn.Text = "👁️ View: [ REAL BODY ]"
        SwitchCamBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        InfoLabel.Text = "Status: Camera on Real Body (Underground)"
    end
end)

ResetBtn.MouseButton1Click:Connect(function()
    if _G.ProxyConnection then
        _G.ProxyConnection:Disconnect()
        _G.ProxyConnection = nil
    end
    if activeClone then
        pcall(function() activeClone:Destroy() end)
        activeClone = nil
    end
    
    local character = LocalPlayer.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame + Vector3.new(0, hideOffset, 0)
        end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
                part.Transparency = 0
            end
        end
        local realHum = character:FindFirstChildOfClass("Humanoid")
        if realHum then Camera.CameraSubject = realHum end
    end
    
    viewingClone = false
    SwitchCamBtn.Text = "👁️ View: [ REAL BODY ]"
    InfoLabel.Text = "Status: Reset completed."
end)
