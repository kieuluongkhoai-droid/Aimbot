CamBtn.Parent = Container

local UIC_2 = Instance.new("UICorner") UIC_2.CornerRadius = UDim.new(0, 6) UIC_2.Parent = CamBtn

local replicatedClone = nil

DeployBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        InfoLabel.Text = "Status: Character not found!"
        return 
    end
    
    local startCF = character.HumanoidRootPart.CFrame
    
    if replicatedClone and replicatedClone.Parent then
        replicatedClone:Destroy()
        replicatedClone = nil
    end
    
    -- 1. TẠO MODEL PHỤ TRỢ MANG NGUYÊN VẸN TAG VÀ HITBOX PLAYER
    character.Archivable = true
    replicatedClone = character:Clone()
    character.Archivable = false
    
    replicatedClone.Name = LocalPlayer.Name .. "_ReplicatedClone"
    replicatedClone.Parent = workspace
    replicatedClone:SetPrimaryPartCFrame(startCF + Vector3.new(3, 0, 0))
    
    local cloneHumanoid = replicatedClone:FindFirstChildOfClass("Humanoid")
    local cloneHrp = replicatedClone:FindFirstChild("HumanoidRootPart")
    
    if cloneHumanoid then
        -- Ép trạng thái ngồi (`Sit = true`) để chống anti-cheat kiểm tra trạng thái lơ lửng/bay nhảy vật lý
        cloneHumanoid.Sit = true
        cloneHumanoid.PlatformStand = false
        cloneHumanoid.AutoRotate = true
        
        -- GODMODE CHO CLONE
        cloneHumanoid.MaxHealth = math.huge
        cloneHumanoid.Health = math.huge
        cloneHumanoid.HealthChanged:Connect(function()
            if cloneHumanoid and cloneHumanoid.Health < cloneHumanoid.MaxHealth then
                cloneHumanoid.Health = cloneHumanoid.MaxHealth
            end
        end)
    end
    
    -- Khôi phục toàn bộ tính chất vật lý, hitbox và khả năng hiển thị mạng (Replication) cho mọi người cùng thấy
    for _, part in ipairs(replicatedClone:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
            part.CanTouch = true
            part.CanQuery = true
            part.Transparency = 0
            
            -- Chuyển quyền sở hữu vật lý mạng (Network Ownership) sang client để mọi người chơi khác nhìn thấy mượt mà
            pcall(function()
                part:SetNetworkOwner(LocalPlayer)
            end)
        end
    end
    
    Camera.CameraSubject = cloneHumanoid
    InfoLabel.Text = "Status: Replicated Clone Deployed & Seated!"
end)

CamBtn.MouseButton1Click:Connect(function()
    if replicatedClone and replicatedClone:FindFirstChildOfClass("Humanoid") then
        Camera.CameraSubject = replicatedClone:FindFirstChildOfClass("Humanoid")
        InfoLabel.Text = "Status: Camera on Replicated Clone"
    else
        InfoLabel.Text = "Status: Clone not found!"
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    if replicatedClone then
        replicatedClone:Destroy()
        replicatedClone = nil
    end
    InfoLabel.Text = "Status: Reset - Normal Mode"
end)
