SwitchCamBtn.Parent = Container
local UIC_2 = Instance.new("UICorner") UIC_2.CornerRadius = UDim.new(0, 6) UIC_2.Parent = SwitchCamBtn

local ResetBtn = Instance.new("TextButton")
ResetBtn.Size = UDim2.new(1, 0, 0, 34)
ResetBtn.Position = UDim2.new(0, 0, 0, 80)
ResetBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
ResetBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
