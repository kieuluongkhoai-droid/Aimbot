-- VARIABLES: State variables for tracking characters, platforms, locks, and loops.
local cloneChar = nil
local skyPlatform = nil
local isRealLocked = false
local isCloneLocked = false
local cloneMoveConnection = nil
local antiTpConnection = nil
local targetSkyCFrame = nil

-- PLATFORM CREATOR: Spawns an extra safe and thick sky platform at a lower height to avoid Anti-Cheat triggers.
local function createThickSkyPlatform(basePos)
    if skyPlatform then skyPlatform:Destroy() end
    
    skyPlatform = Instance.new("Part")
    skyPlatform.Name = "TowerThickSkyPlatform"
    skyPlatform.Size = Vector3.new(120, 10, 120) -- Thicker and wider to guarantee no falling through
    skyPlatform.CFrame = CFrame.new(basePos.X, 350, basePos.Z) -- Fixed safe low height to bypass aggressive anti-cheat ceiling limits
    skyPlatform.Anchored = true
    skyPlatform.CanCollide = true
    skyPlatform.Transparency = 0.2
    skyPlatform.BrickColor = BrickColor.new("Dark stone grey")
    skyPlatform.Parent = workspace
    
    return CFrame.new(basePos.X, 355, basePos.Z)
end

local function removeSkyPlatform()
    if skyPlatform then
        skyPlatform:Destroy()
        skyPlatform = nil
    end
end

-- EVENT: Create Thick Sky Platform button functionality.
MakePlatformBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    targetSkyCFrame = createThickSkyPlatform(character.HumanoidRootPart.CFrame.Position)
    InfoLabel.Text = "Status: Safe Sky Platform Created!"
end)

-- EVENT: Teleport Real Body button functionality with anti-TP protection loop and velocity neutralization.
TpSkyBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local realHrp = character.HumanoidRootPart
    
    if not skyPlatform then
        targetSkyCFrame = createThickSkyPlatform(realHrp.CFrame.Position)
    end
    
    -- Neutralize velocity first to prevent anti-cheat velocity flags
    realHrp.AssemblyLinearVelocity = Vector3.zero
    realHrp.AssemblyAngularVelocity = Vector3.zero
    realHrp.CFrame = targetSkyCFrame
    
    if antiTpConnection then antiTpConnection:Disconnect() end
    antiTpConnection = RunService.Heartbeat:Connect(function()
        if skyPlatform and character and realHrp then
            if realHrp.Position.Y < (skyPlatform.Position.Y - 10) or realHrp.Position.Y > 500 then
                realHrp.AssemblyLinearVelocity = Vector3.zero
                realHrp.AssemblyAngularVelocity = Vector3.zero
                realHrp.CFrame = targetSkyCFrame
            end
        end
    end)
    
    InfoLabel.Text = "Status: Real Body Teleported Safely!"
end)

