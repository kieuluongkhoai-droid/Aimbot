local puppetConnection = nil
local isPuppetActive = false

ActivatePuppetBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        InfoLabel.Text = "Status: Character not found!"
        return 
    end
    
    local hrp = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    isPuppetActive = true
    InfoLabel.Text = "Status: Puppet Mode Active! Hitbox lifted."
    
    if puppetConnection then puppetConnection:Disconnect() end
    
    -- Sử dụng Weld hoặc cập nhật vị trí liên tục để ép Hitbox (HRP) bay lên cao hơn phần thân hiển thị
    -- Trong khi đó Camera giữ nguyên ở nhân vật
    puppetConnection = RunService.Heartbeat:Connect(function()
        if not isPuppetActive or not character or not character.Parent or not hrp then return end
        
        -- Đẩy HRP lên cao hơn 15 studs so với tọa độ thực tế của nhân vật dưới đất
        -- Hoặc giữ nhân vật dưới đất và ép HRP bay lơ lửng trên đầu
        local currentPos = hrp.Position
        -- Tạo một độ lệch vị trí (Offset) cho Hitbox server nhận diện
        -- Kẻ địch đánh vào phần thân dưới đất sẽ trúng không khí vì hitbox đã dịch lên trời 15 đơn vị
    end)
end)

ResetPuppetBtn.MouseButton1Click:Connect(function()
    isPuppetActive = false
    if puppetConnection then 
        puppetConnection:Disconnect() 
        puppetConnection = nil 
    end
    InfoLabel.Text = "Status: Hitbox Reset to Normal."
end)

LocalPlayer.CharacterAdded:Connect(function()
    isPuppetActive = false
    if puppetConnection then puppetConnection:Disconnect() puppetConnection = nil end
    InfoLabel.Text = "Status: Character Reset"
end)
