local decoyClone = nil
local isCameraOnDecoy = false
local controlConnection = nil

DeployBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        InfoLabel.Text = "Status Error: Character not found!"
        return 
    end
    
    local startCF = character.HumanoidRootPart.CFrame
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")
    
    if decoyClone and decoyClone.Parent then
        decoyClone:Destroy()
        decoyClone = nil
    end
    
    -- 1. BIẾN CƠ THỂ CHÍNH THÀNH VẬT THỂ TỰ DO (Xóa gánh nặng kiểm tra mạng của server)
    character.Name = "FreeRoamingRealBody"
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            -- Tắt va chạm ở cơ thể chính để đi xuyên tường/bay nhảy mượt mà không sợ anti-cheat kéo giật
            part.CanCollide = false
            part.Transparency = 0.4 -- Làm mờ cơ thể chính để nhận biết
        end
    end
    
    if realHumanoid then
        realHumanoid.PlatformStand = true -- Giúp cơ thể chính lơ lửng điều khiển tự do không bị trọng lực kéo rơi
    end
    
    -- 2. TẠO CON CLONE MANG NGUYÊN VẸN PLAYER TAG ĐỂ HỨNG CỜ ANTI-CHEAT
    character.Archivable = true
    decoyClone = character:Clone()
    character.Archivable = false
    
    decoyClone.Name = LocalPlayer.Name -- Giữ nguyên tên gốc / Player Tag để server nhận diện nhầm đây là player chính
    decoyClone.Parent = workspace
    decoyClone:SetPrimaryPartCFrame(startCF + Vector3.new(3, 0, 0))
    
    local decoyHumanoid = decoyClone:FindFirstChildOfClass("Humanoid")
    local decoyHrp = decoyClone:FindFirstChild("HumanoidRootPart")
    local realHrp = character.HumanoidRootPart
    
    if decoyHumanoid then
        decoyHumanoid.PlatformStand = false
        decoyHumanoid.AutoRotate = true
        decoyHumanoid.Sit = true -- Ép trạng thái ngồi để vô hiệu hóa bớt các cờ check tốc độ bay nhảy của anti-cheat trên con mồi nhử
        
        -- Bất tử cho mồi nhử để nó làm nhiệm vụ hứng đòn lâu nhất có thể
        decoyHumanoid.MaxHealth = math.huge
        decoyHumanoid.Health = math.huge
        decoyHumanoid.HealthChanged:Connect(function()
            if decoyHumanoid and decoyHumanoid.Health < decoyHumanoid.MaxHealth then
                decoyHumanoid.Health = decoyHumanoid.MaxHealth
            end
        end)
    end
    
    -- Khôi phục toàn bộ hitbox vật lý cho con Clone để Server và Anti-Cheat chính thức "nhận nuôi" nó
    for _, part in ipairs(decoyClone:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
            part.CanTouch = true
            part.Transparency = 0
            pcall(function()
                part:SetNetworkOwner(LocalPlayer)
            end)
        end
    end
    
    -- Mặc định Camera giữ nguyên ở cơ thể chính để bạn điều khiển linh hoạt
    if realHumanoid then
        Camera.CameraSubject = realHumanoid
    end
    isCameraOnDecoy = false
    
    -- 3. HỆ THỐNG ĐIỀU KHIỂN TỰ DO (ĐIỀU KHIỂN CƠ THỂ CHÍNH XUYÊN KHÔNG GIAN)
    if controlConnection then controlConnection:Disconnect() end
    controlConnection = RunService.RenderStepped:Connect(function()
        if character and character.Parent and realHrp then
            local moveDir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
                moveDir = moveDir + Vector3.new(0, 0, -1)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
                moveDir = moveDir + Vector3.new(0, 0, 1)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
                moveDir = moveDir + Vector3.new(-1, 0, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
                moveDir = moveDir + Vector3.new(1, 0, 0)
            end
            
            if moveDir.Magnitude > 0 then
                local camLook = Camera.CFrame.LookVector
                camLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
                local camRight = Camera.CFrame.RightVector
                camRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
                
                local worldDir = (camRight * moveDir.X + camLook * -moveDir.Z).Unit
                -- Di chuyển tự do cơ thể chính theo hướng camera mà không sợ bị hitbox cản trở
                realHrp.CFrame = realHrp.CFrame + (worldDir * 0.5)
            end
        end
    end)
    
    InfoLabel.Text = "Status: Decoy Active! Anti-cheat is locked on Clone."
end)

CamToggleBtn.MouseButton1Click:Connect(function()
    if not decoyClone or not decoyClone:FindFirstChildOfClass("Humanoid") then
        InfoLabel.Text = "Status: Deploy decoy first!"
        return
    end
    
    local realChar = workspace:FindFirstChild("FreeRoamingRealBody")
    local realHumanoid = realChar and realChar:FindFirstChildOfClass("Humanoid")
    local decoyHumanoid = decoyClone:FindFirstChildOfClass("Humanoid")
    
    if isCameraOnDecoy then
        if realHumanoid then
            Camera.CameraSubject = realHumanoid
            InfoLabel.Text = "Status: Camera switched to Real Body"
        end
        isCameraOnDecoy = false
    else
        if decoyHumanoid then
            Camera.CameraSubject = decoyHumanoid
            InfoLabel.Text = "Status: Camera switched to Decoy Clone"
        end
        isCameraOnDecoy = true
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    if controlConnection then controlConnection:Disconnect() controlConnection = nil end
    if decoyClone then
        decoyClone:Destroy()
        decoyClone = nil
    end
    InfoLabel.Text = "Status: Reset to Normal"
end)

