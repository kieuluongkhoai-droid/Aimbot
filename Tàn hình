local function createButton(posY, defaultText)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = defaultText
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = mainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    return btn
end

local invisBtn = createButton(45, "Tàn Hình Tuyệt Đối: TẮT")
local antiKBBtn = createButton(90, "Anti-KB Đa Mục Tiêu: TẮT")
local resetBtn = createButton(135, "Khôi Phục / Reset")

local elementsToToggle = {invisBtn, antiKBBtn, resetBtn}
local isMinimized = false

minBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        minBtn.Text = "+"
        mainFrame.Size = UDim2.new(0, 220, 0, 35)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = false
        end
    else
        minBtn.Text = "-"
        mainFrame.Size = UDim2.new(0, 220, 0, 180)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = true
        end
    end
end)

-- 1. Tàn Hình An Toàn (Không làm rớt mạng/chết nhân vật, ẩn sạch cả người và vũ khí)
local invisActive = false
invisBtn.MouseButton1Click:Connect(function()
    invisActive = not invisActive
    local char = player.Character
    if not char then return end
    
    if invisActive then
        invisBtn.Text = "Tàn Hình Tuyệt Đối: BẬT"
        invisBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
                v.CanCollide = false
            elseif v:IsA("Decal") then
                v.Transparency = 1
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then
                    handle.Transparency = 1
                end
            end
        end
    else
        invisBtn.Text = "Tàn Hình Tuyệt Đối: TẮT"
        invisBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                v.Transparency = 0
                v.CanCollide = true
            elseif v:IsA("Decal") then
                v.Transparency = 0
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then
                    handle.Transparency = 0
                end
            end
        end
    end
end)

-- 2. Anti-Knockback Đa Mục Tiêu (Kháng mọi đợt tấn công dồn dập từ nhiều người)
local antiKBActive = false
local kbConnection = nil
local lastSafeCFrame = nil

antiKBBtn.MouseButton1Click:Connect(function()
    antiKBActive = not antiKBActive
    
    if antiKBActive then
        antiKBBtn.Text = "Anti-KB Đa Mục Tiêu: BẬT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            lastSafeCFrame = char.HumanoidRootPart.CFrame
        end
        
        kbConnection = RunService.RenderStepped:Connect(function()
            local character = player.Character
            if character then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                
                if rootPart and humanoid then
                    local moveDirection = humanoid.MoveDirection
                    local isMoving = moveDirection.Magnitude > 0
                    local currentState = humanoid:GetState()
                    
                    local isJumpingOrFalling = (currentState == Enum.HumanoidStateType.Jumping or currentState == Enum.HumanoidStateType.Freefall)
                    
                    if humanoid.Health > 0 and not isJumpingOrFalling then
                        -- Khóa vị trí cực gắt: Ngay cả khi bị nhiều người đánh văng, hệ thống sẽ ép đứng yên tại chỗ an toàn lập tức
                        if not isMoving and lastSafeCFrame then
                            local distance = (rootPart.Position - lastSafeCFrame.Position).Magnitude
                            if distance > 1.2 then -- Ngưỡng siêu hẹp, vừa nhích ra là kéo về liền
                                rootPart.CFrame = lastSafeCFrame
                                pcall(function()
                                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                end)
                            end
                        end
                        
                        -- Cập nhật liên tục khi di chuyển bình thường
                        if isMoving or rootPart.AssemblyLinearVelocity.Magnitude < 10 then
                            lastSafeCFrame = rootPart.CFrame
                        end
                    end
                    
                    -- Chống hất tung tổng lực (Bất chấp bị nhiều người dồn skill cùng lúc)
                    if (humanoid.PlatformStand or currentState == Enum.HumanoidStateType.Physics or (rootPart.AssemblyLinearVelocity.Y > 25 and not isJumpingOrFalling)) and lastSafeCFrame then
                        rootPart.CFrame = lastSafeCFrame
                        pcall(function()
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end)
                        humanoid.PlatformStand = false
                    end
                end
            end
        end)
    else
        antiKBBtn.Text = "Anti-KB Đa Mục Tiêu: TẮT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if kbConnection then
            kbConnection:Disconnect()
            kbConnection = nil
        end
    end
end)

-- 3. Nút Reset nhanh
resetBtn.MouseButton1Click:Connect(function()
    if player.Character then
        player.Character:BreakJoints()
    end
end)

