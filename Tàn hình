-- Nút Hoán Đổi Chính
local SwapBtn = Instance.new("TextButton")
SwapBtn.Size = UDim2.new(1, -20, 0, 40)
SwapBtn.Position = UDim2.new(0, 10, 0, 42)
SwapBtn.BackgroundColor3 = Color3.fromRGB(40, 30, 60)
SwapBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
SwapBtn.TextSize = 13
