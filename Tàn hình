-- Quét Y, quét toàn bộ map tìm phần tử ngoài cùng nhất để TP Real Body ra thật xa
ScanTpBtn.MouseButton1Click:Connect(function()
    InfoLabel.Text = "Status: Scanning map boundaries..."
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        InfoLabel.Text = "Status: Character not found!"
        return
    end
    
    local hrp = character.HumanoidRootPart
    local maxDist = 0
    local furthestPart = nil
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Anchored and obj.Size.Magnitude > 3 and obj.Transparency < 1 then
            local dist = (obj.Position - Vector3.new(0, obj.Position.Y, 0)).Magnitude
            if dist > maxDist then
                maxDist = dist
                furthestPart = obj
            end
        end
    end
    
    if furthestPart then
        -- Teleport real body ra sát góc xa nhất của bản đồ (cách xa tâm và điểm spawn hàng trăm đơn vị)
        hrp.CFrame = CFrame.new(furthestPart.Position.X, furthestPart.Position.Y + 5, furthestPart.Position.Z)
        InfoLabel.Text = "Status: Real Body TP to far boundary corner!"
    else
        hrp.CFrame = hrp.CFrame + Vector3.new(500, 10, 500)
        InfoLabel.Text = "Status: Real Body moved far away (Fallback)."
    end
end)

-- Tạo Clone ngay chính xác tại điểm Spawn của game
SpawnCloneBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        InfoLabel.Text = "Status: Character not found!"
        return
    end
    
    local spawnPos = CFrame.new(0, 10, 0)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") then
            spawnPos = obj.CFrame + Vector3.new(0, 3, 0)
            break
        end
    end
    
    if activeClone then pcall(function() activeClone:Destroy() end) activeClone = nil end
    
    character.Archivable = true
    activeClone = character:Clone()
    character.Archivable = false
    activeClone.Name = "StrictSafeClone"
    activeClone.Parent = workspace
    activeClone:SetPrimaryPartCFrame(spawnPos)
    
    InfoLabel.Text = "Status: Clone created at game spawn location."
end)

RealAnchorBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if character then
        realAnchored = not realAnchored
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = realAnchored
            end
        end
        if realAnchored then
            RealAnchorBtn.Text = "🔒 Real Body Anchor: [ ON ]"
            RealAnchorBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
        else
            RealAnchorBtn.Text = "🔒 Real Body Anchor: [ OFF ]"
            RealAnchorBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        end
    end
end)

