-- Cập nhật phần Anti-Knockback siêu nhạy (Chống hất tung dù nhẹ hay nặng)
-- Bạn có thể thay thế đoạn code của nút lockPosBtn bằng đoạn dưới đây:

local lockConnection = nil
local lastSafeCFrame = nil
local isLocked = false

lockPosBtn.MouseButton1Click:Connect(function()
    lockPosActive = not lockPosActive
    
    if lockPosActive then
        lockPosBtn.Text = "Anti-Ragdoll (Khóa Siêu Nhạy): BẬT"
        lockPosBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        lockConnection = RunService.RenderStepped:Connect(function()
            local character = player.Character
            if character then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                
                if rootPart and humanoid then
                    -- Kiểm tra xem người chơi có đang dùng phím di chuyển (WASD / Joystick) hay không
                    local moveDirection = humanoid.MoveDirection
                    local isMoving = moveDirection.Magnitude > 0
                    
                    -- Nếu đứng yên hoặc di chuyển bình thường, liên tục cập nhật tọa độ an toàn
                    if not humanoid.PlatformStand and humanoid.Health > 0 then
                        -- Nếu đứng yên (không bấm di chuyển) mà bị ép dịch chuyển đi một khoảng nhỏ > 2 mét -> Bị hất tung/đẩy lén!
                        if not isMoving and lastSafeCFrame then
                            local distance = (rootPart.Position - lastSafeCFrame.Position).Magnitude
                            if distance > 2.5 then -- Ngưỡng siêu nhạy: chỉ cần dịch chuyển nhích nhẹ là kéo về ngay
                                rootPart.CFrame = lastSafeCFrame
                                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            end
                        end
                        
                        -- Cập nhật mốc tọa độ an toàn liên tục khi bình thường
                        if isMoving or rootPart.AssemblyLinearVelocity.Magnitude < 20 then
                            lastSafeCFrame = rootPart.CFrame
                        end
                    end
                    
                    -- Xử lý trường hợp đang bay vút lên trời / bị hất tung mạnh
                    if (humanoid.PlatformStand or rootPart.AssemblyLinearVelocity.Y > 35) and lastSafeCFrame then
                        rootPart.CFrame = lastSafeCFrame
                        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        humanoid.PlatformStand = false
                    end
                end
            end
        end)
    else
        lockPosBtn.Text = "Anti-Ragdoll (Khóa Vị Trí): TẮT"
        lockPosBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if lockConnection then
            lockConnection:Disconnect()
            lockConnection = nil
        end
    end
end)
