-- Biến trạng thái
local cloneChar = nil
local skyPlatform = nil
local isModeActive = false
local currentViewIsClone = true
local renderConnection = nil

-- Tạo sàn trên trời vững chắc
local function createSkyPlatform(basePos)
    if skyPlatform then skyPlatform:Destroy() end
    
    skyPlatform = Instance.new("Part")
    skyPlatform.Name = "TowerSkyPlatform"
    skyPlatform.Size = Vector3.new(40, 1.5, 40)
    skyPlatform.CFrame = CFrame.new(basePos.X, basePos.Y + 3000, basePos.Z)
    skyPlatform.Anchored = true
    skyPlatform.CanCollide = true
    skyPlatform.Transparency = 0.2
    skyPlatform.BrickColor = BrickColor.new("Dark stone grey")
    skyPlatform.Parent = workspace
end

local function removeSkyPlatform()
    if skyPlatform then
        skyPlatform:Destroy()
        skyPlatform = nil
    end
end

-- Vô hiệu hóa hitbox của Clone để không dính sát thương
local function disableCloneHitbox(model)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
        end
    end
end

-- Nút 1: Bật/Tắt chế độ
ToggleBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local realHrp = character.HumanoidRootPart
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")

    if not isModeActive then
        local startCF = realHrp.CFrame
        
        -- 1. Tạo sàn trên trời
        createSkyPlatform(startCF.Position)
        
        -- 2. Đưa cơ thể chính lên sàn trên trời và khóa trạng thái đứng yên tuyệt đối
        realHrp.CFrame = CFrame.new(startCF.X, startCF.Y + 3003, startCF.Z)
        if realHumanoid then
            realHumanoid.PlatformStand = true -- Khóa cử động cơ thể gốc để tránh anti-cheat quét lỗi di chuyển
        end
        
        -- 3. Tạo Clone dưới đất để điều khiển mở đường
        if not cloneChar or not cloneChar.Parent then
            character.Archivable = true
            cloneChar = character:Clone()
            character.Archivable = false
            
            for _, v in ipairs(cloneChar:GetDescendants()) do
                if v:IsA("LocalScript") or v:IsA("Script") then v:Destroy() end
            end
            cloneChar.Name = "ActivePathfinderClone"
            cloneChar.Parent = workspace
            cloneChar:SetPrimaryPartCFrame(startCF)
            
            disableCloneHitbox(cloneChar)
        end
        
        -- 4. Chuyển Camera sang Clone để điều khiển mượt mà ngay
        if cloneChar:FindFirstChild("Humanoid") then
            Camera.CameraSubject = cloneChar.Humanoid
        end
        
        -- Đồng bộ hóa điều khiển liên tục để phần di chuyển của Clone hoạt động trơn tru
        local cloneHrp = cloneChar:FindFirstChild("HumanoidRootPart")
        local cloneHumanoid = cloneChar:FindFirstChildOfClass("Humanoid")
        
        if renderConnection then renderConnection:Disconnect() end
        renderConnection = RunService.RenderStepped:Connect(function()
            if isModeActive and cloneChar and cloneChar.Parent and cloneHumanoid and cloneHrp then
                -- Cho phép Clone nhận input di chuyển từ người chơi bình thường ở dưới đất
            end
        end)
        
        isModeActive = true
        currentViewIsClone = true
        ToggleBtn.Text = "🛡️ Mode: ON (Protected)"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
        CamBtn.Text = "👁️ View: Clone (Dummy)"
        InfoLabel.Text = "Status: Real Body Locked on Sky Platform"
    else
        -- Tắt Mode: Khôi phục lại trạng thái ban đầu
        if renderConnection then renderConnection:Disconnect() renderConnection = nil end
        
        if cloneChar and cloneChar:FindFirstChild("HumanoidRootPart") then
            realHrp.CFrame = cloneChar.HumanoidRootPart.CFrame
        end
        
        if realHumanoid then
            realHumanoid.PlatformStand = false
        end
        
        removeSkyPlatform()
        if cloneChar then
            cloneChar:Destroy()
            cloneChar = nil
        end
        
        if realHumanoid then
            Camera.CameraSubject = realHumanoid
        end
        
        isModeActive = false
        ToggleBtn.Text = "🛡️ Mode: OFF (Normal)"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        CamBtn.Text = "👁️ View: Normal"
        InfoLabel.Text = "Status: Normal Mode"
    end
end)

-- Nút 2: Đổi góc nhìn Camera giữa Clone và Cơ thể gốc trên trời
CamBtn.MouseButton1Click:Connect(function()
    if not isModeActive then return end
    local character = LocalPlayer.Character
    if not character then return end
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")
    
    currentViewIsClone = not currentViewIsClone
    
    if currentViewIsClone then
        if cloneChar and cloneChar:FindFirstChild("Humanoid") then
            Camera.CameraSubject = cloneChar.Humanoid
            CamBtn.Text = "👁️ View: Clone (Dummy)"
            InfoLabel.Text = "Camera on Clone"
        end
    else
        if realHumanoid then
            Camera.CameraSubject = realHumanoid
            CamBtn.Text = "👁️ View: Real Body (Sky)"
            InfoLabel.Text = "Camera on Real Body (Sky)"
        end
    end
end)

-- Nút 3: Hoán đổi / Mang cơ thể chính đến vị trí hiện tại (Dùng được nhiều lần linh hoạt)
local isCoreDown = false
SwapBtn.MouseButton1Click:Connect(function()
    if not isModeActive or not cloneChar then return end
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local realHrp = character.HumanoidRootPart
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")
    local cloneHrp = cloneChar:FindFirstChild("HumanoidRootPart")
    
    if not cloneHrp then return end
    
    isCoreDown = not isCoreDown
    
    if isCoreDown then
        -- Đưa cơ thể gốc từ trên trời xuống vị trí hiện tại của Clone
        realHrp.CFrame = cloneHrp.CFrame
        if realHumanoid then
            realHumanoid.PlatformStand = false -- Mở khóa để chiến đấu/di chuyển bình thường
        end
        
        -- Chuyển Camera vào cơ thể chính để bạn trực tiếp chiến đấu
        if realHumanoid then
            Camera.CameraSubject = realHumanoid
        end
        
        SwapBtn.Text = "🔄 Send Core Back to Sky"
        InfoLabel.Text = "Status: Real Body is HERE!"
    else
        -- Đưa cơ thể gốc trở lại tấm sàn trên trời an toàn
        if skyPlatform then
            local skyPos = skyPlatform.Position
            realHrp.CFrame = CFrame.new(skyPos.X, skyPos.Y + 3, skyPos.Z)
        else
            realHrp.CFrame = cloneHrp.CFrame + Vector3.new(0, 3000, 0)
        end
        
        if realHumanoid then
            realHumanoid.PlatformStand = true -- Khóa lại an toàn
        end
        
        -- Trả Camera về cho Clone tiếp tục đi đường
        if cloneChar:FindFirstChild("Humanoid") then
            Camera.CameraSubject = cloneChar.Humanoid
        end
        
        SwapBtn.Text = "🔄 Swap / Bring Core Here"
        InfoLabel.Text = "Status: Real Body back to Sky Safe"
    end
end)

