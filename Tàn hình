-- Nút Thu Nhỏ / Mở Rộng (-)
local minBtn = Instance.new("TextButton")
minBtn.Size = UDim2.new(0, 30, 0, 30)
minBtn.Position = UDim2.new(1, -33, 0, 2)
minBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
minBtn.Text = "-"
minBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
minBtn.TextSize = 16
minBtn.Font = Enum.Font.GothamBold
minBtn.Parent = mainFrame

local function createButton(posY, defaultText)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = defaultText
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = mainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    return btn
end

local ghostBtn = createButton(45, "Bóng Ma Hoàn Hảo: TẮT")
local resetBtn = createButton(95, "Khôi Phục / Reset")

local elementsToToggle = {ghostBtn, resetBtn}
local isMinimized = false

minBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        minBtn.Text = "+"
        mainFrame.Size = UDim2.new(0, 220, 0, 35)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = false
        end
    else
        minBtn.Text = "-"
        mainFrame.Size = UDim2.new(0, 220, 0, 160)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = true
        end
    end
end)

local ghostActive = false
local cloneModel = nil
local connection = nil

ghostBtn.MouseButton1Click:Connect(function()
    ghostActive = not ghostActive
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not rootPart or not humanoid then return end
    
    if ghostActive then
        ghostBtn.Text = "Bóng Ma Hoàn Hảo: BẬT"
        ghostBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        -- 1. Lưu lại đối tượng camera hiện tại để không bị lỗi góc nhìn
        local originalCameraSubject = camera.CameraSubject
        
        -- 2. Tạo một bản sao hình ảnh (Visual Clone) đặt ngay tại chỗ đứng để lừa mắt đối thủ
        char.Archivable = true
        cloneModel = char:Clone()
        cloneModel.Name = "VisualGhostClone"
        
        -- Xóa các script phụ bên trong bản sao để nó đứng im làm "vật phẩm tàng hình/tượng"
        for _, scriptChild in pairs(cloneModel:GetDescendants()) do
            if scriptChild:IsA("Script") or scriptChild:IsA("LocalScript") then
                scriptChild:Destroy()
            end
        end
        
        -- Làm tàng hình bản sao và vô hiệu hóa va chạm hoàn toàn
        for _, v in pairs(cloneModel:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
                v.CanCollide = false
                v.Anchored = true
            elseif v:IsA("Decal") then
                v.Transparency = 1
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then
                    handle.Transparency = 1
                end
            end
        end
        cloneModel.Parent = workspace
        
        -- 3. Ẩn nhân vật thật đi (chỉ để bạn thao tác ngầm) và đưa lên cao an toàn khỏi tầm đánh
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
            elseif v:IsA("Decal") then
                v.Transparency = 1
            end
        end
        
        -- 4. Vòng lặp đồng bộ vị trí: Cố định hitbox thật ở trên cao (+6 mét so với bản sao giả lập), đồng thời giữ camera mượt mà
        connection = RunService.RenderStepped:Connect(function()
            if char and rootPart and cloneModel then
                pcall(function()
                    -- Cập nhật vị trí bản sao giả lập khớp với di chuyển của bạn để đánh lừa thị giác người khác
                    local cloneRoot = cloneModel:FindFirstChild("HumanoidRootPart")
                    if cloneRoot then
                        cloneRoot.CFrame = rootPart.CFrame - Vector3.new(0, 6, 0) -- Bản sao ở dưới đất, nhân vật thật ở trên cao +6m
                    end
                    
                    -- Khóa vận tốc nhân vật thật để không bị đẩy văng hay rơi rớt
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
            end
        end)
    else
        ghostBtn.Text = "Bóng Ma Hoàn Hảo: TẮT"
        ghostBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        
        if connection then
            connection:Disconnect()
            connection = nil
        end
        
        if cloneModel then
            cloneModel:Destroy()
            cloneModel = nil
        end
        
        player.Character:BreakJoints()
    end
end)

-- Nút Reset
resetBtn.MouseButton1Click:Connect(function()
    if cloneModel then cloneModel:Destroy() end
    if player.Character then
        player.Character:BreakJoints()
    end
end)

print("Đã tải xong Script Bóng Ma Hoàn Hảo!")
