-- Biến trạng thái
local cloneChar = nil
local skyPlatform = nil
local isModeActive = false
local currentViewIsClone = true
local isCoreDown = false

-- Tạo tấm sàn trên trời và đặt chiều cao chuẩn xác để chân cơ thể đứng BÊN TRÊN bề mặt tấm bìa
local function createSkyPlatform(basePos)
    if skyPlatform then skyPlatform:Destroy() end
    
    skyPlatform = Instance.new("Part")
    skyPlatform.Name = "TowerSkyPlatform"
    skyPlatform.Size = Vector3.new(50, 2, 50) -- Độ dày tấm bìa là 2 đơn vị
    -- Đặt vị trí Y cao hơn 3000 mét
    skyPlatform.CFrame = CFrame.new(basePos.X, basePos.Y + 3000, basePos.Z)
    skyPlatform.Anchored = true
    skyPlatform.CanCollide = true
    skyPlatform.Transparency = 0.2
    skyPlatform.BrickColor = BrickColor.new("Dark stone grey")
    skyPlatform.Parent = workspace
end

local function removeSkyPlatform()
    if skyPlatform then
        skyPlatform:Destroy()
        skyPlatform = nil
    end
end

-- Nút 1: Bật/Tắt chế độ
ToggleBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local realHrp = character.HumanoidRootPart
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")

    if not isModeActive then
        local startCF = realHrp.CFrame
        
        -- 1. Tạo sàn trên trời
        createSkyPlatform(startCF.Position)
        
        -- 2. Đặt cơ thể chính đứng BÊN TRÊN bề mặt tấm bìa (Tính toán nửa chiều cao character + nửa độ dày tấm bìa để chân đứng chuẩn xác)
        local platformY = startCF.Y + 3000
        local surfaceY = platformY + 1 + 3 -- 1 (nửa độ dày tấm bìa) + 3 (khoảng cách chân tới tâm HumanoidRootPart)
        realHrp.CFrame = CFrame.new(startCF.X, surfaceY, startCF.Z)
        
        if realHumanoid then
            realHumanoid.PlatformStand = true -- Khóa cử động cơ thể gốc để chống anti-cheat
        end
        
        -- 3. Tạo Clone dưới đất để mở đường (Đảm bảo bật đầy đủ tính năng di chuyển và giữ nguyên trạng thái đi lại)
        if not cloneChar or not cloneChar.Parent then
            character.Archivable = true
            cloneChar = character:Clone()
            character.Archivable = false
            
            for _, v in ipairs(cloneChar:GetDescendants()) do
                if v:IsA("LocalScript") or v:IsA("Script") then v:Destroy() end
            end
            cloneChar.Name = "MovablePathfinderClone"
            cloneChar.Parent = workspace
            cloneChar:SetPrimaryPartCFrame(startCF)
            
            -- Cho phép Clone di chuyển tự do, không bị khóa trạng thái
            local cloneHumanoid = cloneChar:FindFirstChildOfClass("Humanoid")
            if cloneHumanoid then
                cloneHumanoid.PlatformStand = false
                cloneHumanoid.AutoRotate = true
            end
            
            -- Đảm bảo các phần thân của Clone không cản trở sát thương nhưng vẫn giữ va chạm đất để đi lại bình thường
            for _, part in ipairs(cloneChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true -- Giữ CanCollide để Clone đứng vững trên mặt đất của game
                    part.CanTouch = false  -- Không nhận tương tác sát thương tấn công từ quái/người khác
                    part.CanQuery = false
                end
            end
        end
        
        -- 4. Chuyển Camera sang Clone ngay lập tức để điều khiển mượt mà
        if cloneChar:FindFirstChild("Humanoid") then
            Camera.CameraSubject = cloneChar.Humanoid
        end
        
        isModeActive = true
        currentViewIsClone = true
        isCoreDown = false
        ToggleBtn.Text = "🛡️ Mode: ON (Protected)"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
        CamBtn.Text = "👁️ View: Clone (Dummy)"
        SwapBtn.Text = "🔄 Swap / Bring Core Here"
        InfoLabel.Text = "Status: Core Safe on Top of Sky Platform"
    else
        -- Tắt Mode
        if cloneChar and cloneChar:FindFirstChild("HumanoidRootPart") then
            realHrp.CFrame = cloneChar.HumanoidRootPart.CFrame
        end
        
        if realHumanoid then
            realHumanoid.PlatformStand = false
        end
        
        removeSkyPlatform()
        if cloneChar then
            cloneChar:Destroy()
            cloneChar = nil
        end
        
        if realHumanoid then
            Camera.CameraSubject = realHumanoid
        end
        
        isModeActive = false
        isCoreDown = false
        ToggleBtn.Text = "🛡️ Mode: OFF (Normal)"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        CamBtn.Text = "👁️ View: Normal"
        SwapBtn.Text = "🔄 Swap / Bring Core Here"
        InfoLabel.Text = "Status: Normal Mode"
    end
end)

-- Nút 2: Đổi góc nhìn Camera linh hoạt
CamBtn.MouseButton1Click:Connect(function()
    if not isModeActive then return end
    local character = LocalPlayer.Character
    if not character then return end
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")
    
    currentViewIsClone = not currentViewIsClone
    
    if currentViewIsClone then
        if cloneChar and cloneChar:FindFirstChild("Humanoid") then
            Camera.CameraSubject = cloneChar.Humanoid
            CamBtn.Text = "👁️ View: Clone (Dummy)"
            InfoLabel.Text = "Camera on Clone"
        end
    else
        if realHumanoid then
            Camera.CameraSubject = realHumanoid
            CamBtn.Text = "👁️ View: Real Body (Sky)"
            InfoLabel.Text = "Camera on Real Body (Sky)"
        end
    end
end)

-- Nút 3: Hoán đổi / Mang cơ thể chính xuống (Dùng nhiều lần thoải mái)
SwapBtn.MouseButton1Click:Connect(function()
    if not isModeActive or not cloneChar then return end
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local realHrp = character.HumanoidRootPart
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")
    local cloneHrp = cloneChar:FindFirstChild("HumanoidRootPart")
    
    if not cloneHrp then return end
    
    isCoreDown = not isCoreDown
    
    if isCoreDown then
        -- Mang cơ thể chính xuống vị trí hiện tại của Clone
        realHrp.CFrame = cloneHrp.CFrame
        if realHumanoid then
            realHumanoid.PlatformStand = false -- Mở khóa để chiến đấu
        end
        
        if realHumanoid then
            Camera.CameraSubject = realHumanoid
        end
        
        SwapBtn.Text = "🔄 Send Core Back to Sky"
        InfoLabel.Text = "Status: Real Body is HERE (Fighting)"
    else
        -- Đưa cơ thể chính trở lại chuẩn xác BÊN TRÊN bề mặt tấm bìa trên trời
        if skyPlatform then
            local skyPos = skyPlatform.Position
            realHrp.CFrame = CFrame.new(skyPos.X, skyPos.Y + 4, skyPos.Z)
        else
            realHrp.CFrame = cloneHrp.CFrame + Vector3.new(0, 3004, 0)
        end
        
        if realHumanoid then
            realHumanoid.PlatformStand = true -- Khóa lại an toàn
        end
        
        if cloneChar:FindFirstChild("Humanoid") then
            Camera.CameraSubject = cloneChar.Humanoid
        end
        
        SwapBtn.Text = "🔄 Swap / Bring Core Here"
        InfoLabel.Text = "Status: Real Body safely back on Sky Platform"
    end
end)

