-- Hàm ẩn tàng hình an toàn chống Anti-Cheat (Chỉ đổi Transparency cục bộ, không ép buộc NetworkOwner độc hại)
local function setCharacterStealthSafe(char, isHidden)
    if not char then return end
    pcall(function()
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                v.Transparency = isHidden and 1 or 0
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v.Transparency = isHidden and 1 or 0
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then handle.Transparency = isHidden and 1 or 0 end
            elseif v:IsA("Clothing") or v:IsA("ShirtGraphic") then
                v.Transparency = isHidden and 1 or 0
            end
        end
        -- Giữ HumanoidRootPart hiển thị tàng hình nhẹ hoặc mờ để server không phát hiện bất thường
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Transparency = isHidden and 0.99 or 0
        end
    end)
end

-- =====================================================================
-- PHẦN 1: HỆ THỐNG BYPASS TÀNG HÌNH & BẤT TỬ AN TOÀN
-- =====================================================================
stealthBtn.MouseButton1Click:Connect(function()
    stealthActive = not stealthActive
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not rootPart or not humanoid or not head then return end
    
    if stealthActive then
        stealthBtn.Text = "Bật Hệ Thống Bypass & Tàng Hình: BẬT"
        stealthBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        switchCamBtn.Visible = true
        
        lastSafeCFrame = rootPart.CFrame
        lastHealth = humanoid.Health
        
        -- Tạo Clone (Free Cam) đặt ở trên trời (+25 mét)
        char.Archivable = true
        cloneModel = char:Clone()
        cloneModel.Name = "BypassProxyClone"
        
        for _, desc in pairs(cloneModel:GetDescendants()) do
            if desc:IsA("Script") or desc:IsA("LocalScript") then
                desc:Destroy()
            end
        end
        
        for _, v in pairs(cloneModel:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 0
                v.CanCollide = false
                v.Anchored = true
            end
        end
        
        local cloneRoot = cloneModel:FindFirstChild("HumanoidRootPart")
        if cloneRoot then
            cloneRoot.CFrame = rootPart.CFrame + Vector3.new(0, 25, 0)
        end
        cloneModel.Parent = workspace
        
        cameraIsOnMain = true
        switchCamBtn.Text = "Góc Nhìn: Đang ở CƠ THỂ CHÍNH (Di chuyển)"
        camera.CameraSubject = humanoid
        
        -- Vòng lặp quản lý ẩn/hiện và bảo vệ chống Anti-Cheat ban
        stealthConnection = RunService.RenderStepped:Connect(function()
            if char and rootPart and cloneModel then
                pcall(function()
                    if cameraIsOnMain then
                        setCharacterStealthSafe(char, false)
                    else
                        -- Khi chuyển lên Clone: Tàng hình cơ thể chính, đồng thời khóa vận tốc an toàn chống phát hiện hack vị trí
                        setCharacterStealthSafe(char, true)
                        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                end)
            end
        end)
    else
        stealthBtn.Text = "Bật Hệ Thống Bypass & Tàng Hình: TẮT"
        stealthBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        switchCamBtn.Visible = false
        
        if stealthConnection then stealthConnection:Disconnect() stealthConnection = nil end
        if cloneModel then cloneModel:Destroy() cloneModel = nil end
        
        if char then
            setCharacterStealthSafe(char, false)
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then camera.CameraSubject = humanoid end
        end
    end
end)

-- Nút Chuyển Đổi Góc Nhìn Camera
