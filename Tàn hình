local stealthBtn = createButton(40, "Bật Hệ Thống Free-Cam & Tàng Hình: TẮT")
local switchCamBtn = createButton(75, "Góc Nhìn: Đang ở CLONE (Di chuyển được)")
local antiKBBtn = createButton(110, "Bật Health Smart Anti-KB: TẮT")
local resetBtn = createButton(145, "Khôi Phục / Reset An Toàn")

switchCamBtn.Visible = false

-- Trạng thái toàn cục
local systemActive = false
local antiKBActive = false
local cameraIsOnClone = true

local cloneModel = nil
local loopConnection = nil
local antiKBConnection = nil
local healthConnection = nil

local lastSafeCFrame = nil
local lastHealth = 100
local isTakingDamageRecently = false

-- Fly variables cho Free Cam (Cơ thể gốc)
local flySpeed = 50
local keysPressed = {W = false, S = false, A = false, D = false, Space = false, LeftControl = false}

-- Hàm tàng hình và tách bộ phận/phụ kiện khỏi nhân vật gốc
local function setCharacterInvisibleCompletely(char, isHidden)
    if not char then return end
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Transparency = isHidden and 1 or 0
            v.CanCollide = not isHidden
            if isHidden then
                pcall(function() v:SetNetworkOwner(player) end)
            end
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = isHidden and 1 or 0
        elseif v:IsA("Accessory") then
            local handle = v:FindFirstChild("Handle")
            if handle then 
                handle.Transparency = isHidden and 1 or 0 
                handle.CanCollide = not isHidden
            end
        elseif v:IsA("Clothing") or v:IsA("ShirtGraphic") then
            v.Transparency = isHidden and 1 or 0
        end
    end
end

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then keysPressed.W = true end
    if input.KeyCode == Enum.KeyCode.S then keysPressed.S = true end
    if input.KeyCode == Enum.KeyCode.A then keysPressed.A = true end
    if input.KeyCode == Enum.KeyCode.D then keysPressed.D = true end
    if input.KeyCode == Enum.KeyCode.Space then keysPressed.Space = true end
    if input.KeyCode == Enum.KeyCode.LeftControl then keysPressed.LeftControl = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then keysPressed.W = false end
    if input.KeyCode == Enum.KeyCode.S then keysPressed.S = false end
    if input.KeyCode == Enum.KeyCode.A then keysPressed.A = false end
    if input.KeyCode == Enum.KeyCode.D then keysPressed.D = false end
    if input.KeyCode == Enum.KeyCode.Space then keysPressed.Space = false end
    if input.KeyCode == Enum.KeyCode.LeftControl then keysPressed.LeftControl = false end
end)

-- =====================================================================
-- PHẦN 1: HỆ THỐNG TÀNG HÌNH, CLONE VÀ FREE CAM FLY ĐỘC LẬP
-- =====================================================================
stealthBtn.MouseButton1Click:Connect(function()
    systemActive = not systemActive
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not rootPart or not humanoid or not head then return end
    
    if systemActive then
        stealthBtn.Text = "Bật Hệ Thống Free-Cam & Tàng Hình: BẬT"
        stealthBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        switchCamBtn.Visible = true
        
        lastSafeCFrame = rootPart.CFrame
        lastHealth = humanoid.Health
        
        -- Tạo Clone (hiển thị cho người khác thấy trên trời +20 mét)
        char.Archivable = true
        cloneModel = char:Clone()
        cloneModel.Name = "VisualProxyClone"
        
        for _, desc in pairs(cloneModel:GetDescendants()) do
            if desc:IsA("Script") or desc:IsA("LocalScript") then
                desc:Destroy()
            end
        end
        
        -- Giữ Clone hiển thị bình thường cho người khác nhìn thấy
        for _, v in pairs(cloneModel:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 0
                v.CanCollide = false
                v.Anchored = true
            end
        end
        cloneModel.Parent = workspace
        
        -- Dịch chuyển cơ thể gốc lên cao (+20 mét) tách biệt hoàn toàn làm Free Cam, đồng thời ẩn tàng hình toàn bộ bộ phận/phụ kiện
        rootPart.CFrame = rootPart.CFrame + Vector3.new(0, 20, 0)
        setCharacterInvisibleCompletely(char, true)
        
        -- Mặc định khóa camera vào đầu của Clone (Góc nhìn Clone)
        cameraIsOnClone = true
        switchCamBtn.Text = "Góc Nhìn: Đang ở CLONE (Di chuyển được)"
        local cloneHead = cloneModel:FindFirstChild("Head")
        if cloneHead then
            camera.CameraSubject = cloneHead
        end
        
        -- Vòng lặp quản lý hành vi phân tách góc nhìn
        loopConnection = RunService.RenderStepped:Connect(function(dt)
            if char and rootPart and cloneModel then
                pcall(function()
                    local cloneRoot = cloneModel:FindFirstChild("HumanoidRootPart")
                    if cloneRoot then
                        if cameraIsOnClone then
                            -- TRƯỜNG HỢP 1: Ở góc nhìn CLONE -> Clone di chuyển theo cơ thể gốc ở trên trời
                            cloneRoot.CFrame = rootPart.CFrame
                            for _, realPart in pairs(char:GetChildren()) do
                                if realPart:IsA("BasePart") then
                                    local clonePart = cloneModel:FindFirstChild(realPart.Name)
                                    if clonePart and realPart ~= rootPart then
                                        clonePart.CFrame = realPart.CFrame
                                    end
                                end
                            end
                        else
                            -- TRƯỜNG HỢP 2: Ở góc nhìn FREE CAM (Cơ thể gốc) -> Clone KHÓA CỨNG tại chỗ, KHÔNG nhận sát thương, KHÔNG bị KB, bắt buộc đứng yên.
                            -- Cơ thể gốc bay tự do như hack fly:
                            local moveDir = Vector3.new(0, 0, 0)
                            local camCF = camera.CFrame
                            
                            if keysPressed.W then moveDir = moveDir + camCF.LookVector end
                            if keysPressed.S then moveDir = moveDir - camCF.LookVector end
                            if keysPressed.A then moveDir = moveDir - camCF.RightVector end
                            if keysPressed.D then moveDir = moveDir + camCF.RightVector end
                            if keysPressed.Space then moveDir = moveDir + Vector3.new(0, 1, 0) end
                            if keysPressed.LeftControl then moveDir = moveDir - Vector3.new(0, 1, 0) end
                            
                            if moveDir.Magnitude > 0 then
                                rootPart.CFrame = rootPart.CFrame + (moveDir.Unit * flySpeed * dt)
                            end
                            
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                    end
                end)
            end
        end)
    else
        stealthBtn.Text = "Bật Hệ Thống Free-Cam & Tàng Hình: TẮT"
        stealthBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        switchCamBtn.Visible = false
        
        if loopConnection then loopConnection:Disconnect() loopConnection = nil end
        if cloneModel then cloneModel:Destroy() cloneModel = nil end
        
        if char then
            setCharacterInvisibleCompletely(char, false)
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then camera.CameraSubject = humanoid end
        end
    end
end)

-- Nút chuyển đổi góc nhìn Camera thông minh
switchCamBtn.MouseButton1Click:Connect(function()
    if not systemActive or not cloneModel then return end
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local cloneHead = cloneModel:FindFirstChild("Head")
    
    cameraIsOnClone = not cameraIsOnClone
    if cameraIsOnClone then
        if cloneHead then
            camera.CameraSubject = cloneHead
            switchCamBtn.Text = "Góc Nhìn: Đang ở CLONE (Di chuyển được)"
        end
    else
        if humanoid then
            camera.CameraSubject = humanoid
            switchCamBtn.Text = "Góc Nhìn: Đang ở FREE CAM (Bay tự do)"
        end
    end
end)

-- =====================================================================
-- PHẦN 2: HEALTH SMART ANTI-KB (DỰA VÀO SỰ KIỆN MẤT MÁU & TỐC ĐỘ BẤT THƯỜNG)
-- =====================================================================
antiKBBtn.MouseButton1Click:Connect(function()
    antiKBActive = not antiKBActive
    
    if antiKBActive then
        antiKBBtn.Text = "Bật Health Smart Anti-KB: BẬT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local char = player.Character
        if not char then return end
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not rootPart or not humanoid then return end
        
        lastSafeCFrame = rootPart.CFrame
        lastHealth = humanoid.Health
        
        -- Sự kiện lắng nghe khi nhân vật mất máu (bị đối thủ đánh trúng)
        healthConnection = humanoid.HealthChanged:Connect(function(newHealth)
            if newHealth < lastHealth then
                -- Vừa bị mất máu -> Đánh dấu đang nhận sát thương
                isTakingDamageRecently = true
                task.delay(0.6, function()
                    isTakingDamageRecently = false
                end)
            end
            lastHealth = newHealth
        end)
        
        -- Vòng quét kiểm tra tốc độ bất thường kết hợp trạng thái mất máu
        antiKBConnection = RunService.Heartbeat:Connect(function()
            if not char or not rootPart or not humanoid then return end
            
            pcall(function()
                local velocity = rootPart.AssemblyLinearVelocity
                local floorMaterial = humanoid.FloorMaterial
                local currentState = humanoid:GetState()
                
                -- Nếu đang đứng vững bình thường, lưu lại mốc an toàn
                if floorMaterial ~= Enum.Material.Air and math.abs(velocity.Y) < 2 then
                    lastSafeCFrame = rootPart.CFrame
                end
                
                -- Bỏ qua khi đang nhảy hoặc rơi tự do hợp pháp
                local isJumpingOrFalling = (currentState == Enum.HumanoidStateType.Jumping) or 
                                           (currentState == Enum.HumanoidStateType.Freefall and velocity.Y > -10)
                if isJumpingOrFalling then return end
                
                -- ĐIỀU KIỆN ANTI-KB CHUẨN XÁC: Chỉ kích hoạt khi VỪA BỊ MẤT MÁU + TỐC ĐỘ VĂNG NGANG/DỌC QUÁ LỚN (Bị đánh văng)
                local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
                local isKnockbacked = isTakingDamageRecently and ((horizontalSpeed > 16) or (velocity.Y < -20))
                
                if isKnockbacked then
                    -- Lập tức dịch chuyển về vị trí an toàn trước khi bị đánh văng, giữ nguyên vị trí, không bị tp nhầm chỗ cũ
                    if lastSafeCFrame then
                        rootPart.CFrame = lastSafeCFrame
                        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                end
                
                -- Xóa triệt để các lực vật lý văng do skill địch gán vào
                for _, child in pairs(rootPart:GetChildren()) do
                    if child:IsA("BodyVelocity") or child:IsA("BodyPosition") or child:IsA("LinearVelocity") or child:IsA("VectorForce") then
                        child:Destroy()
                    end
                end
            end)
        end)
    else
        antiKBBtn.Text = "Bật Health Smart Anti-KB: TẮT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        
        if antiKBConnection then antiKBConnection:Disconnect() antiKBConnection = nil end
        if healthConnection then healthConnection:Disconnect() healthConnection = nil end
    end
end)

-- Nút Reset an toàn
resetBtn.MouseButton1Click:Connect(function()
    if loopConnection then loopConnection:Disconnect() end
    if antiKBConnection then antiKBConnection:Disconnect() end
    if healthConnection then healthConnection:Disconnect() end
    if cloneModel then cloneModel:Destroy() end
    local char = player.Character
    if char then
        setCharacterInvisibleCompletely(char, false)
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then camera.CameraSubject = humanoid end
    end
end)

print("Đã tải xong hệ thống Free-Cam Fly & Health Anti-KB theo đúng yêu cầu!")
