--[[
    King Tower - Infinite ForceField & Sky Hitbox Script
    - Kéo dài thời gian khiên bảo vệ (ForceField) là vô hạn (Vĩnh cửu).
    - Đưa Hitbox thật lên trời để bất tử, né toàn bộ đòn đánh/đẩy trên tháp.
    - Tạo hình nộm hiển thị dưới tháp để tung chiêu mượt mà.
    - Giao diện UI viền cầu vồng (RGB) + Nút thu nhỏ linh hoạt.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

if _G.KingTowerInfiniteShield then return end
_G.KingTowerInfiniteShield = true

-- Tạo UI chính
local ScreenGui = Instance.new("ScreenGui")
