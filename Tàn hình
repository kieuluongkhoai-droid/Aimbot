-- Khởi tạo dịch vụ và biến môi trường
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

-- Xóa UI cũ nếu có
if CoreGui:FindFirstChild("UpGhostUI") then
    CoreGui.UpGhostUI:Destroy()
end

-- Tạo Giao Diện UI chính
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "UpGhostUI"
screenGui.Parent = CoreGui
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 220, 0, 160)
mainFrame.Position = UDim2.new(0.05, 0, 0.2, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = mainFrame

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 0, 35)
titleLabel.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
titleLabel.Text = "MENU BÓNG MA ĐẨY CAO"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.TextSize = 12
titleLabel.Font = Enum.Font.GothamBold
titleLabel.Parent = mainFrame

local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 8)
titleCorner.Parent = titleLabel

-- Nút Thu Nhỏ / Mở Rộng (-)
local minBtn = Instance.new("TextButton")
minBtn.Size = UDim2.new(0, 30, 0, 30)
minBtn.Position = UDim2.new(1, -33, 0, 2)
minBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
minBtn.Text = "-"
minBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
minBtn.TextSize = 16
minBtn.Font = Enum.Font.GothamBold
minBtn.Parent = mainFrame

local function createButton(posY, defaultText)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = defaultText
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = mainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    return btn
end

local upGhostBtn = createButton(45, "Bóng Ma Đẩy Cao: TẮT")
local resetBtn = createButton(95, "Khôi Phục / Reset")

local elementsToToggle = {upGhostBtn, resetBtn}
local isMinimized = false

minBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        minBtn.Text = "+"
        mainFrame.Size = UDim2.new(0, 220, 0, 35)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = false
        end
    else
        minBtn.Text = "-"
        mainFrame.Size = UDim2.new(0, 220, 0, 160)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = true
        end
    end
end)

local upGhostActive = false
local upConnection = nil

upGhostBtn.MouseButton1Click:Connect(function()
    upGhostActive = not upGhostActive
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    if upGhostActive then
        upGhostBtn.Text = "Bóng Ma Đẩy Cao: BẬT"
        upGhostBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        -- 1. Biến nhân vật thành tàng hình và tắt va chạm hoàn toàn
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
                v.CanCollide = false
            elseif v:IsA("Decal") then
                v.Transparency = 1
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then
                    handle.Transparency = 1
                    handle.CanCollide = false
                end
            end
        end
        
        -- 2. Đẩy hitbox lệch lên phía trên không trung một khoảng nhỏ (ví dụ +4 mét)
        upConnection = RunService.RenderStepped:Connect(function()
            if char and rootPart then
                pcall(function()
                    -- Dịch chuyển tâm nhận sát thương lên cao hơn vị trí hiển thị thật
                    rootPart.CFrame = rootPart.CFrame + Vector3.new(0, 4, 0)
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end)
            end
        end)
    else
        upGhostBtn.Text = "Bóng Ma Đẩy Cao: TẮT"
        upGhostBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        
        if upConnection then
            upConnection:Disconnect()
            upConnection = nil
        end
        
        player.Character:BreakJoints()
    end
end)

-- Nút Reset
resetBtn.MouseButton1Click:Connect(function()
    if player.Character then
        player.Character:BreakJoints()
    end
end)

print("Đã tải xong Script gambler_chance invisible immortal !")
