-- TÍNH NĂNG CỐT LÕI: CHIẾM QUYỀN HỒI SINH (ON-SPAWN OVERRIDE)
LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    if respawnMode == "None" then return end

    local targetCFrame = nil

    if respawnMode == "Custom" and customSafeCF then
        targetCFrame = customSafeCF
    elseif respawnMode == "Clone" and activeClone and activeClone:FindFirstChild("HumanoidRootPart") then
        targetCFrame = activeClone.HumanoidRootPart.CFrame
    end

    if targetCFrame then
        -- Vòng lặp ép CFrame cực gắt trong 0.5s đầu tiên để đè lên bệ đá hồi sinh của Server
        local connection
        local startTime = tick()
        connection = RunService.Heartbeat:Connect(function()
            local hrp = newCharacter:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Bám vào vị trí giả định liên tục trước khi AntiCheat bật lên
                hrp.CFrame = targetCFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
            end
            
            -- Giải phóng sau 0.5 giây (Lúc này nhân vật đã load xong hoàn toàn ở điểm mới)
            if tick() - startTime > 0.5 then
                connection:Disconnect()
                InfoLabel.Text = "Status: Successfully Bypassed Respawn!"
            end
        end)
    end
end)

