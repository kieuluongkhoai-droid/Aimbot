local InfoLabel = Instance.new("TextLabel")
InfoLabel.Size = UDim2.new(1, -20, 0, 25)
InfoLabel.Position = UDim2.new(0, 10, 0, 155)
InfoLabel.BackgroundTransparency = 1
InfoLabel.Text = "Status: Ready."
InfoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
InfoLabel.TextSize = 10
InfoLabel.Font = Enum.Font.Gotham
InfoLabel.Parent = MainFrame

local activeClone = nil
local viewingClone = true
local aiActive = true

SpawnBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        InfoLabel.Text = "Status: Character not found!"
        return
    end
    
    local hrp = character.HumanoidRootPart
    local pos = hrp.CFrame
    
    if activeClone then
        pcall(function() activeClone:Destroy() end)
        activeClone = nil
    end
    
    character.Archivable = true
    activeClone = character:Clone()
    character.Archivable = false
    
    activeClone.Name = "Client_Clone"
    activeClone.Parent = workspace
    activeClone:SetPrimaryPartCFrame(pos + Vector3.new(0, 3, 0))
    
    local cloneHrp = activeClone:FindFirstChild("HumanoidRootPart")
    local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
    
    -- Giấu thân thật xuống dưới đất
    hrp.CFrame = pos - Vector3.new(0, 15, 0)
    for _, p in ipairs(character:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.Transparency = 1
        end
    end
    
    for _, p in ipairs(activeClone:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Transparency = 0
        end
    end
    
    if cloneHum then
        Camera.CameraSubject = cloneHum
    end
    viewingClone = true
    aiActive = true
    SwitchBtn.Text = "👁️ View: [ CLONE AI ]"
    SwitchBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
    InfoLabel.Text = "Status: Clone active & hidden real body."
    
    if _G.PuppetConnection then _G.PuppetConnection:Disconnect() end
    
    _G.PuppetConnection = RunService.RenderStepped:Connect(function()
        if aiActive and activeClone and cloneHum and cloneHrp then
            local target = nil
            local minDist = math.huge
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (plr.Character.HumanoidRootPart.Position - cloneHrp.Position).Magnitude
                    if d < minDist then
                        minDist = d
                        target = plr.Character.HumanoidRootPart
                    end
                end
            end
            if target then
                cloneHum:MoveTo(target.Position)
            end
        end
    end)
end)

SwitchBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not activeClone then
        InfoLabel.Text = "Status: Spawn clone first!"
        return
    end
    
    viewingClone = not viewingClone
    local realHum = character:FindFirstChildOfClass("Humanoid")
    local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
    
    if viewingClone then
        if cloneHum then Camera.CameraSubject = cloneHum end
        aiActive = true
        SwitchBtn.Text = "👁️ View: [ CLONE AI ]"
        SwitchBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        InfoLabel.Text = "Status: Controlling Clone (AI ON)"
    else
        if realHum then Camera.CameraSubject = realHum end
        aiActive = false
        SwitchBtn.Text = "👁️ View: [ REAL BODY ]"
        SwitchBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        InfoLabel.Text = "Status: Real body view (AI OFF)"
    end
end)

ResetBtn.MouseButton1Click:Connect(function()
    if _G.PuppetConnection then
        _G.PuppetConnection:Disconnect()
        _G.PuppetConnection = nil
    end
    if activeClone then
        pcall(function() activeClone:Destroy() end)
        activeClone = nil
    end
    aiActive = false
    viewingClone = false
    
    local character = LocalPlayer.Character
    if character then
        for _, p in ipairs(character:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = true
                p.Transparency = 0
            end
        end
        local hum = character:FindFirstChildOfClass("Humanoid")
        if hum then Camera.CameraSubject = hum end
    end
    InfoLabel.Text = "Status: Reset completed."
end)
