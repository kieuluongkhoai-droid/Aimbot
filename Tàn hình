--[[
    King Tower - Precise Soul Transfer Script
    - Bấm lần 1: Nhập hồn sang Clone, Clone đến chỗ nhân vật gốc, nhân vật gốc về chỗ Clone cũ.
    - Bấm lần 2: Nhập hồn về nhân vật gốc, nhân vật gốc đến chỗ Clone hiện tại, Clone về chỗ nhân vật gốc cũ.
    - Giao diện UI viền cầu vồng + Nút thu nhỏ linh hoạt.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

if _G.KingTowerPreciseSwapLoaded then return end
_G.KingTowerPreciseSwapLoaded = true

-- Tạo UI chính
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PreciseSoulSwapUI"
ScreenGui.ResetOnSpawn = false
pcall(function() ScreenGui.Parent = CoreGui end)
if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local MainFrame = Instance.new("Frame")
