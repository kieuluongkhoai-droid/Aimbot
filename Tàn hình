local activeDecoy = nil
local isAIActive = false

DeployBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        InfoLabel.Text = "Status: Character not found!"
        return 
    end
    
    local startCF = character.HumanoidRootPart.CFrame
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")
    local realHrp = character.HumanoidRootPart
    
    if activeDecoy and activeDecoy.Parent then
        activeDecoy:Destroy()
        activeDecoy = nil
    end
    
    -- 1. GIỮ LẠI HUMANOID ĐỂ JOYSTICK MOBILE HOẠT ĐỘNG, NHƯNG KHÓA CHẶT SÁT THƯƠNG
    if realHumanoid then
        realHumanoid.MaxHealth = math.huge
        realHumanoid.Health = math.huge
        realHumanoid.HealthChanged:Connect(function()
            if realHumanoid.Health < realHumanoid.MaxHealth then
                realHumanoid.Health = realHumanoid.MaxHealth
            end
        end)
    end
    
    -- Làm mờ thân thật và tắt va chạm để xuyên tường tự do nhưng vẫn giữ quyền điều khiển joystick
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Transparency = 0.5
        end
    end
    
    -- 2. TẠO CLONE MỒI NHỬ (DECOY) HOẠT ĐỘNG ĐẦY ĐỦ
    character.Archivable = true
    activeDecoy = character:Clone()
    character.Archivable = false
    
    activeDecoy.Name = LocalPlayer.Name .. "_Decoy"
    activeDecoy.Parent = workspace
    activeDecoy:SetPrimaryPartCFrame(startCF + Vector3.new(3, 0, 0))
    
    local decoyHumanoid = activeDecoy:FindFirstChildOfClass("Humanoid")
    local decoyHrp = activeDecoy:FindFirstChild("HumanoidRootPart")
    
    if decoyHumanoid then
        decoyHumanoid.MaxHealth = math.huge
        decoyHumanoid.Health = math.huge
        decoyHumanoid.HealthChanged:Connect(function()
            if decoyHumanoid.Health < decoyHumanoid.MaxHealth then
                decoyHumanoid.Health = decoyHumanoid.MaxHealth
            end
        end)
    end
    
    for _, part in ipairs(activeDecoy:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
            part.CanTouch = true
            part.Transparency = 0
            pcall(function() part:SetNetworkOwner(LocalPlayer) end)
        end
    end
    
    if realHrp then 
        Camera.CameraSubject = realHrp 
    end
    
    -- 3. VÒNG LẶP ĐIỀU KHIỂN AI CHO CLONE
    if _G.MasterDecoyConnection then _G.MasterDecoyConnection:Disconnect() end
    _G.MasterDecoyConnection = RunService.RenderStepped:Connect(function()
        if isAIActive and activeDecoy and decoyHumanoid and decoyHrp then
            local nearestTarget = nil
            local shortestDist = math.huge
            
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHrp = player.Character.HumanoidRootPart
                    local dist = (targetHrp.Position - decoyHrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestTarget = targetHrp
                    end
                end
            end
            
            if nearestTarget then
                decoyHumanoid:MoveTo(nearestTarget.Position)
            end
        end
    end)
    
    InfoLabel.Text = "Status: Mobile Joystick & Decoy Fixed!"
end)

AIToggleBtn.MouseButton1Click:Connect(function()
    isAIActive = not isAIActive
    if isAIActive then
        AIToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        AIToggleBtn.Text = "🤖 Decoy AI: [ ACTIVE ]"
    else
        AIToggleBtn.TextColor3 = Color3.fromRGB(255, 200, 100)
        AIToggleBtn.Text = "🤖 Decoy AI: [ OFF ]"
        if activeDecoy and activeDecoy:FindFirstChildOfClass("Humanoid") and activeDecoy.PrimaryPart then
            activeDecoy:FindFirstChildOfClass("Humanoid"):MoveTo(activeDecoy.PrimaryPart.Position)
        end
    end
end)

local toggleState = false
CamToggleBtn.MouseButton1Click:Connect(function()
    toggleState = not toggleState
    local realChar = LocalPlayer.Character
    local decoyHumanoid = activeDecoy and activeDecoy:FindFirstChildOfClass("Humanoid")
    
    if toggleState then
        if decoyHumanoid then 
            Camera.CameraSubject = decoyHumanoid 
            InfoLabel.Text = "Status: Camera on Decoy"
        end
    else
        if realChar and realChar:FindFirstChildOfClass("Humanoid") then
            Camera.CameraSubject = realChar:FindFirstChildOfClass("Humanoid")
            InfoLabel.Text = "Status: Camera on Real Body"
        end
    end
end)

