switchCamBtn.Visible = false

-- Biến trạng thái toàn cục
local stealthActive = false
local antiKBActive = false
local cameraIsOnClone = true

local cloneModel = nil
local stealthConnection = nil
local antiKBConnection = nil

local lastSafeCFrame = nil
local isCurrentlyKnockbacked = false
local kbEndTime = 0

-- Biến điều khiển Fly cho Free Cam
local flySpeed = 50
local keysPressed = {
    W = false,
    S = false,
    A = false,
    D = false,
    Space = false,
    LeftControl = false
}

-- Hàm tàng hình triệt để 100% mọi thành phần (bao gồm phụ kiện, tóc, cánh, áo quần)
local function setCompletelyInvisible(targetModel, isHidden)
    if not targetModel then return end
    for _, v in pairs(targetModel:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Transparency = isHidden and 1 or 0
            v.CanCollide = not isHidden
            if isHidden then
                pcall(function() v:SetNetworkOwner(player) end)
            end
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = isHidden and 1 or 0
        elseif v:IsA("Accessory") then
            local handle = v:FindFirstChild("Handle")
            if handle then 
                handle.Transparency = isHidden and 1 or 0 
                handle.CanCollide = not isHidden
            end
        elseif v:IsA("Clothing") or v:IsA("ShirtGraphic") then
            v.Transparency = isHidden and 1 or 0
        end
    end
end

-- Lắng nghe phím bấm di chuyển Fly
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.W then keysPressed.W = true end
    if input.KeyCode == Enum.KeyCode.S then keysPressed.S = true end
    if input.KeyCode == Enum.KeyCode.A then keysPressed.A = true end
    if input.KeyCode == Enum.KeyCode.D then keysPressed.D = true end
    if input.KeyCode == Enum.KeyCode.Space then keysPressed.Space = true end
    if input.KeyCode == Enum.KeyCode.LeftControl then keysPressed.LeftControl = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then keysPressed.W = false end
    if input.KeyCode == Enum.KeyCode.S then keysPressed.S = false end
    if input.KeyCode == Enum.KeyCode.A then keysPressed.A = false end
    if input.KeyCode == Enum.KeyCode.D then keysPressed.D = false end
    if input.KeyCode == Enum.KeyCode.Space then keysPressed.Space = false end
    if input.KeyCode == Enum.KeyCode.LeftControl then keysPressed.LeftControl = false end
end)

-- =====================================================================
-- PHẦN 1: TÀNG HÌNH TUYỆT ĐỐI, CLONE & FREE CAM FLY
-- =====================================================================
stealthBtn.MouseButton1Click:Connect(function()
    stealthActive = not stealthActive
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not rootPart or not humanoid or not head then return end
    
    if stealthActive then
        stealthBtn.Text = "Bật Tàng Hình & Phân Tách: BẬT"
        stealthBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        switchCamBtn.Visible = true
        
        lastSafeCFrame = rootPart.CFrame
        
        -- Tạo bản sao giả lập (Clone) đặt trên trời cao (+20 mét)
        char.Archivable = true
        cloneModel = char:Clone()
        cloneModel.Name = "OptimizedClone"
        
        for _, desc in pairs(cloneModel:GetDescendants()) do
            if desc:IsA("Script") or desc:IsA("LocalScript") then
                desc:Destroy()
            end
        end
        
        -- Tàng hình clone hiển thị trên trời
        setCompletelyInvisible(cloneModel, true)
        for _, part in pairs(cloneModel:GetDescendants()) do
            if part:IsA("BasePart") then part.Anchored = true end
        end
        cloneModel.Parent = workspace
        
        -- Ẩn cơ thể gốc hoàn toàn khỏi server và người chơi khác
        setCompletelyInvisible(char, true)
        
        -- Tự động ẩn mọi vũ khí/tool mới được trang bị
        char.ChildAdded:Connect(function(child)
            if stealthActive and (child:IsA("Tool") or child:IsA("Model")) then
                task.wait(0.02)
                setCompletelyInvisible(child, true)
            end
        end)
        
        -- Khóa camera mặc định vào Clone trên trời
        cameraIsOnClone = true
        switchCamBtn.Text = "Camera: Đang ở CLONE (Trên trời)"
        local cloneHead = cloneModel:FindFirstChild("Head")
        if cloneHead then
            camera.CameraSubject = cloneHead
        end
        
        -- Vòng lặp xử lý đồng bộ và Fly Free Cam
        stealthConnection = RunService.RenderStepped:Connect(function(dt)
            if char and rootPart and cloneModel then
                pcall(function()
                    local cloneRoot = cloneModel:FindFirstChild("HumanoidRootPart")
                    if cloneRoot then
                        if cameraIsOnClone then
                            -- GÓC NHÌN CLONE: Clone bám theo tọa độ cơ thể gốc ở trên trời
                            cloneRoot.CFrame = rootPart.CFrame + Vector3.new(0, 20, 0)
                            for _, realPart in pairs(char:GetChildren()) do
                                if realPart:IsA("BasePart") then
                                    local clonePart = cloneModel:FindFirstChild(realPart.Name)
                                    if clonePart and realPart ~= rootPart then
                                        clonePart.CFrame = realPart.CFrame + Vector3.new(0, 20, 0)
                                    end
                                end
                            end
                        else
                            -- GÓC NHÌN FREE CAM: Bay tự do bằng phím, Clone khóa cố định trên trời tránh sát thương
                            local moveDir = Vector3.new(0, 0, 0)
                            local camCF = camera.CFrame
                            
                            if keysPressed.W then moveDir = moveDir + camCF.LookVector end
                            if keysPressed.S then moveDir = moveDir - camCF.LookVector end
                            if keysPressed.A then moveDir = moveDir - camCF.RightVector end
                            if keysPressed.D then moveDir = moveDir + camCF.RightVector end
                            if keysPressed.Space then moveDir = moveDir + Vector3.new(0, 1, 0) end
                            if keysPressed.LeftControl then moveDir = moveDir - Vector3.new(0, 1, 0) end
                            
                            if moveDir.Magnitude > 0 then
                                rootPart.CFrame = rootPart.CFrame + (moveDir.Unit * flySpeed * dt)
                            end
                            
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                    end
                end)
            end
        end)
    else
        stealthBtn.Text = "Bật Tàng Hình & Phân Tách: TẮT"
        stealthBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        switchCamBtn.Visible = false
        
        if stealthConnection then
            stealthConnection:Disconnect()
            stealthConnection = nil
        end
        if cloneModel then
            cloneModel:Destroy()
            cloneModel = nil
        end
        
        if char then
            setCompletelyInvisible(char, false)
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then camera.CameraSubject = humanoid end
        end
    end
end)

-- Nút đổi Camera
switchCamBtn.MouseButton1Click:Connect(function()
    if not stealthActive or not cloneModel then return end
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local cloneHead = cloneModel:FindFirstChild("Head")
    
    cameraIsOnClone = not cameraIsOnClone
    if cameraIsOnClone then
        if cloneHead then
            camera.CameraSubject = cloneHead
            switchCamBtn.Text = "Camera: Đang ở CLONE (Trên trời)"
        end
    else
        if humanoid then
            camera.CameraSubject = humanoid
            switchCamBtn.Text = "Camera: Đang ở FREE CAM (Bay tự do)"
        end
    end
end)

-- =====================================================================
-- PHẦN 2: FAST & SENSITIVE ANTI-KB (BẮT CỰC NHẠY MỌI LOẠI KB)
-- =====================================================================
antiKBBtn.MouseButton1Click:Connect(function()
    antiKBActive = not antiKBActive
    
    if antiKBActive then
        antiKBBtn.Text = "Bật Fast Anti-KB: BẬT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local char = player.Character
        if not char then return end
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not rootPart or not humanoid then return end
        
        lastSafeCFrame = rootPart.CFrame
        
        antiKBConnection = RunService.Heartbeat:Connect(function(dt)
            if not char or not rootPart or not humanoid then return end
            
            pcall(function()
                local velocity = rootPart.AssemblyLinearVelocity
                local floorMaterial = humanoid.FloorMaterial
                local currentTime = tick()
                local currentState = humanoid:GetState()
                
                if isCurrentlyKnockbacked then
                    if currentTime > kbEndTime then
                        isCurrentlyKnockbacked = false
                        lastSafeCFrame = rootPart.CFrame
                    else
                        return
                    end
                end
                
                -- Phân biệt nhảy chủ động (không bị TP nhầm)
                local isExplicitlyJumping = (currentState == Enum.HumanoidStateType.Jumping) or 
                                            (currentState == Enum.HumanoidStateType.Freefall and velocity.Y > -8) or
                                            (floorMaterial ~= Enum.Material.Air)
                
                if isExplicitlyJumping then
                    if floorMaterial ~= Enum.Material.Air and math.abs(velocity.Y) < 3 then
                        lastSafeCFrame = rootPart.CFrame
                    end
                else
                    -- Cải tiến ngưỡng nhận diện KB: Nhạy hơn rất nhiều với mọi đòn hất tung nhỏ/văng bất thường
                    local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
                    local isKnockbacked = (horizontalSpeed > 14) or (velocity.Y < -18) or (math.abs(velocity.X) > 14) or (math.abs(velocity.Z) > 14)
                    
                    if isKnockbacked then
                        isCurrentlyKnockbacked = true
                        kbEndTime = currentTime + 0.5 -- Thời gian giữ chân chống văng ngắn hơn, phản ứng nhanh hơn
                        
                        if lastSafeCFrame then
                            rootPart.CFrame = lastSafeCFrame
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                    else
                        if currentTime - lastCheckTick > 0.25 then
                            lastCheckTick = currentTime
                            if floorMaterial ~= Enum.Material.Air then
                                lastSafeCFrame = rootPart.CFrame
                            end
                        end
                    end
                end
                
                -- Xóa triệt để các lực vật lý văng do địch tác động
                for _, child in pairs(rootPart:GetChildren()) do
                    if child:IsA("BodyVelocity") or child:IsA("BodyPosition") or child:IsA("LinearVelocity") or child:IsA("VectorForce") then
                        child:Destroy()
                    end
                end
            end)
        end)
    else
        antiKBBtn.Text = "Bật Fast Anti-KB: TẮT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        
        if antiKBConnection then
            antiKBConnection:Disconnect()
            antiKBConnection = nil
        end
    end
end)

