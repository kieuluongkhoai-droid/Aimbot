CamRealBtn.Parent = Container

local UIC_3 = Instance.new("UICorner") UIC_3.CornerRadius = UDim.new(0, 6) UIC_3.Parent = CamRealBtn

local activeClone = nil
local syncConnection = nil

ActivateBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        InfoLabel.Text = "Status: Character not found!"
        return 
    end
    
    local startCF = character.HumanoidRootPart.CFrame
    
    if activeClone and activeClone.Parent then
        activeClone:Destroy()
        activeClone = nil
    end
    
    -- 1. BIẾN CƠ THỂ GỐC THÀNH VẬT THỂ (Xóa hoàn toàn hitbox va chạm, chỉ để nhìn/camera)
    character.Name = "ObjectCameraAnchor"
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.Transparency = 0.5 -- Làm mờ cơ thể gốc cho dễ nhận biết
        end
    end
    
    local realHumanoid = character:FindFirstChildOfClass("Humanoid")
    if realHumanoid then
        realHumanoid.PlatformStand = true
    end
    
    -- 2. TẠO CLONE MANG NGUYÊN VẸN TAG PLAYER VÀ HITBOX ĐỂ ĐỨNG DƯỚI ĐẤT CHỊU ĐÒN
    character.Archivable = true
    activeClone = character:Clone()
    character.Archivable = false
    
    activeClone.Name = LocalPlayer.Name
    activeClone.Parent = workspace
    activeClone:SetPrimaryPartCFrame(startCF + Vector3.new(3, 0, 0))
    
    -- Khôi phục hoàn toàn hitbox cho Clone
    for _, part in ipairs(activeClone:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
            part.CanTouch = true
            part.CanQuery = true
            part.Transparency = 0
        end
    end
    
    local cloneHumanoid = activeClone:FindFirstChildOfClass("Humanoid")
    local cloneHrp = activeClone:FindFirstChild("HumanoidRootPart")
    local realHrp = character.HumanoidRootPart
    
    if cloneHumanoid then
        cloneHumanoid.PlatformStand = false
        cloneHumanoid.AutoRotate = true
    end
    
    -- Đưa camera mặc định nhìn vào cơ thể gốc (vật thể an toàn)
    Camera.CameraSubject = realHumanoid
    
    -- 3. ĐỒNG BỘ ĐIỀU KHIỂN TỪ ANCHOR SANG CLONE HOẶC NGƯỢC LẠI
    if syncConnection then syncConnection:Disconnect() end
    syncConnection = RunService.RenderStepped:Connect(function()
        if character and character.Parent and activeClone and activeClone.Parent then
            local moveDir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
                moveDir = moveDir + Vector3.new(0, 0, -1)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
                moveDir = moveDir + Vector3.new(0, 0, 1)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
                moveDir = moveDir + Vector3.new(-1, 0, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
                moveDir = moveDir + Vector3.new(1, 0, 0)
            end
            
            if moveDir.Magnitude > 0 and cloneHumanoid then
                local camLook = Camera.CFrame.LookVector
                camLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
                local camRight = Camera.CFrame.RightVector
                camRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
                
                local worldDir = (camRight * moveDir.X + camLook * -moveDir.Z).Unit
                cloneHumanoid:Move(worldDir, false)
                
                -- Đồng thời dịch chuyển cơ thể gốc (Anchor) đi theo Clone nhưng ở trên cao hoặc lệch một khoảng an toàn
                if realHrp and cloneHrp then
                    realHrp.CFrame = cloneHrp.CFrame + Vector3.new(0, 10, 0) -- Treo lơ lửng trên đầu clone 10 studs làm trạm camera vô hình
                end
            end
        end
    end)
    
    InfoLabel.Text = "Status: Clone is Player Bait, Real Body is Camera Object!"
end)

CamCloneBtn.MouseButton1Click:Connect(function()
    if activeClone and activeClone:FindFirstChildOfClass("Humanoid") then
        Camera.CameraSubject = activeClone.Humanoid
        InfoLabel.Text = "Status: Camera on Clone Hitbox"
    end
end)

CamRealBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if character and character:FindFirstChildOfClass("Humanoid") then
        Camera.CameraSubject = character:FindFirstChildOfClass("Humanoid")
        InfoLabel.Text = "Status: Camera on Object Anchor"
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    if syncConnection then syncConnection:Disconnect() syncConnection = nil end
    if activeClone then
        activeClone:Destroy()
        activeClone = nil
    end
    InfoLabel.Text = "Status: Reset - Normal Mode"
end)
