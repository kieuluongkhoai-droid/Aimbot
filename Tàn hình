end)

-- 1. Tàn Hình kiểu tách rời và dịch chuyển bộ phận đi nơi khác (Không cần chết)
local invisActive = false
invisBtn.MouseButton1Click:Connect(function()
    invisActive = not invisActive
    local char = player.Character
    if not char then return end
    
    if invisActive then
        invisBtn.Text = "Tàn Hình (Giấu Bộ Phận): BẬT"
        invisBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        -- Ngắt kết nối các Motor6D và ném các bộ phận (tay, chân, phụ kiện) xuống dưới lòng đất sâu để ẩn hoàn toàn
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("Motor6D") then
                v.Part0 = nil
            elseif v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                -- Dịch chuyển các bộ phận rời xa vị trí thật để người khác không nhìn thấy
                v.CFrame = CFrame.new(0, -500, 0)
            end
        end
    else
        invisBtn.Text = "Tàn Hình (Giấu Bộ Phận): TẮT"
        invisBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        player.Character:BreakJoints() -- Reset lại nhân vật khi tắt tàn hình
    end
end)

-- 2. Anti-Knockback Thông Minh (Phân biệt rõ lúc Nhảy và lúc bị Hất Tung)
local antiKBActive = false
local kbConnection = nil
local lastSafeCFrame = nil

antiKBBtn.MouseButton1Click:Connect(function()
    antiKBActive = not antiKBActive
    
    if antiKBActive then
        antiKBBtn.Text = "Anti-KB Thông Minh: BẬT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            lastSafeCFrame = char.HumanoidRootPart.CFrame
        end
        
        kbConnection = RunService.RenderStepped:Connect(function()
            local character = player.Character
            if character then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                
                if rootPart and humanoid then
                    local moveDirection = humanoid.MoveDirection
                    local isMoving = moveDirection.Magnitude > 0
                    local currentState = humanoid:GetState()
                    
                    -- Bỏ qua kiểm tra nếu nhân vật đang trong trạng thái chủ động NHẢY (Jumping) hoặc RƠI TỰ DO (Freefall) bình thường
                    local isJumpingOrFalling = (currentState == Enum.HumanoidStateType.Jumping or currentState == Enum.HumanoidStateType.Freefall)
                    
                    if not humanoid.PlatformStand and humanoid.Health > 0 and not isJumpingOrFalling then
                        -- Nếu đứng yên hoặc di chuyển bình thường mà bị đẩy văng trái phép > 2 mét
                        if not isMoving and lastSafeCFrame then
                            local distance = (rootPart.Position - lastSafeCFrame.Position).Magnitude
                            if distance > 2 then 
                                rootPart.CFrame = lastSafeCFrame
                                pcall(function()
                                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                end)
                            end
                        end
                        
                        -- Cập nhật tọa độ an toàn liên tục khi đi lại bình thường
                        if isMoving or rootPart.AssemblyLinearVelocity.Magnitude < 15 then
                            lastSafeCFrame = rootPart.CFrame
                        end
                    end
                    
                    -- Chỉ chống hất tung mạnh khi thực sự dính trạng thái Ragdoll (PlatformStand) hoặc bay vút lên trời ngoài ý muốn
                    if (humanoid.PlatformStand or (rootPart.AssemblyLinearVelocity.Y > 35 and not isJumpingOrFalling)) and lastSafeCFrame then
                        rootPart.CFrame = lastSafeCFrame
                        pcall(function()
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end)
                        humanoid.PlatformStand = false
                    end
                end
            end
        end)
    else
        antiKBBtn.Text = "Anti-KB Thông Minh: TẮT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if kbConnection then
            kbConnection:Disconnect()
            kbConnection = nil
        end
    end
end)

-- 3. Nút Reset nhanh
resetBtn.MouseButton1Click:Connect(function()
    if player.Character then
        player.Character:BreakJoints()
    end
end)

