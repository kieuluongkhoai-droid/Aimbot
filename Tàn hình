-- Biến trạng thái
local cloneChar = nil
local skyPlatform = nil
local isModeActive = false
local currentViewIsClone = true

-- Tạo một tấm sàn (tấm bìa) lớn trên trời để cơ thể chính đứng an toàn
local function createSkyPlatform(basePos)
    if skyPlatform then skyPlatform:Destroy() end
    
    skyPlatform = Instance.new("Part")
    skyPlatform.Name = "TowerSkyPlatform"
    skyPlatform.Size = Vector3.new(30, 1, 30) -- Tấm bìa rộng rãi
    skyPlatform.CFrame = CFrame.new(basePos.X, basePos.Y + 3000, basePos.Z)
    skyPlatform.Anchored = true
    skyPlatform.CanCollide = true
    skyPlatform.Transparency = 0.3 -- Có thể nhìn thấy mờ mờ như một tấm bìa lơ lửng trên trời
    skyPlatform.BrickColor = BrickColor.new("Medium stone grey")
    skyPlatform.Parent = workspace
end

local function removeSkyPlatform()
    if skyPlatform then
        skyPlatform:Destroy()
        skyPlatform = nil
    end
end

-- Vô hiệu hóa hitbox của Clone để Clone chỉ là hình nộm đi trước mở đường, không nhận sát thương
local function disableCloneHitbox(model)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
        end
    end
end

-- Nút 1: Bật/Tắt chế độ
ToggleBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local realHrp = character.HumanoidRootPart

    if not isModeActive then
        local startCF = realHrp.CFrame
        
        -- 1. Tạo tấm sàn (tấm bìa) trên trời
        createSkyPlatform(startCF.Position)
        
        -- 2. Đưa cơ thể chính (có hitbox thật) lên đứng trên tấm bìa trên trời
        realHrp.CFrame = CFrame.new(startCF.X, startCF.Y + 3005, startCF.Z)
        
        -- 3. Tạo Clone (hình nộm) đứng ở vị trí dưới đất ban đầu để đi trước mở đường
        if not cloneChar or not cloneChar.Parent then
            character.Archivable = true
            cloneChar = character:Clone()
            character.Archivable = false
            
            for _, v in ipairs(cloneChar:GetDescendants()) do
                if v:IsA("LocalScript") or v:IsA("Script") then v:Destroy() end
            end
            cloneChar.Name = "DummyPathfinderClone"
            cloneChar.Parent = workspace
            cloneChar:SetPrimaryPartCFrame(startCF)
            
            -- Tắt hitbox của Clone để không nhận sát thương
            disableCloneHitbox(cloneChar)
        end
        
        -- 4. Tự động chuyển Camera sang Clone ngay từ đầu để bạn điều khiển mở đường
        if cloneChar:FindFirstChild("Humanoid") then
            Camera.CameraSubject = cloneChar.Humanoid
        end
        
        isModeActive = true
        currentViewIsClone = true
        ToggleBtn.Text = "🛡️ Mode: ON (Protected)"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
        CamBtn.Text = "👁️ View: Clone (Dummy)"
        InfoLabel.Text = "Status: Real Body on Sky Platform"
    else
        -- Tắt chế độ: Kéo cơ thể chính về lại chỗ Clone
        if cloneChar and cloneChar:FindFirstChild("HumanoidRootPart") then
            realHrp.CFrame = cloneChar.HumanoidRootPart.CFrame
        end
        
        removeSkyPlatform()
        if cloneChar then
            cloneChar:Destroy()
            cloneChar = nil
        end
        
        if character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = character.Humanoid
        end
        
        isModeActive = false
        ToggleBtn.Text = "🛡️ Mode: OFF (Normal)"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        CamBtn.Text = "👁️ View: Normal"
        InfoLabel.Text = "Status: Normal Mode"
    end
end)

-- Nút 2: Đổi góc nhìn Camera qua lại giữa Clone và Cơ thể chính trên trời
CamBtn.MouseButton1Click:Connect(function()
    if not isModeActive then return end
    local character = LocalPlayer.Character
    if not character then return end
    
    currentViewIsClone = not currentViewIsClone
    
    if currentViewIsClone then
        if cloneChar and cloneChar:FindFirstChild("Humanoid") then
            Camera.CameraSubject = cloneChar.Humanoid
            CamBtn.Text = "👁️ View: Clone (Dummy)"
            InfoLabel.Text = "Camera on Clone (Opening path)"
        end
    else
        if character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = character.Humanoid
            CamBtn.Text = "👁️ View: Real Body (Sky)"
            InfoLabel.Text = "Camera on Real Body (Sky platform)"
        end
    end
end)

-- Nút 3: Đến cuối tháp - Dịch chuyển cơ thể chính từ trên trời xuống vị trí Clone để chiến thắng
SwapBtn.MouseButton1Click:Connect(function()
    if not isModeActive or not cloneChar then return end
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local realHrp = character.HumanoidRootPart
    local cloneHrp = cloneChar:FindFirstChild("HumanoidRootPart")
    
    if cloneHrp then
        -- Đưa cơ thể chính xuống vị trí hiện tại của Clone (cuối tháp)
        realHrp.CFrame = cloneHrp.CFrame
        
        -- Chuyển góc nhìn Camera về cơ thể chính để bạn trực tiếp chiến đấu/chạm vạch chiến thắng
        if character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = character.Humanoid
        end
        
        -- Xóa sàn trên trời và hủy Clone đi vì đã hoàn thành nhiệm vụ
        removeSkyPlatform()
        cloneChar:Destroy()
        cloneChar = nil
        
        isModeActive = false
        ToggleBtn.Text = "🛡️ Mode: OFF (Normal)"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        CamBtn.Text = "👁️ View: Normal"
        InfoLabel.Text = "Status: Real Body at Finish Line!"
    end
end)

