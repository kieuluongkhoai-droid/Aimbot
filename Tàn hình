--[[
    King Tower - Anti-Hitbox / God Mode Script
    - Đưa toàn bộ thân xác thật lên trời để bất tử, né mọi đòn đẩy/đấm.
    - Tạo nhân bản ảo để điều khiển và tung chiêu trên tháp.
    - Giao diện UI viền cầu vồng + Nút thu nhỏ linh hoạt.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

if _G.KingTowerGodMode then return end
_G.KingTowerGodMode = true

-- Tạo UI chính
