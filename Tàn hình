    if antiTpConnection then antiTpConnection:Disconnect() antiTpConnection = nil end
    if cloneMoveConnection then cloneMoveConnection:Disconnect() cloneMoveConnection = nil end
    removeSkyPlatform()
    if cloneChar then
        cloneChar:Destroy()
        cloneChar = nil
    end
    InfoLabel.Text = "Status: Character Reset - Normal Mode"
end)
