local function createButton(posY, defaultText)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = defaultText
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = mainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    return btn
end

local invisBtn = createButton(45, "Tàn Hình (Văng Tay): TẮT")
local antiKBBtn = createButton(90, "Anti-KB Siêu Tốc: TẮT")
local resetBtn = createButton(135, "Khôi Phục / Reset")

-- Xử lý ẩn/hiện khi thu nhỏ UI
local elementsToToggle = {invisBtn, antiKBBtn, resetBtn}
local isMinimized = false

minBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        minBtn.Text = "+"
        mainFrame.Size = UDim2.new(0, 220, 0, 35)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = false
        end
    else
        minBtn.Text = "-"
        mainFrame.Size = UDim2.new(0, 220, 0, 180)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = true
        end
    end
end)

-- 1. Tính năng Tàn Hình bằng cách làm "bay/văng các bộ phận ra xa" (Kể cả vũ khí)
local invisActive = false
invisBtn.MouseButton1Click:Connect(function()
    invisActive = not invisActive
    local char = player.Character
    if not char then return end
    
    if invisActive then
        invisBtn.Text = "Tàn Hình (Văng Tay): BẬT"
        invisBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        -- Kỹ thuật bẻ gãy các khớp nối (Joints) của tay/chân để chúng văng đi nơi khác, giấu luôn vũ khí đang cầm
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("Motor6D") then
                v.Part0 = nil -- Ngắt kết nối khớp nối để bộ phận rơi ra hoặc bay đi
            end
        end
    else
        invisBtn.Text = "Tàn Hình (Văng Tay): TẮT"
        invisBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        player.Character:BreakJoints() -- Reset lại nhân vật về bình thường
    end
end)

-- 2. Tính năng Anti-Knockback Siêu Tốc (Phản ứng tức thì, kéo về chỗ cũ siêu nhanh)
local antiKBActive = false
local kbConnection = nil
local lastSafeCFrame = nil

antiKBBtn.MouseButton1Click:Connect(function()
    antiKBActive = not antiKBActive
    
    if antiKBActive then
        antiKBBtn.Text = "Anti-KB Siêu Tốc: BẬT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            lastSafeCFrame = char.HumanoidRootPart.CFrame
        end
        
        kbConnection = RunService.RenderStepped:Connect(function()
            local character = player.Character
            if character then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                
                if rootPart and humanoid then
                    local moveDirection = humanoid.MoveDirection
                    local isMoving = moveDirection.Magnitude > 0
                    
                    if not humanoid.PlatformStand and humanoid.Health > 0 then
                        -- Ngưỡng siêu nhạy: Chỉ cần lệch trên 1.5 mét là kéo về ngay lập tức không chần chừ
                        if not isMoving and lastSafeCFrame then
                            local distance = (rootPart.Position - lastSafeCFrame.Position).Magnitude
                            if distance > 1.5 then 
                                rootPart.CFrame = lastSafeCFrame
                                pcall(function()
                                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                end)
                            end
                        end
                        
                        -- Cập nhật liên tục tọa độ an toàn khi đi lại bình thường
                        if isMoving or rootPart.AssemblyLinearVelocity.Magnitude < 15 then
                            lastSafeCFrame = rootPart.CFrame
                        end
                    end
                    
                    -- Chống hất tung / bay lên trời ngay khi vừa có dấu hiệu văng
                    if (humanoid.PlatformStand or rootPart.AssemblyLinearVelocity.Y > 20) and lastSafeCFrame then
                        rootPart.CFrame = lastSafeCFrame
                        pcall(function()
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end)
                        humanoid.PlatformStand = false
                    end
                end
            end
        end)
    else
        antiKBBtn.Text = "Anti-KB Siêu Tốc: TẮT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if kbConnection then
            kbConnection:Disconnect()
            kbConnection = nil
        end
    end
end)

-- 3. Nút Reset nhanh
resetBtn.MouseButton1Click:Connect(function()
    if player.Character then
        player.Character:BreakJoints()
    end
end)

