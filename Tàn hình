--[[
    King Tower - Ultimate Safe Noclip & Bypass Hub
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

if _G.BypassConnection then
    pcall(function() _G.BypassConnection:Disconnect() end)
    _G.BypassConnection = nil
end

pcall(function()
    if CoreGui:FindFirstChild("BypassHubUI") then
        CoreGui.BypassHubUI:Destroy()
    end
end)

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BypassHubUI"
ScreenGui.ResetOnSpawn = false
pcall(function() ScreenGui.Parent = CoreGui end)
if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 260, 0, 160)
MainFrame.Position = UDim2.new(0, 50, 0, 150)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICornerMain = Instance.new("UICorner")
UICornerMain.CornerRadius = UDim.new(0, 12)
UICornerMain.Parent = MainFrame

local UIStroke = Instance.new("UIStroke")
UIStroke.Thickness = 2
UIStroke.Color = Color3.fromRGB(0, 255, 128)
UIStroke.Parent = MainFrame

local TitleLabel = Instance.new("TextLabel")
TitleLabel.Size = UDim2.new(1, 0, 0, 35)
TitleLabel.BackgroundTransparency = 1
TitleLabel.Text = "🛡️ Safe Noclip & Bypass Hub"
TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TitleLabel.TextSize = 11
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.Parent = MainFrame

local Container = Instance.new("Frame")
Container.Size = UDim2.new(1, -20, 0, 80)
Container.Position = UDim2.new(0, 10, 0, 40)
Container.BackgroundTransparency = 1
Container.Parent = MainFrame

local NoclipBtn = Instance.new("TextButton")
NoclipBtn.Size = UDim2.new(1, 0, 0, 35)
NoclipBtn.Position = UDim2.new(0, 0, 0, 0)
NoclipBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
NoclipBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
NoclipBtn.TextSize = 11
NoclipBtn.Font = Enum.Font.GothamBold
NoclipBtn.Text = "👻 Safe Noclip Mode: [ OFF ]"
NoclipBtn.Parent = Container

local UIC_1 = Instance.new("UICorner") UIC_1.CornerRadius = UDim.new(0, 6) UIC_1.Parent = NoclipBtn

local ResetBtn = Instance.new("TextButton")
ResetBtn.Size = UDim2.new(1, 0, 0, 35)
ResetBtn.Position = UDim2.new(0, 0, 0, 42)
ResetBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
ResetBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
ResetBtn.TextSize = 11
ResetBtn.Font = Enum.Font.GothamBold
ResetBtn.Text = "🔄 Reset Normal State"
ResetBtn.Parent = Container

local UIC_2 = Instance.new("UICorner") UIC_2.CornerRadius = UDim.new(0, 6) UIC_2.Parent = ResetBtn

local InfoLabel = Instance.new("TextLabel")
InfoLabel.Size = UDim2.new(1, -20, 0, 25)
InfoLabel.Position = UDim2.new(0, 10, 0, 125)
InfoLabel.BackgroundTransparency = 1
InfoLabel.Text = "Status: Ready."
InfoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
InfoLabel.TextSize = 10
InfoLabel.Font = Enum.Font.Gotham
InfoLabel.Parent = MainFrame

local isNoclipActive = false

NoclipBtn.MouseButton1Click:Connect(function()
    isNoclipActive = not isNoclipActive
    local character = LocalPlayer.Character
    if not character then 
        InfoLabel.Text = "Status: Character not found!"
        return 
    end
    
    if isNoclipActive then
        NoclipBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        NoclipBtn.Text = "👻 Safe Noclip Mode: [ ACTIVE ]"
        InfoLabel.Text = "Status: Noclip Active (Bypassing obstacles & traps)."
        
        if _G.BypassConnection then _G.BypassConnection:Disconnect() end
        
        -- Vòng lặp liên tục tắt va chạm toàn bộ cơ thể để không chạm vào Kill Brick dưới sàn
        _G.BypassConnection = RunService.Stepped:Connect(function()
            if character and character.Parent then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        NoclipBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        NoclipBtn.Text = "👻 Safe Noclip Mode: [ OFF ]"
        InfoLabel.Text = "Status: Noclip Disabled."
        
        if _G.BypassConnection then
            _G.BypassConnection:Disconnect()
            _G.BypassConnection = nil
        end
        
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
    end
end)

ResetBtn.MouseButton1Click:Connect(function()
    if _G.BypassConnection then
        _G.BypassConnection:Disconnect()
        _G.BypassConnection = nil
    end
    isNoclipActive = false
    NoclipBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
    NoclipBtn.Text = "👻 Safe Noclip Mode: [ OFF ]"
    InfoLabel.Text = "Status: Reset completed."
end)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    if _G.BypassConnection then
        _G.BypassConnection:Disconnect()
        _G.BypassConnection = nil
    end
    isNoclipActive = false
end)
