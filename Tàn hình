-- Script Tàn Hình Pro + Anti-KB / Sit / Roll + Nút Thu Nhỏ UI
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

-- Xóa UI cũ nếu có
if CoreGui:FindFirstChild("RobloxInvisUI") then
    CoreGui.RobloxInvisUI:Destroy()
end

-- Tạo Giao Diện UI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "RobloxInvisUI"
screenGui.Parent = CoreGui
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 220, 0, 180)
mainFrame.Position = UDim2.new(0.05, 0, 0.2, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = mainFrame

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 0, 35)
titleLabel.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
titleLabel.Text = "MENU TÀN HÌNH PRO"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.TextSize = 14
titleLabel.Font = Enum.Font.GothamBold
titleLabel.Parent = mainFrame

local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 8)
titleCorner.Parent = titleLabel

-- Tạo nút Thu Nhỏ / Mở Rộng (-) nằm ở góc phải tiêu đề
local minBtn = Instance.new("TextButton")
minBtn.Size = UDim2.new(0, 30, 0, 30)
minBtn.Position = UDim2.new(1, -33, 0, 2)
minBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
minBtn.Text = "-"
minBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
minBtn.TextSize = 16
minBtn.Font = Enum.Font.GothamBold
minBtn.Parent = mainFrame

local minCorner = Instance.new("UICorner")
minCorner.CornerRadius = UDim.new(0, 6)
minCorner.Parent = minBtn

local function createButton(posY, defaultText)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = defaultText
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = mainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    return btn
end

local invisBtn = createButton(45, "Tàn Hình Tuyệt Đối: TẮT")
local antiKBBtn = createButton(90, "Anti-KB / Sit / Roll: TẮT")
local resetBtn = createButton(135, "Khôi Phục / Reset")

-- Lưu trữ danh sách các tính năng cần ẩn khi thu nhỏ UI
local elementsToToggle = {invisBtn, antiKBBtn, resetBtn}
local isMinimized = false

minBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        minBtn.Text = "+"
        mainFrame.Size = UDim2.new(0, 220, 0, 35) -- Chỉ giữ lại thanh tiêu đề
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = false
        end
    else
        minBtn.Text = "-"
        mainFrame.Size = UDim2.new(0, 220, 0, 180) -- Phục hồi kích thước cũ
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = true
        end
    end
end)

local isInvisible = false
local protectionActive = false
local protectionConnection = nil

-- 1. Xử lý Tàn Hình Tuyệt Đối
invisBtn.MouseButton1Click:Connect(function()
    local character = player.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not rootPart or not humanoid then return end

    isInvisible = not isInvisible
    
    if isInvisible then
        invisBtn.Text = "Tàn Hình Tuyệt Đối: BẬT"
        invisBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local pos = rootPart.CFrame
        
        for _, v in pairs(character:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("MeshPart") then
                v.Transparency = 1
                v.CastShadow = false
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then handle.Transparency = 1 end
            elseif v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                v.Enabled = false
            end
        end
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        rootPart.CFrame = CFrame.new(pos.X, -499, pos.Z)
    else
        invisBtn.Text = "Tàn Hình Tuyệt Đối: TẮT"
        invisBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        player.Character:BreakJoints()
    end
end)

-- 2. Xử lý Chống Knockback, Chống Ngồi (Anti-Sit) và Chống Lăn/Lật (Anti-Roll)
antiKBBtn.MouseButton1Click:Connect(function()
    protectionActive = not protectionActive
    
    if protectionActive then
        antiKBBtn.Text = "Anti-KB / Sit / Roll: BẬT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        protectionConnection = RunService.Stepped:Connect(function()
            local character = player.Character
            if character then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                
                if rootPart and humanoid then
                    local vel = rootPart.AssemblyLinearVelocity
                    if vel.Magnitude > 45 and not humanoid.PlatformStand then
                        rootPart.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
                    end
                    
                    if humanoid.Sit then
                        humanoid.Sit = false
                    end
                    
                    if humanoid.PlatformStand then
                        humanoid.PlatformStand = false
                    end
                end
            end
        end)
    else
        antiKBBtn.Text = "Anti-KB / Sit / Roll: TẮT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if protectionConnection then
            protectionConnection:Disconnect()
            protectionConnection = nil
        end
    end
end)

-- 3. Nút Reset nhanh
resetBtn.MouseButton1Click:Connect(function()
    if player.Character then
        player.Character:BreakJoints()
    end
end)

print("Đã tải xong Script kèm nút thu nhỏ UI!")
