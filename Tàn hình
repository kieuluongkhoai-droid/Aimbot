-- Biến trạng thái toàn cục
local stealthActive = false
local antiKBActive = false
local cameraIsOnClone = true

local cloneModel = nil
local stealthConnection = nil
local antiKBConnection = nil

local lastSafeCFrame = nil
local isCurrentlyKnockbacked = false
local kbEndTime = 0

-- Hàm tàng hình và ẩn hoàn toàn khỏi server/người khác
local function setCompletelyInvisible(targetModel, isHidden)
    if not targetModel then return end
    for _, v in pairs(targetModel:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Transparency = isHidden and 1 or 0
            v.CanCollide = not isHidden
            if isHidden then
                pcall(function() v:SetNetworkOwner(player) end)
            end
        elseif v:IsA("Decal") then
            v.Transparency = isHidden and 1 or 0
        elseif v:IsA("Accessory") then
            local handle = v:FindFirstChild("Handle")
            if handle then handle.Transparency = isHidden and 1 or 0 end
        end
    end
end

-- =====================================================================
-- PHẦN 1: TÀNG HÌNH TUYỆT ĐỐI, CLONE & ĐỔI CAMERA (FREE CAM / CLONE)
-- =====================================================================
stealthBtn.MouseButton1Click:Connect(function()
    stealthActive = not stealthActive
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not rootPart or not humanoid or not head then return end
    
    if stealthActive then
        stealthBtn.Text = "Bật Tàng Hình Tuyệt Đối: BẬT"
        stealthBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        switchCamBtn.Visible = true
        
        lastSafeCFrame = rootPart.CFrame
        
        -- Tạo Clone giả lập đặt trên trời cao (+18 mét) để đánh lừa thị giác người khác
        char.Archivable = true
        cloneModel = char:Clone()
        cloneModel.Name = "TrueStealthClone"
        
        for _, desc in pairs(cloneModel:GetDescendants()) do
            if desc:IsA("Script") or desc:IsA("LocalScript") then
                desc:Destroy()
            end
        end
        
        -- Tàng hình clone
        for _, v in pairs(cloneModel:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
                v.CanCollide = false
                v.Anchored = true
            elseif v:IsA("Decal") then
                v.Transparency = 1
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then handle.Transparency = 1 end
            end
        end
        cloneModel.Parent = workspace
        
        -- Ẩn hoàn toàn cơ thể gốc bằng cách dịch chuyển hitbox gốc xuống sâu dưới lòng đất (-500 mét)
        -- Giúp server và người khác hoàn toàn mất dấu, không thể load hay nhìn thấy nhân vật gốc
        rootPart.CFrame = rootPart.CFrame - Vector3.new(0, 500, 0)
        setCompletelyInvisible(char, true)
        
        -- Lắng nghe nếu có vũ khí mới trang bị -> tự động ẩn đi
        char.ChildAdded:Connect(function(child)
            if stealthActive and (child:IsA("Tool") or child:IsA("Model")) then
                task.wait(0.05)
                setCompletelyInvisible(child, true)
            end
        end)
        
        -- Mặc định khóa camera vào đầu của Clone ở trên trời
        cameraIsOnClone = true
        switchCamBtn.Text = "Đổi Camera: Đang ở CLONE"
        local cloneHead = cloneModel:FindFirstChild("Head")
        if cloneHead then
            camera.CameraSubject = cloneHead
        end
        
        -- Vòng lặp cập nhật vị trí Clone đồng bộ theo chuyển động ngầm của nhân vật gốc
        stealthConnection = RunService.RenderStepped:Connect(function()
            if char and rootPart and cloneModel then
                pcall(function()
                    local cloneRoot = cloneModel:FindFirstChild("HumanoidRootPart")
                    if cloneRoot then
                        -- Lấy tọa độ ngầm của cơ thể gốc + cộng thêm 18 mét để hiển thị Clone trên trời
                        local truePos = rootPart.CFrame + Vector3.new(0, 500, 0) -- Quy đổi ngược từ vị trí dưới đất lên
                        cloneRoot.CFrame = truePos + Vector3.new(0, 18, 0)
                        
                        for _, realPart in pairs(char:GetChildren()) do
                            if realPart:IsA("BasePart") then
                                local clonePart = cloneModel:FindFirstChild(realPart.Name)
                                if clonePart and realPart ~= rootPart then
                                    clonePart.CFrame = (realPart.CFrame + Vector3.new(0, 500, 0)) + Vector3.new(0, 18, 0)
                                end
                            end
                        end
                    end
                end)
            end
        end)
    else
        stealthBtn.Text = "Bật Tàng Hình Tuyệt Đối: TẮT"
        stealthBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        switchCamBtn.Visible = false
        
        if stealthConnection then
            stealthConnection:Disconnect()
            stealthConnection = nil
        end
        if cloneModel then
            cloneModel:Destroy()
            cloneModel = nil
        end
        
        if char then
            setCompletelyInvisible(char, false)
            if humanoid then camera.CameraSubject = humanoid end
        end
    end
end)

-- Nút bấm chuyển đổi camera linh hoạt giữa Clone và Cơ thể gốc (Free Cam)
switchCamBtn.MouseButton1Click:Connect(function()
    if not stealthActive or not cloneModel then return end
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local cloneHead = cloneModel:FindFirstChild("Head")
    
    cameraIsOnClone = not cameraIsOnClone
    if cameraIsOnClone then
        if cloneHead then
            camera.CameraSubject = cloneHead
            switchCamBtn.Text = "Đổi Camera: Đang ở CLONE"
        end
    else
        if humanoid then
            camera.CameraSubject = humanoid
            switchCamBtn.Text = "Đổi Camera: FREE CAM (Gốc)"
        end
    end
end)

-- =====================================================================
-- PHẦN 2: SMART ANTI-KB (CHỐNG KÉO GIẬT SỚM, CHỜ HẾT KB MỚI TP)
-- =====================================================================
antiKBBtn.MouseButton1Click:Connect(function()
    antiKBActive = not antiKBActive
    
    if antiKBActive then
        antiKBBtn.Text = "Bật Smart Anti-KB: BẬT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local char = player.Character
        if not char then return end
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not rootPart or not humanoid then return end
        
        lastSafeCFrame = rootPart.CFrame
        
        antiKBConnection = RunService.Heartbeat:Connect(function(dt)
            if not char or not rootPart or not humanoid then return end
            
            pcall(function()
                local velocity = rootPart.AssemblyLinearVelocity
                local floorMaterial = humanoid.FloorMaterial
                local currentTime = tick()
                
                -- Kiểm tra xem đang trong thời gian dính KB hay không
                if isCurrentlyKnockbacked then
                    if currentTime > kbEndTime then
                        -- Đã hết thời gian văng KB -> Cập nhật vị trí an toàn mới và giải phóng trạng thái
                        isCurrentlyKnockbacked = false
                        lastSafeCFrame = rootPart.CFrame
                    else
                        -- Vẫn đang trong thời gian văng KB -> Tạm thời thả lỏng để không bị kéo giật ngược về giữa chừng
                        return
                    end
                end
                
                -- Phân biệt nhảy chủ động và rơi tự do hợp pháp
                local isJumpingOrIntentional = (humanoid:GetState() == Enum.HumanoidStateType.Jumping) or 
                                               (humanoid:GetState() == Enum.HumanoidStateType.Freefall and velocity.Y > -15) or
                                               (floorMaterial ~= Enum.Material.Air)
                
                if isJumpingOrIntentional then
                    if floorMaterial ~= Enum.Material.Air and math.abs(velocity.Y) < 3 then
                        lastSafeCFrame = rootPart.CFrame
                    end
                else
                    -- Phát hiện bị dính KB mạnh hoặc rơi vực
                    local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
                    local isKnockbacked = (horizontalSpeed > 20) or (velocity.Y < -25)
                    
                    if isKnockbacked then
                        -- Kích hoạt trạng thái dính KB và định nghĩa thời gian chờ (0.8 giây để skill văng kết thúc hoàn toàn)
                        isCurrentlyKnockbacked = true
                        kbEndTime = currentTime + 0.8 
                        
                        -- Dịch chuyển an toàn về vị trí cũ trước khi bị văng
                        if lastSafeCFrame then
                            rootPart.CFrame = lastSafeCFrame
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                    else
                        if currentTime - lastCheckTick > 0.4 then
                            lastCheckTick = currentTime
                            if floorMaterial ~= Enum.Material.Air then
                                lastSafeCFrame = rootPart.CFrame
                            end
                        end
                    end
                end
                
                -- Triệt tiêu lực lạ gán vào từ skill địch
                for _, child in pairs(rootPart:GetChildren()) do
                    if child:IsA("BodyVelocity") or child:IsA("BodyPosition") or child:IsA("LinearVelocity") or child:IsA("VectorForce") then
                        child:Destroy()
                    end
                end
            end)
        end)
    else
        antiKBBtn.Text = "Bật Smart Anti-KB: TẮT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        
        if antiKBConnection then
            antiKBConnection:Disconnect()
            antiKBConnection = nil
        end
    end
end)

-- Nút Reset an toàn
resetBtn.MouseButton1Click:Connect(function()
    if stealthConnection then stealthConnection:Disconnect() end
    if antiKBConnection then antiKBConnection:Disconnect() end
    if cloneModel then cloneModel:Destroy() end
    local char = player.Character
    if char then
        setCompletelyInvisible(char, false)
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then camera.CameraSubject = humanoid end
    end
end)

