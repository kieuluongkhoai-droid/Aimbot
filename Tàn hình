-- Tab 2: Clone Logic
SpawnCloneBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    if activeClone then pcall(function() activeClone:Destroy() end) end
    
    character.Archivable = true
    activeClone = character:Clone()
    character.Archivable = false
    activeClone.Name = "FakeRespawnClone"
    activeClone.Parent = workspace
    activeClone:SetPrimaryPartCFrame(character.HumanoidRootPart.CFrame)
    
    InfoLabel.Text = "Status: Clone Dropped!"
end)

