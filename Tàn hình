-- Khởi tạo dịch vụ và biến môi trường
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

-- Xóa UI cũ nếu có
if CoreGui:FindFirstChild("UltimateGhostUI") then
    CoreGui.UltimateGhostUI:Destroy()
end

-- Tạo Giao Diện UI chính
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "UltimateGhostUI"
screenGui.Parent = CoreGui
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 220, 0, 160)
mainFrame.Position = UDim2.new(0.05, 0, 0.2, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = mainFrame

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 0, 35)
titleLabel.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
titleLabel.Text = "MENU BẤT TỬ BÓNG MA"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.TextSize = 12
titleLabel.Font = Enum.Font.GothamBold
titleLabel.Parent = mainFrame

local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 8)
titleCorner.Parent = titleLabel

-- Nút Thu Nhỏ / Mở Rộng (-)
local minBtn = Instance.new("TextButton")
minBtn.Size = UDim2.new(0, 30, 0, 30)
minBtn.Position = UDim2.new(1, -33, 0, 2)
minBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
minBtn.Text = "-"
minBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
minBtn.TextSize = 16
minBtn.Font = Enum.Font.GothamBold
minBtn.Parent = mainFrame

local function createButton(posY, defaultText)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = defaultText
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = mainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    return btn
end

local ghostModeBtn = createButton(45, "Bóng Ma Bất Tử: TẮT")
local resetBtn = createButton(95, "Khôi Phục / Reset")

local elementsToToggle = {ghostModeBtn, resetBtn}
local isMinimized = false

minBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        minBtn.Text = "+"
        mainFrame.Size = UDim2.new(0, 220, 0, 35)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = false
        end
    else
        minBtn.Text = "-"
        mainFrame.Size = UDim2.new(0, 220, 0, 160)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = true
        end
    end
end)

-- Biến quản lý trạng thái Bóng Ma
local ghostActive = false
local ghostConnection = nil

ghostModeBtn.MouseButton1Click:Connect(function()
    ghostActive = not ghostActive
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    if ghostActive then
        ghostModeBtn.Text = "Bóng Ma Bất Tử: BẬT"
        ghostModeBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        -- 1. Biến cơ thể thành khối tàng hình, vô hiệu hóa toàn bộ va chạm (CanCollide = false)
        -- Đối thủ đánh vào chỗ bạn sẽ xuyên qua như đánh vào không khí, không gây ra sát thương hay knockback
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
                v.CanCollide = false
            elseif v:IsA("Decal") then
                v.Transparency = 1
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then
                    handle.Transparency = 1
                    handle.CanCollide = false
                end
            end
        end
        
        -- 2. Giấu hitbox và dịch chuyển phần nhận sát thương cốt lõi lệch khỏi tầm quét chiêu thức của địch
        ghostConnection = RunService.RenderStepped:Connect(function()
            if char and rootPart then
                pcall(function()
                    -- Đẩy hitbox thật dịch xuống dưới một khoảng nhỏ (ví dụ -5 mét) 
                    -- Giúp bạn vẫn đứng trên mặt đất điều khiển bình thường nhưng vị trí nhận sát thương đã lệch khỏi chiêu của địch
                    rootPart.CFrame = rootPart.CFrame - Vector3.new(0, 5, 0)
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end)
            end
        end)
    else
        ghostModeBtn.Text = "Bóng Ma Bất Tử: TẮT"
        ghostModeBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        
        if ghostConnection then
            ghostConnection:Disconnect()
            ghostConnection = nil
        end
        
        -- Reset lại nhân vật
        player.Character:BreakJoints()
    end
end)

-- Nút Reset
resetBtn.MouseButton1Click:Connect(function()
    if player.Character then
        player.Character:BreakJoints()
    end
end)

print("Đã tải xong Script Bóng Ma Bất Tử tuyệt đỉnh!")
