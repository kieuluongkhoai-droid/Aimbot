-- Quét trục Y tầng hiện tại và tìm nơi ít lệch tầng nhất, không quá gần spawn để TP Real Body đến
ScanTpBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        InfoLabel.Text = "Status: Character not found!"
        return
    end
    
    local hrp = character.HumanoidRootPart
    local currentY = hrp.Position.Y
    InfoLabel.Text = "Status: Scanning Y-axis (Current Y: " .. math.floor(currentY) .. ")..."
    
    local spawnPos = Vector3.new(0, currentY, 0)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") then
            spawnPos = obj.Position
            break
        end
    end
    
    local bestPart = nil
    local minDiffY = math.huge
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Anchored and obj.Size.Magnitude > 4 and obj.Transparency < 1 then
            local pos = obj.Position
            local diffY = math.abs(pos.Y - currentY)
            local distToSpawn = (pos - spawnPos).Magnitude
            
            if diffY < 15 and diffY < minDiffY and distToSpawn > 30 then
                minDiffY = diffY
                bestPart = obj
            end
        end
    end
    
    if bestPart then
        hrp.CFrame = CFrame.new(bestPart.Position.X + 25, bestPart.Position.Y + 3, bestPart.Position.Z + 25)
        InfoLabel.Text = "Status: Real Body TP to safe Y-level match!"
    else
        hrp.CFrame = hrp.CFrame + Vector3.new(60, 0, 60)
        InfoLabel.Text = "Status: Real Body moved (Fallback offset)."
    end
end)

SpawnCloneBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        InfoLabel.Text = "Status: Character not found!"
        return
    end
    
    local spawnPos = CFrame.new(0, 10, 0)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") then
            spawnPos = obj.CFrame + Vector3.new(0, 3, 0)
            break
        end
    end
    
    if activeClone then pcall(function() activeClone:Destroy() end) activeClone = nil end
    
    character.Archivable = true
    activeClone = character:Clone()
    character.Archivable = false
    activeClone.Name = "MobileAICone"
    activeClone.Parent = workspace
    activeClone:SetPrimaryPartCFrame(spawnPos)
    
    InfoLabel.Text = "Status: Clone spawned at game spawn."
end)

-- Khóa Real Body và Kích hoạt AI đọc điều khiển từ Mobile (Bypass Anti-Cheat Kill)
RealLockBtn.MouseButton1Click:Connect(function()
    realLocked = not realLocked
    local character = LocalPlayer.Character
    
    if realLocked then
        RealLockBtn.Text = "🔒 Lock Real (AI Mirror Control): [ ON ]"
        RealLockBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
        InfoLabel.Text = "Status: Real Body locked safely. AI controlling Clone."
        
        -- Thay vì Anchor toàn bộ gây chết bởi Anti-cheat, sử dụng chế độ khóa vị trí an toàn qua vòng lặp bù tọa độ
        if _G.MobileAIConnection then _G.MobileAIConnection:Disconnect() end
        local lockedPos = character and character:FindFirstChild("HumanoidRootPart") and character.HumanoidRootPart.CFrame
        
        _G.MobileAIConnection = RunService.RenderStepped:Connect(function()
            if character and character:FindFirstChild("HumanoidRootPart") and lockedPos then
                if not realLocked then return end
                -- Giữ nguyên vị trí Real Body để chống anti-cheat kill do dịch chuyển bất thường
                character.HumanoidRootPart.CFrame = lockedPos
                character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            end
            
            if activeClone and activeClone:FindFirstChildOfClass("Humanoid") and activeClone:FindFirstChild("HumanoidRootPart") then
                local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
                local realHum = character and character:FindFirstChildOfClass("Humanoid")
                if realHum then
                    local moveDir = realHum.MoveDirection
                    if moveDir.Magnitude > 0 then
                        cloneHum:Move(moveDir, true)
                    end
                end
            end
        end)
    else
        RealLockBtn.Text = "🔒 Lock Real (AI Mirror Control): [ OFF ]"
        RealLockBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        InfoLabel.Text = "Status: Real Body unlocked. AI control stopped."
        if _G.MobileAIConnection then
            _G.MobileAIConnection:Disconnect()
            _G.MobileAIConnection = nil
        end
    end
end)

CloneLockBtn.MouseButton1Click:Connect(function()
    cloneLocked = not cloneLocked
    if activeClone then
        for _, part in ipairs(activeClone:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = cloneLocked
            end
        end
        if cloneLocked then
            CloneLockBtn.Text = "🔒 Lock Clone Movement: [ ON ]"
            CloneLockBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
            InfoLabel.Text = "Status: Clone movement locked."
        else
            CloneLockBtn.Text = "🔒 Lock Clone Movement: [ OFF ]"
            CloneLockBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
            InfoLabel.Text = "Status: Clone movement unlocked."
        end
    else
        InfoLabel.Text = "Status: No clone available!"
    end
end)

local function performSwap()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") or not activeClone or not activeClone:FindFirstChild("HumanoidRootPart") then
        InfoLabel.Text = "Status: Spawn clone and real body first!"
        return
    end
    
    local realHrp = character.HumanoidRootPart
    local cloneHrp = activeClone.HumanoidRootPart
    
    local tempCF = realHrp.CFrame
    realHrp.CFrame = cloneHrp.CFrame
    cloneHrp.CFrame = tempCF
    
    InfoLabel.Text = "Status: Positions swapped successfully!"
end

