InfoLabel.Parent = MainFrame

local activeClone = nil
local viewingClone = true
local realGravityOff = true -- Mặc định tắt trọng lực real body để chống rơi void

SpawnBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        InfoLabel.Text = "Status: Character not found!"
        return
    end
    
    local hrp = character.HumanoidRootPart
    local currentCF = hrp.CFrame
    
    if activeClone then
        pcall(function() activeClone:Destroy() end)
        activeClone = nil
    end
    
    -- Tạo Clone hiển thị trên mặt đất
    character.Archivable = true
    activeClone = character:Clone()
    character.Archivable = false
    activeClone.Name = "AI_Ultimate_Clone"
    activeClone.Parent = workspace
    activeClone:SetPrimaryPartCFrame(currentCF)
    
    local cloneHrp = activeClone:FindFirstChild("HumanoidRootPart")
    local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
    
    -- Tàng hình và vô hiệu hóa va chạm cơ thể thật
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Transparency = 1
        end
    end
    
    if cloneHum then Camera.CameraSubject = cloneHum end
    viewingClone = true
    SwitchCamBtn.Text = "👁️ View: [ CLONE PROXY ]"
    SwitchCamBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
    InfoLabel.Text = "Status: Clone active, Real body secured."
    
    if _G.UltimateProxyConnection then _G.UltimateProxyConnection:Disconnect() end
    
    -- Vòng lặp đồng bộ vị trí và kiểm soát trọng lực Real Body
    _G.UltimateProxyConnection = RunService.RenderStepped:Connect(function()
        if character and character.Parent and activeClone and cloneHum and hrp and cloneHrp then
            if realGravityOff then
                -- Nếu tắt trọng lực: Ghim chặt chân thật lơ lửng ngay dưới chân clone (cách 3 stud) và triệt tiêu vận tốc rơi
                hrp.CFrame = cloneHrp.CFrame - Vector3.new(0, 3, 0)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
            
            -- AI điều khiển Clone di chuyển tìm mục tiêu
            local targetHrp = nil
            local minDist = math.huge
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (plr.Character.HumanoidRootPart.Position - cloneHrp.Position).Magnitude
                    if d < minDist then
                        minDist = d
                        targetHrp = plr.Character.HumanoidRootPart
                    end
                end
            end
            if targetHrp then
                cloneHum:MoveTo(targetHrp.Position)
            end
        end
    end)
end)

-- Nút riêng biệt bật/tắt trọng lực Real Body
GravityBtn.MouseButton1Click:Connect(function()
    realGravityOff = not realGravityOff
    if realGravityOff then
        GravityBtn.Text = "🪂 Real Body Gravity: [ OFF ]"
        GravityBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        InfoLabel.Text = "Status: Real body gravity OFF (Floating safe)."
    else
        GravityBtn.Text = "🪂 Real Body Gravity: [ ON ]"
        GravityBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        InfoLabel.Text = "Status: Real body gravity ON (Normal physics)."
    end
end)

SwitchCamBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not activeClone then
        InfoLabel.Text = "Status: Spawn clone first!"
        return
    end
    
    viewingClone = not viewingClone
    local realHum = character:FindFirstChildOfClass("Humanoid")
    local cloneHum = activeClone:FindFirstChildOfClass("Humanoid")
    
    if viewingClone then
        if cloneHum then Camera.CameraSubject = cloneHum end
        SwitchCamBtn.Text = "👁️ View: [ CLONE PROXY ]"
        SwitchCamBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        InfoLabel.Text = "Status: Watching Clone Proxy"
    else
        if realHum then Camera.CameraSubject = realHum end
        SwitchCamBtn.Text = "👁️ View: [ REAL BODY ]"
        SwitchCamBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        InfoLabel.Text = "Status: Watching Real Body"
    end
end)

ResetBtn.MouseButton1Click:Connect(function()
    if _G.UltimateProxyConnection then
        _G.UltimateProxyConnection:Disconnect()
        _G.UltimateProxyConnection = nil
    end
    if activeClone then
        pcall(function() activeClone:Destroy() end)
        activeClone = nil
    end
    
    local character = LocalPlayer.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 5, 0)
        end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
                part.Transparency = 0
            end
        end
        local realHum = character:FindFirstChildOfClass("Humanoid")
        if realHum then Camera.CameraSubject = realHum end
    end
    
    viewingClone = false
    realGravityOff = false
    GravityBtn.Text = "🪂 Real Body Gravity: [ ON ]"
    SwitchCamBtn.Text = "👁️ View: [ REAL BODY ]"
    InfoLabel.Text = "Status: Reset completed."
end)
