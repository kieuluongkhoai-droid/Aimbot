toggleCamBtn.Visible = false

-- Biến trạng thái
local ghostActive = false
local antiKBActive = false
local cameraIsOnClone = true

local cloneModel = nil
local ghostConnection = nil
local antiKBConnection = nil

local lastSafeCFrame = nil
local lastCheckTick = 0

-- Hàm tàng hình toàn bộ đối tượng (bao gồm cả nhân vật, đồ trên tay, tool, phụ kiện)
local function setModelInvisible(targetModel, transparencyValue)
    if not targetModel then return end
    for _, v in pairs(targetModel:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Transparency = transparencyValue
            if transparencyValue == 1 then
                v.CanCollide = false
            end
        elseif v:IsA("Decal") then
            v.Transparency = transparencyValue
        elseif v:IsA("Accessory") then
            local handle = v:FindFirstChild("Handle")
            if handle then handle.Transparency = transparencyValue end
        end
    end
end

-- =====================================================================
-- PHẦN 1: TÀNG HÌNH, SKY CLONE & CHUYỂN ĐỔI CAMERA (BÓNG MA)
-- =====================================================================
ghostBtn.MouseButton1Click:Connect(function()
    ghostActive = not ghostActive
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not rootPart or not humanoid or not head then return end
    
    if ghostActive then
        ghostBtn.Text = "Bật Tàng Hình & Clone: BẬT"
        ghostBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        toggleCamBtn.Visible = true
        
        lastSafeCFrame = rootPart.CFrame
        
        -- Tạo bản sao giả lập (Clone) ở trên trời cao (+15 mét)
        char.Archivable = true
        cloneModel = char:Clone()
        cloneModel.Name = "SkyVisualClone"
        
        for _, desc in pairs(cloneModel:GetDescendants()) do
            if desc:IsA("Script") or desc:IsA("LocalScript") then
                desc:Destroy()
            end
        end
        
        -- Tàng hình toàn bộ Clone đối với người khác
        setModelInvisible(cloneModel, 1)
        for _, part in pairs(cloneModel:GetDescendants()) do
            if part:IsA("BasePart") then part.Anchored = true end
        end
        cloneModel.Parent = workspace
        
        -- Tàng hình toàn bộ nhân vật gốc (kể cả tool/vũ khí đang cầm trên tay)
        setModelInvisible(char, 1)
        
        -- Lắng nghe khi người chơi cầm vũ khí mới lên tay -> tự động tàng hình luôn vũ khí đó
        char.ChildAdded:Connect(function(child)
            if ghostActive and (child:IsA("Tool") or child:IsA("Model")) then
                task.wait(0.05)
                setModelInvisible(child, 1)
            end
        end)
        
        -- Khóa camera ban đầu vào đầu của Clone
        cameraIsOnClone = true
        toggleCamBtn.Text = "Đổi Camera: Đang ở CLONE"
        local cloneHead = cloneModel:FindFirstChild("Head")
        if cloneHead then
            camera.CameraSubject = cloneHead
        end
        
        -- Vòng lặp đồng bộ vị trí Clone trên trời khớp với nhân vật gốc dưới đất
        ghostConnection = RunService.RenderStepped:Connect(function()
            if char and rootPart and cloneModel then
                pcall(function()
                    local cloneRoot = cloneModel:FindFirstChild("HumanoidRootPart")
                    if cloneRoot then
                        cloneRoot.CFrame = rootPart.CFrame + Vector3.new(0, 15, 0)
                        
                        for _, realPart in pairs(char:GetChildren()) do
                            if realPart:IsA("BasePart") then
                                local clonePart = cloneModel:FindFirstChild(realPart.Name)
                                if clonePart and realPart ~= rootPart then
                                    clonePart.CFrame = realPart.CFrame + Vector3.new(0, 15, 0)
                                end
                            end
                        end
                    end
                    
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
            end
        end)
    else
        ghostBtn.Text = "Bật Tàng Hình & Clone: TẮT"
        ghostBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        toggleCamBtn.Visible = false
        
        if ghostConnection then
            ghostConnection:Disconnect()
            ghostConnection = nil
        end
        if cloneModel then
            cloneModel:Destroy()
            cloneModel = nil
        end
        
        -- Khôi phục hiện hình nhân vật và camera an toàn (Không gây chết)
        if char then
            setModelInvisible(char, 0)
            if humanoid then
                camera.CameraSubject = humanoid
            end
        end
    end
end)

-- Nút bấm chuyển đổi camera linh hoạt giữa Clone và Cơ thể gốc (Bóng ma)
toggleCamBtn.MouseButton1Click:Connect(function()
    if not ghostActive or not cloneModel then return end
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local cloneHead = cloneModel:FindFirstChild("Head")
    
    cameraIsOnClone = not cameraIsOnClone
    if cameraIsOnClone then
        if cloneHead then
            camera.CameraSubject = cloneHead
            toggleCamBtn.Text = "Đổi Camera: Đang ở CLONE"
        end
    else
        if humanoid then
            camera.CameraSubject = humanoid
            toggleCamBtn.Text = "Đổi Camera: GỐC (Bóng ma)"
        end
    end
end)

-- =====================================================================
-- PHẦN 2: POWERFUL ANTI-KB (BẮT GỌN TỪ KB NHẸ ĐẾN KB RẤT MẠNH)
-- =====================================================================
antiKBBtn.MouseButton1Click:Connect(function()
    antiKBActive = not antiKBActive
    
    if antiKBActive then
        antiKBBtn.Text = "Bật Powerful Anti-KB: BẬT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local char = player.Character
        if not char then return end
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not rootPart or not humanoid then return end
        
        lastSafeCFrame = rootPart.CFrame
        
        antiKBConnection = RunService.Heartbeat:Connect(function(dt)
            if not char or not rootPart or not humanoid then return end
            
            pcall(function()
                local velocity = rootPart.AssemblyLinearVelocity
                local floorMaterial = humanoid.FloorMaterial
                
                -- Phân biệt nhảy chủ động và trạng thái rơi tự do hợp pháp
                local isJumpingOrIntentional = (humanoid:GetState() == Enum.HumanoidStateType.Jumping) or 
                                               (humanoid:GetState() == Enum.HumanoidStateType.Freefall and velocity.Y > -12) or
                                               (floorMaterial ~= Enum.Material.Air)
                
                if isJumpingOrIntentional then
                    if floorMaterial ~= Enum.Material.Air and math.abs(velocity.Y) < 3 then
                        lastSafeCFrame = rootPart.CFrame
                    end
                else
                    -- POWERFUL THRESHOLD: Bắt gọn cả KB nhẹ, đẩy lùi vừa và các cú văng cực mạnh
                    local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
                    local isKnockbacked = (horizontalSpeed > 12) or (velocity.Y < -20) or (math.abs(velocity.X) > 12) or (math.abs(velocity.Z) > 12)
                    
                    if isKnockbacked then
                        -- Ngay lập tức kéo giật ngược về vị trí an toàn trước đó, triệt tiêu hoàn toàn việc bị văng ra vực hoặc bay xa
                        if lastSafeCFrame then
                            rootPart.CFrame = lastSafeCFrame
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                    else
                        if tick() - lastCheckTick > 0.25 then
                            lastCheckTick = tick()
                            if floorMaterial ~= Enum.Material.Air then
                                lastSafeCFrame = rootPart.CFrame
                            end
                        end
                    end
                end
                
                -- Xóa triệt để các hiệu ứng lực văng do skill của đối thủ gán vào
                for _, child in pairs(rootPart:GetChildren()) do
                    if child:IsA("BodyVelocity") or child:IsA("BodyPosition") or child:IsA("LinearVelocity") or child:IsA("VectorForce") then
                        child:Destroy()
                    end
                end
            end)
        end)
    else
        antiKBBtn.Text = "Bật Powerful Anti-KB: TẮT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        
        if antiKBConnection then
            antiKBConnection:Disconnect()
            antiKBConnection = nil
        end
    end
end)

-- Nút Reset an toàn (Không làm kẹt game hay chết lỗi)
resetBtn.MouseButton1Click:Connect(function()
    if ghostConnection then ghostConnection:Disconnect() end
    if antiKBConnection then antiKBConnection:Disconnect() end
    if cloneModel then cloneModel:Destroy() end
    local char = player.Character
    if char then
        setModelInvisible(char, 0)
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then camera.CameraSubject = humanoid end
    end
end)

