local UICornerBtn = Instance.new("UICorner")
UICornerBtn.CornerRadius = UDim.new(0, 8)
UICornerBtn.Parent = SwapBtn

-- Logic thu nhỏ UI
local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        MinimizeBtn.Text = "+"
        SwapBtn.Visible = false
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 220, 0, 35)}):Play()
    else
        MinimizeBtn.Text = "-"
        SwapBtn.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Size = UDim2.new(0, 220, 0, 95)}):Play()
    end
end)

-- Biến lưu trữ trạng thái
local cloneChar = nil
local isControllingClone = false

-- Hàm khởi tạo Clone tại vị trí ban đầu của nhân vật
local function initializeClone()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    if not cloneChar or not cloneChar.Parent then
        character.Archivable = true
        cloneChar = character:Clone()
        character.Archivable = false
        
        for _, v in ipairs(cloneChar:GetDescendants()) do
            if v:IsA("LocalScript") or v:IsA("Script") then v:Destroy() end
        end
        cloneChar.Name = "PreciseSoulClone"
        cloneChar.Parent = workspace
        cloneChar:SetPrimaryPartCFrame(character.HumanoidRootPart.CFrame)
    end
end

-- Xử lý nút bấm hoán đổi vị trí và quyền điều khiển
SwapBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    initializeClone()
    
    local realHrp = character.HumanoidRootPart
    local cloneHrp = cloneChar:FindFirstChild("HumanoidRootPart")
    
    if cloneHrp then
        local realCF = realHrp.CFrame
        local cloneCF = cloneHrp.CFrame
        
        if not isControllingClone then
            -- Bấm lần 1: Đưa nhân vật gốc đến chỗ Clone, đồng thời đưa Clone đến chỗ nhân vật gốc cũ
            realHrp.CFrame = cloneCF
            cloneHrp.CFrame = realCF
            
            -- Chuyển Camera sang nhìn Clone (đang đứng ở vị trí nhân vật gốc cũ)
            if cloneChar:FindFirstChild("Humanoid") then
                Camera.CameraSubject = cloneChar.Humanoid
            end
            
            isControllingClone = true
            SwapBtn.Text = "👻 Control: Clone"
            SwapBtn.TextColor3 = Color3.fromRGB(255, 150, 0)
        else
            -- Bấm lần 2: Nhập hồn về nhân vật gốc, nhân vật gốc di chuyển đến chỗ Clone hiện tại, Clone về lại chỗ cũ
            realHrp.CFrame = cloneCF
            cloneHrp.CFrame = realCF
            
            -- Chuyển Camera về lại nhân vật gốc
            if character:FindFirstChild("Humanoid") then
                Camera.CameraSubject = character.Humanoid
            end
            
            isControllingClone = false
            SwapBtn.Text = "👻 Control: Original Body"
            SwapBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        end
    end
end)

-- Reset khi nhân vật chết hoặc hồi sinh
LocalPlayer.CharacterAdded:Connect(function(newChar)
    if cloneChar then
        cloneChar:Destroy()
        cloneChar = nil
    end
    isControllingClone = false
    SwapBtn.Text = "👻 Control: Original Body"
    SwapBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
end)
