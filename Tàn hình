titleCorner.Parent = titleLabel

-- Nút Thu Nhỏ / Mở Rộng (-)
local minBtn = Instance.new("TextButton")
minBtn.Size = UDim2.new(0, 30, 0, 30)
minBtn.Position = UDim2.new(1, -33, 0, 2)
minBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
minBtn.Text = "-"
minBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
minBtn.TextSize = 16
minBtn.Font = Enum.Font.GothamBold
minBtn.Parent = mainFrame

local function createButton(posY, defaultText)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = defaultText
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = mainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    return btn
end

local antiKBBtn = createButton(45, "Anti-KB & Ghost: TẮT")
local resetBtn = createButton(95, "Khôi Phục / Reset")

local elementsToToggle = {antiKBBtn, resetBtn}
local isMinimized = false

minBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        minBtn.Text = "+"
        mainFrame.Size = UDim2.new(0, 220, 0, 35)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = false
        end
    else
        minBtn.Text = "-"
        mainFrame.Size = UDim2.new(0, 220, 0, 160)
        for _, elem in ipairs(elementsToToggle) do
            elem.Visible = true
        end
    end
end)

local active = false
local cloneModel = nil
local connection = nil

antiKBBtn.MouseButton1Click:Connect(function()
    active = not active
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not rootPart or not humanoid then return end
    
    if active then
        antiKBBtn.Text = "Anti-KB & Ghost: BẬT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        -- 1. Tạo bản sao hình ảnh giả lập ngay dưới đất để lừa mắt địch
        char.Archivable = true
        cloneModel = char:Clone()
        cloneModel.Name = "AntiKBFakeClone"
        
        for _, scriptChild in pairs(cloneModel:GetDescendants()) do
            if scriptChild:IsA("Script") or scriptChild:IsA("LocalScript") then
                scriptChild:Destroy()
            end
        end
        
        for _, v in pairs(cloneModel:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
                v.CanCollide = false
                v.Anchored = true
            elseif v:IsA("Decal") then
                v.Transparency = 1
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then handle.Transparency = 1 end
            end
        end
        cloneModel.Parent = workspace
        
        -- 2. Tàng hình nhân vật thật
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
            elseif v:IsA("Decal") then
                v.Transparency = 1
            end
        end
        
        -- 3. Vòng lặp khóa chặt lực vật lý để triệt tiêu hoàn toàn Knockback và ghim vị trí an toàn
        connection = RunService.Stepped:Connect(function()
            if char and rootPart and cloneModel then
                pcall(function()
                    -- Đồng bộ vị trí bản sao dưới đất theo hướng nhìn/di chuyển của bạn
                    local cloneRoot = cloneModel:FindFirstChild("HumanoidRootPart")
                    if cloneRoot then
                        cloneRoot.CFrame = rootPart.CFrame - Vector3.new(0, 6, 0)
                    end
                    
                    -- TRIỆT TIÊU HOÀN TOÀN KHỐI LƯỢNG VÀ LỰC TÁC ĐỘNG (Chặn đứng Knockback)
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    
                    -- Xóa bỏ các thể loại lực lạ do skill địch gán vào người (như BodyVelocity, LinearVelocity bay người)
                    for _, child in pairs(rootPart:GetChildren()) do
                        if child:IsA("BodyVelocity") or child:IsA("BodyPosition") or child:IsA("LinearVelocity") or child:IsA("VectorForce") then
                            child:Destroy()
                        end
                    end
                end)
            end
        end)
    else
        antiKBBtn.Text = "Anti-KB & Ghost: TẮT"
        antiKBBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        
        if connection then
            connection:Disconnect()
            connection = nil
        end
        
        if cloneModel then
            cloneModel:Destroy()
            cloneModel = nil
        end
        
        player.Character:BreakJoints()
    end
end)

-- Nút Reset
resetBtn.MouseButton1Click:Connect(function()
    if cloneModel then cloneModel:Destroy() end
    if player.Character then
        player.Character:BreakJoints()
    end
end)

print("Đã tải xong Script Anti-Knockback tối ưu!")
