-- Biến trạng thái
local cloneChar = nil
local safePlatform = nil
local isModeActive = false
local currentViewIsClone = true

-- Tạo sàn giả lập chuẩn xác giúp Server tưởng nhân vật đang đứng vững dưới đất
local function createSafePlatform(cf)
    if safePlatform then safePlatform:Destroy() end
    
    safePlatform = Instance.new("Part")
    safePlatform.Name = "KingTowerAntiCheatPlatform"
    safePlatform.Size = Vector3.new(12, 1.2, 12)
    safePlatform.CFrame = cf - Vector3.new(0, 3.2, 0) -- Nằm ngay dưới chân
    safePlatform.Anchored = true
    safePlatform.CanCollide = true
    safePlatform.Transparency = 1 -- Hoàn toàn vô hình để đánh lừa mắt thường và server
    safePlatform.Parent = workspace
end

local function removeSafePlatform()
    if safePlatform then
        safePlatform:Destroy()
        safePlatform = nil
    end
end

-- Giấu Clone và vô hiệu hóa hitbox để không bị dính đòn
local function setCloneStealth(model, hide)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = hide and 1 or 0
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
        elseif part:IsA("Decal") then
            part.Transparency = hide and 1 or 0
        end
    end
end

-- Khởi tạo Clone tại chỗ và tạo sàn
local function initializeClone()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local startCF = character.HumanoidRootPart.CFrame
    
    -- Tạo sàn chống rơi ngay tại chỗ đứng ban đầu
    createSafePlatform(startCF)
    
    if not cloneChar or not cloneChar.Parent then
        character.Archivable = true
        cloneChar = character:Clone()
        character.Archivable = false
        
        for _, v in ipairs(cloneChar:GetDescendants()) do
            if v:IsA("LocalScript") or v:IsA("Script") then v:Destroy() end
        end
        cloneChar.Name = "PerfectStealthClone"
        cloneChar.Parent = workspace
        cloneChar:SetPrimaryPartCFrame(startCF)
        
        setCloneStealth(cloneChar, true)
    end
end

-- Nút 1: Bật/Tắt chế độ
ToggleBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local realHrp = character.HumanoidRootPart

    if not isModeActive then
        initializeClone()
        local cloneHrp = cloneChar:FindFirstChild("HumanoidRootPart")
        if cloneHrp then
            local currentCF = realHrp.CFrame
            
            -- Đưa hitbox gốc lên trời cao 3000m để bất tử tuyệt đối
            realHrp.CFrame = currentCF + Vector3.new(0, 3000, 0)
            
            -- Đặt Clone đúng vào vị trí cũ ngay trên sàn an toàn
            cloneHrp.CFrame = currentCF
            
            -- Giấu hẳn nhân vật gốc đi
            for _, p in ipairs(character:GetDescendants()) do
                if p:IsA("BasePart") then p.Transparency = 1 end
            end
            
            -- Lập tức đổi góc nhìn Camera vào Clone để bạn điều khiển di chuyển ngay
            if cloneChar:FindFirstChild("Humanoid") then
                Camera.CameraSubject = cloneChar.Humanoid
            end
            
            isModeActive = true
            currentViewIsClone = true
            ToggleBtn.Text = "🛡️ Mode: ON (Protected)"
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
            CamBtn.Text = "👁️ View: Clone"
            InfoLabel.Text = "Status: Platform Active | Safe"
        end
    else
        local cloneHrp = cloneChar and cloneChar:FindFirstChild("HumanoidRootPart")
        if cloneHrp then
            realHrp.CFrame = cloneHrp.CFrame
        end
        
        removeSafePlatform()
        if cloneChar then
            cloneChar:Destroy()
            cloneChar = nil
        end
        
        -- Hiện lại nhân vật gốc
        for _, p in ipairs(character:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.Transparency = 0 end
        end
        
        if character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = character.Humanoid
        end
        
        isModeActive = false
        ToggleBtn.Text = "🛡️ Mode: OFF (Normal)"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        CamBtn.Text = "👁️ View: Normal"
        InfoLabel.Text = "Status: Normal Mode"
    end
end)

-- Nút 2: Đổi góc nhìn Camera linh hoạt giữa Clone và Nhân vật thật
CamBtn.MouseButton1Click:Connect(function()
    if not isModeActive then return end
    local character = LocalPlayer.Character
    if not character then return end
    
    currentViewIsClone = not currentViewIsClone
    
    if currentViewIsClone then
        if cloneChar and cloneChar:FindFirstChild("Humanoid") then
            Camera.CameraSubject = cloneChar.Humanoid
            CamBtn.Text = "👁️ View: Clone"
            InfoLabel.Text = "Camera on Clone"
        end
    else
        if character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = character.Humanoid
            CamBtn.Text = "👁️ View: Real Body"
            InfoLabel.Text = "Camera on Real Body (Sky)"
        end
    end
end)

-- Nút 3: Hoán đổi vị trí giữa nhân vật thật và Clone
SwapBtn.MouseButton1Click:Connect(function()
    if not isModeActive or not cloneChar then return end
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local realHrp = character.HumanoidRootPart
    local cloneHrp = cloneChar:FindFirstChild("HumanoidRootPart")
    
    if cloneHrp then
        local realCF = realHrp.CFrame
        local cloneCF = cloneHrp.CFrame
        
        -- Hoán đổi tọa độ
        realHrp.CFrame = cloneCF
        cloneHrp.CFrame = realCF
        
        -- Cập nhật lại vị trí tấm sàn tàng hình theo chỗ đứng mới của Clone
        if safePlatform then
            safePlatform.CFrame = cloneHrp.CFrame - Vector3.new(0, 3.2, 0)
        end
        
        InfoLabel.Text = "Positions Swapped & Platform Updated!"
    end
end)

