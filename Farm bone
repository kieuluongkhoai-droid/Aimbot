-- // Logic Bật/Tắt Chức năng 4 (Giảm Lag)
BtnLag.MouseButton1Click:Connect(function()
    getgenv().LagReductionEnabled = not getgenv().LagReductionEnabled
    if getgenv().LagReductionEnabled then
        BtnLag.Text = "Giảm Lag (FPS): BẬT"
        BtnLag.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        -- Thực hiện tối ưu hóa đồ họa
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Atmosphere") then
                    v.Enabled = false
                end
            end
            for _, part in ipairs(Workspace:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Material = Enum.Material.SmoothPlastic
                    part.Reflectance = 0
                elseif part:IsA("Decal") or part:IsA("Texture") then
                    part.Transparency = 1
                end
            end
        end)
    else
        BtnLag.Text = "Giảm Lag (FPS): TẮT"
        BtnLag.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        pcall(function()
            Lighting.GlobalShadows = true
        end)
    end
end)

local function getRootPart()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- // Luồng 1: Teleport nhân vật đến vị trí Bonds
task.spawn(function()
    while true do
        task.wait(0.2)
        if getgenv().AutoTeleportToBonds then
            pcall(function()
                local rootPart = getRootPart()
                if not rootPart then return end
                
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if not getgenv().AutoTeleportToBonds then break end
                    
                    local nameLower = string.lower(obj.Name)
                    if string.find(nameLower, "treasury") or string.find(nameLower, "bonds") then
                        local targetPart = nil
                        if obj:IsA("Model") then
                            targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                        elseif obj:IsA("BasePart") then
                            targetPart = obj
                        end
                        
                        if targetPart then
                            rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 2, 0)
                            
                            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if prompt then
                                pcall(function() fireproximityprompt(prompt) end)
                            end
                            
                            task.wait(0.15)
                        end
                    end
                end
            end)
        end
    end
end)

