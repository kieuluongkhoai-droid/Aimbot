-- =================================================================
-- XỬ LÝ LOGIC CHÍNH
-- =================================================================
local function setupCharacter(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)

    -- 1. Nếu đã bật tính năng, thực hiện đè CFrame ngay khung hình đầu tiên khi hồi sinh
    if autoRespawnActive and lastDeathCFrame and hrp then
        local connection
        local startTime = tick()
        connection = RunService.Heartbeat:Connect(function()
            if hrp and hrp.Parent then
                hrp.CFrame = lastDeathCFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
            if tick() - startTime > 0.5 then
                connection:Disconnect()
                InfoLabel.Text = "Trạng thái: Đã hồi sinh tại chỗ chết thành công!"
            end
        end)
    end

    -- 2. Theo dõi nhân vật để ghi lại tọa độ ngay trước khi chết
    if humanoid and hrp then
        -- Liên tục cập nhật tọa độ an toàn khi nhân vật đang sống
        local trackConn
        trackConn = RunService.Heartbeat:Connect(function()
            if humanoid.Health > 0 and hrp and hrp.Parent then
                lastDeathCFrame = hrp.CFrame
            else
                if trackConn then trackConn:Disconnect() end
            end
        end)

        -- Theo dõi máu thấp để Auto-Escape
        humanoid.HealthChanged:Connect(function(health)
            if autoEscapeActive and health > 0 and health < (humanoid.MaxHealth * 0.25) then
                humanoid.Health = 0
                InfoLabel.Text = "Trạng thái: Máu yếu! Đang tự sát để né giao tranh..."
            end
        end)

        humanoid.Died:Connect(function()
            if hrp and hrp.Parent then
                lastDeathCFrame = hrp.CFrame
                InfoLabel.Text = "Trạng thái: Đã lưu vị trí chết!"
            end
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(setupCharacter)
if LocalPlayer.Character then
    setupCharacter(LocalPlayer.Character)
end

-- UI Button Events
ToggleRespawnBtn.MouseButton1Click:Connect(function()
    autoRespawnActive = not autoRespawnActive
    if autoRespawnActive then
        ToggleRespawnBtn.Text = "⚙️ 1. Hồi sinh tại chỗ chết: [ ON ]"
        ToggleRespawnBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        InfoLabel.Text = "Trạng thái: Đã bật tự động hồi sinh tại chỗ chết."
    else
        ToggleRespawnBtn.Text = "⚙️ 1. Hồi sinh tại chỗ chết: [ OFF ]"
        ToggleRespawnBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        InfoLabel.Text = "Trạng thái: Đã tắt."
    end
end)

ToggleEscapeBtn.MouseButton1Click:Connect(function()
    autoEscapeActive = not autoEscapeActive
    if autoEscapeActive then
        ToggleEscapeBtn.Text = "⚡ 2. Auto-Escape khi sắp chết (<25% HP): [ ON ]"
        ToggleEscapeBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        InfoLabel.Text = "Trạng thái: Sẽ tự động tự sát khi máu < 25%."
    else
        ToggleEscapeBtn.Text = "⚡ 2. Auto-Escape khi sắp chết (<25% HP): [ OFF ]"
        ToggleEscapeBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        InfoLabel.Text = "Trạng thái: Đã tắt Auto-Escape."
    end
end)

SuicideBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        char:FindFirstChildOfClass("Humanoid").Health = 0
        InfoLabel.Text = "Trạng thái: Đang tự sát..."
    end
end)
