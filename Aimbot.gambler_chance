----------------------------------------------------------------
-- 4. AIMBOT (NORMAL = KHÓA THÂN | HARD = KHÓA CAMERA + THÂN) & ESP
----------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if AimbotEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local closest, dist = nil, FOVRadius
        local mousePos = UserInputService:GetMouseLocation()
        local myHrp = LocalPlayer.Character.HumanoidRootPart
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("HumanoidRootPart") then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local pos, on = Camera:WorldToViewportPoint(p.Character.Head.Position)
                    if on then
                        local d = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                        if d < dist then 
                            closest = p.Character 
                            dist = d 
                        end
                    end
                end
            end
        end
        
        if closest and closest:FindFirstChild("HumanoidRootPart") and closest:FindFirstChild("Head") then
            local targetHrp = closest.HumanoidRootPart
            local targetHead = closest.Head
            
            if AimMode == "Normal" then
                -- Normal: Chỉ khóa Cơ thể (HumanoidRootPart) hướng vào mục tiêu, Camera tự do
                local lookAtPos = Vector3.new(targetHrp.Position.X, myHrp.Position.Y, targetHrp.Position.Z)
                myHrp.CFrame = CFrame.new(myHrp.Position, lookAtPos)
            elseif AimMode == "Hard" then
                -- Hard: Khóa cả Camera lẫn Cơ thể hướng vào mục tiêu
                local lookAtPos = Vector3.new(targetHrp.Position.X, myHrp.Position.Y, targetHrp.Position.Z)
                myHrp.CFrame = CFrame.new(myHrp.Position, lookAtPos)
                
                local camTargetCF = CFrame.new(Camera.CFrame.Position, targetHead.Position)
                Camera.CFrame = Camera.CFrame:Lerp(camTargetCF, 0.3)
            end
        end
    end
    
    -- ESP Text Loop
    if ESPEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local char = p.Character
                local head = char:FindFirstChild("Head")
                local hum = char:FindFirstChildOfClass("Humanoid")
                
                if head and hum and hum.Health > 0 then
                    local bGui = head:FindFirstChild("MEB_ESP")
                    if not bGui then
                        bGui = Instance.new("BillboardGui", head)
                        bGui.Name = "MEB_ESP"
                        bGui.AlwaysOnTop = true
                        bGui.Size = UDim2.new(0, 120, 0, 50)
                        bGui.StudsOffset = Vector3.new(0, 2.2, 0)
                        
                        local t = Instance.new("TextLabel", bGui)
                        t.Name = "Text"
                        t.Size = UDim2.new(1,0,1,0)
                        t.BackgroundTransparency = 1
                        t.TextStrokeTransparency = 0.2
                        t.Font = Enum.Font.GothamBold
                        t.TextSize = 11
                    end
                    
                    local hp = math.floor(hum.Health)
                    local maxHp = math.floor(hum.MaxHealth)
                    bGui.Text.Text = string.format("%s\nHP: %d/%d", p.Name, hp, maxHp)
                    bGui.Text.TextColor3 = (hp > (maxHp / 2)) and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 80, 80)
                    bGui.Enabled = true
                else
                    if head and head:FindFirstChild("MEB_ESP") then
                        head.MEB_ESP.Enabled = false
                    end
                end
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("MEB_ESP") then
                p.Character.Head.MEB_ESP.Enabled = false
            end
        end
    end
end)

