--------------------------------------------------------------------------------
-- 2. HỆ THỐNG ESP DYNAMIC (TỰ ĐỘNG CẬP NHẬT KHI CÓ NGƯỜI MỚI VÀO SERVER)
--------------------------------------------------------------------------------
local espCache = {}

local function removeESP(player)
    if espCache[player] then
        if espCache[player].Box then espCache[player].Box:Remove() end
        if espCache[player].Info then espCache[player].Info:Remove() end
        espCache[player] = nil
    end
end

local function createESP(player)
    if player == LocalPlayer then return end
    removeESP(player)
    
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = getgenv().EMBSettings.BoxColor
    box.Thickness = 1.5
    box.Filled = false

    local infoText = Drawing.new("Text")
    infoText.Visible = false
    infoText.Color = getgenv().EMBSettings.TextColor
    infoText.Size = 13
    infoText.Center = true
    infoText.Outline = true

    espCache[player] = {Box = box, Info = infoText}

    -- Xử lý khi người chơi chết hoặc reset nhân vật
    player.CharacterRemoving:Connect(function()
        if espCache[player] then
            espCache[player].Box.Visible = false
            espCache[player].Info.Visible = false
        end
    end)
end

-- Khởi tạo cho người chơi hiện tại
for _, p in ipairs(Players:GetPlayers()) do 
    createESP(p) 
end

-- Lắng nghe sự kiện người chơi mới gia nhập server
Players.PlayerAdded:Connect(function(player)
    createESP(player)
end)

-- Lắng nghe sự kiện người chơi rời khỏi server để dọn dẹp bộ nhớ
Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
end)

-- Vòng lặp hiển thị ESP mượt mà
RunService.RenderStepped:Connect(function()
    for player, elements in pairs(espCache) do
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if getgenv().EMBSettings.ESPEnabled and character and rootPart and humanoid and humanoid.Health > 0 then
            local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
            
            if onScreen then
                local head = character:FindFirstChild("Head")
                local topPosition = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
                local bottomPosition = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
                
                local boxHeight = math.abs(topPosition.Y - bottomPosition.Y)
                local boxWidth = boxHeight / 2
                
                -- Cập nhật Box ESP
                elements.Box.Size = Vector2.new(boxWidth, boxHeight)
                elements.Box.Position = Vector2.new(vector.X - boxWidth / 2, topPosition.Y)
                elements.Box.Visible = true
                
                -- Tính toán khoảng cách và máu
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local distance = myRoot and math.floor((rootPart.Position - myRoot.Position).Magnitude) or 0
                local health = math.floor(humanoid.Health)
                local maxHealth = math.floor(humanoid.MaxHealth)
                
                elements.Info.Text = string.format("%s [%d/%dHP] (%dm)", player.Name, health, maxHealth, math.floor(distance / 3.5))
                elements.Info.Position = Vector2.new(vector.X, topPosition.Y - 18)
                elements.Info.Visible = true
            else
                elements.Box.Visible = false
                elements.Info.Visible = false
            end
        else
            if elements.Box then elements.Box.Visible = false end
            if elements.Info then elements.Info.Visible = false end
        end
    end
end)

--------------------------------------------------------------------------------
-- 3. HỆ THỐNG AIMBOT TỐI ƯU (ĐÃ FIX LỖI AIM VÀO KHÔNG KHÍ)
--------------------------------------------------------------------------------
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local targetPart = character:FindFirstChild(getgenv().EMBSettings.AimbotPart)
            
            -- Kiểm tra kỹ mục tiêu phải hợp lệ, còn sống và không nằm ở vị trí mặc định lỗi (Vector3.zero)
            if humanoid and humanoid.Health > 0 and targetPart and targetPart.Position ~= Vector3.new(0, 0, 0) then
                local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                
                if onScreen then
                    local mousePos = Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y)
                    local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
                    
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

RunService.RenderStepped:Connect(function()
    if getgenv().EMBSettings.AimbotEnabled then
        local isAiming = UserInputService:IsMouseButtonPressed(getgenv().EMBSettings.AimKey) or UserInputService.TouchEnabled
        
        if isAiming then
            local target = getClosestPlayer()
            if target and target.Character then
                local targetPart = target.Character:FindFirstChild(getgenv().EMBSettings.AimbotPart)
                -- Đảm bảo bộ phận aim tồn tại và người chơi đó chưa chết
                local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
                
                if targetPart and humanoid and humanoid.Health > 0 then
                    local currentCF = Camera.CFrame
                    local targetCF = CFrame.new(Camera.CFrame.Position, targetPart.Position)
                    Camera.CFrame = currentCF:Lerp(targetCF, 1 / getgenv().EMBSettings.Smoothness)
                end
            end
        end
    end
end)
