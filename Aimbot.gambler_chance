-- 2. HỆ THỐNG HỒI SINH TẠI CHỖ CHẾT
----------------------------------------------------------------
local function setupCharacter(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)

    -- Bypass Anti-Cheat & Hồi sinh tại vị trí chết
    if autoRespawnActive and lastDeathCFrame and hrp then
        local connection
        local startTime = tick()
        connection = RunService.Heartbeat:Connect(function()
            if hrp and hrp.Parent then
                hrp.CFrame = lastDeathCFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
            if tick() - startTime > 0.5 then
                connection:Disconnect()
                InfoLabel.Text = "Trạng thái: Đã hồi sinh tại chỗ chết!"
            end
        end)
    end

    if humanoid and hrp then
        local trackConn
        trackConn = RunService.Heartbeat:Connect(function()
            if humanoid.Health > 0 and hrp and hrp.Parent then
                lastDeathCFrame = hrp.CFrame
            else
                if trackConn then trackConn:Disconnect() end
            end
        end)

        humanoid.Died:Connect(function()
            if hrp and hrp.Parent then
                lastDeathCFrame = hrp.CFrame
                InfoLabel.Text = "Trạng thái: Đã lưu vị trí chết!"
            end
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(setupCharacter)
if LocalPlayer.Character then
    setupCharacter(LocalPlayer.Character)
end

----------------------------------------------------------------
-- 3. HỆ THỐNG AIMBOT (NORMAL & HARD)
----------------------------------------------------------------
local function GetClosestTarget()
    local closest, shortestDist = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local humanoid = char:FindFirstChildOfClass("Humanoid")

            if head and humanoid and humanoid.Health > 0 then
                if player.Team ~= LocalPlayer.Team or not player.Team then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        
                        if AimMode == "Normal" then
                            if dist <= FOVRadius and dist < shortestDist then
                                shortestDist = dist
                                closest = head
                            end
                        elseif AimMode == "Hard" then
                            if dist < shortestDist then
                                shortestDist = dist
                                closest = head
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

----------------------------------------------------------------
-- 4. HỆ THỐNG ESP (HIGHLIGHT AN TOÀN)
----------------------------------------------------------------
local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local highlight = char:FindFirstChild("MEB_Highlight")
            
            if ESPEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "MEB_Highlight"
                    highlight.Adornee = char
                    highlight.FillColor = Color3.fromRGB(0, 255, 100)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.Parent = char
                end
                highlight.Enabled = true
            else
                if highlight then
                    highlight.Enabled = false
                end
            end
        end
    end
end

