----------------------------------------------------------------
-- 5. AIMBOT & ESP (RENDERSTEPPED)
----------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    -- Auto Aimbot
    if AimbotEnabled then
        local closest, dist = nil, 250
        local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChildOfClass("Humanoid") and p.Character.Humanoid.Health > 0 then
                local pos, on = Camera:WorldToViewportPoint(p.Character.Head.Position)
                if on then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < dist then closest = p.Character.Head dist = d end
                end
            end
        end
        
        if closest then
            local targetCF = CFrame.new(Camera.CFrame.Position, closest.Position)
            Camera.CFrame = (AimMode == "Hard") and targetCF or Camera.CFrame:Lerp(targetCF, 0.25)
        end
    end
    
    -- ESP Loop
    if ESPEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                local char = p.Character
                local h = char:FindFirstChild("Head")
                if h then
                    if not char:FindFirstChild("MEB_ESP") then
                        local b = Instance.new("BillboardGui", h)
                        b.Name = "MEB_ESP"
                        b.AlwaysOnTop = true
                        b.Size = UDim2.new(0, 100, 0, 50)
                        b.StudsOffset = Vector3.new(0, 2, 0)
                        local t = Instance.new("TextLabel", b)
                        t.Size = UDim2.new(1,0,1,0)
                        t.BackgroundTransparency = 1
                        t.TextStrokeTransparency = 0.2
                        t.Font = Enum.Font.GothamBold
                        t.TextSize = 11
                    end
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local hp = math.floor(hum.Health)
                        char.MEB_ESP.TextLabel.Text = p.Name.."\nHP: "..hp
                        char.MEB_ESP.TextLabel.TextColor3 = (hp > (hum.MaxHealth/2)) and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 80, 80)
                        char.MEB_ESP.Enabled = true
                    else
                        char.MEB_ESP.Enabled = false
                    end
                end
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("MEB_ESP") then
                p.Character.MEB_ESP.Enabled = false
            end
        end
    end
end)

