local function CreateToggle(name, yPos, callback)
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(0.9, 0, 0, 45)
    ToggleBtn.Position = UDim2.new(0.05, 0, 0, yPos)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    ToggleBtn.Text = "  " .. name .. ": [ OFF ]"
    ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    ToggleBtn.TextSize = 14
    ToggleBtn.Font = Enum.Font.SourceSansSemibold
    ToggleBtn.TextXAlignment = Enum.TextXAlignment.Left
    ToggleBtn.Parent = MainFrame

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = ToggleBtn

    local state = false
    ToggleBtn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            ToggleBtn.Text = "  " .. name .. ": [ ON ]"
            ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        else
            ToggleBtn.Text = "  " .. name .. ": [ OFF ]"
            ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        callback(state)
    end)
end

CreateToggle("ESP (Box, Health, Distance)", 60, function(state)
    getgenv().EMBSettings.ESPEnabled = state
end)

CreateToggle("Aimbot (Hold Aim Key)", 120, function(state)
    getgenv().EMBSettings.AimbotEnabled = state
end)

--------------------------------------------------------------------------------
-- 2. HỆ THỐNG ESP (BOX + TÊN + MÁU + KHOẢNG CÁCH)
--------------------------------------------------------------------------------
local espCache = {}

local function createESP(player)
    if player == LocalPlayer then return end
    
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = getgenv().EMBSettings.BoxColor
    box.Thickness = 1.5
    box.Filled = false

    local infoText = Drawing.new("Text")
    infoText.Visible = false
    infoText.Color = getgenv().EMBSettings.TextColor
    infoText.Size = 13
    infoText.Center = true
    infoText.Outline = true

    espCache[player] = {Box = box, Info = infoText}

    player.CharacterRemoving:Connect(function()
        box.Visible = false
        infoText.Visible = false
    end)
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(function(p)
    if espCache[p] then
        espCache[p].Box:Remove()
        espCache[p].Info:Remove()
        espCache[p] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    for player, elements in pairs(espCache) do
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if getgenv().EMBSettings.ESPEnabled and character and rootPart and humanoid and humanoid.Health > 0 then
            local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
            
            if onScreen then
                local head = character:FindFirstChild("Head")
                local topPosition = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
                local bottomPosition = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
                
                local boxHeight = math.abs(topPosition.Y - bottomPosition.Y)
                local boxWidth = boxHeight / 2
                
                -- Cập nhật Box ESP
                elements.Box.Size = Vector2.new(boxWidth, boxHeight)
                elements.Box.Position = Vector2.new(vector.X - boxWidth / 2, topPosition.Y)
                elements.Box.Visible = true
                
                -- Tính toán khoảng cách (Studs) và Máu
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local distance = myRoot and math.floor((rootPart.Position - myRoot.Position).Magnitude) or 0
                local health = math.floor(humanoid.Health)
                local maxHealth = math.floor(humanoid.MaxHealth)
                
                -- Hiển thị Tên | Máu | Khoảng cách
                elements.Info.Text = string.Format("%s [%d/%dHP] (%dm)", player.Name, health, maxHealth, math.floor(distance / 3.5)) -- Quy đổi studs sang mét ảo cho dễ nhìn
                elements.Info.Position = Vector2.new(vector.X, topPosition.Y - 18)
                elements.Info.Visible = true
            else
                elements.Box.Visible = false
                elements.Info.Visible = false
            end
        else
            elements.Box.Visible = false
            elements.Info.Visible = false
        end
    end
end)

--------------------------------------------------------------------------------
-- 3. HỆ THỐNG AIMBOT (ĐÃ FIX HOẠT ĐỘNG TRÊN CLIENT)
--------------------------------------------------------------------------------
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local targetPart = player.Character:FindFirstChild(getgenv().EMBSettings.AimbotPart)
            
            if humanoid and humanoid.Health > 0 and targetPart then
                local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local mousePos = Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y)
                    local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
                    
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

RunService.RenderStepped:Connect(function()
    if getgenv().EMBSettings.AimbotEnabled then
        -- Kiểm tra xem có đang giữ nút Aimbot không (Chuột phải hoặc điều kiện bấm màn hình)
        local isAiming = UserInputService:IsMouseButtonPressed(getgenv().EMBSettings.AimKey) or UserInputService.TouchEnabled
        
        if isAiming then
            local target = getClosestPlayer()
            if target and target.Character then
                local targetPart = target.Character:FindFirstChild(getgenv().EMBSettings.AimbotPart)
                if targetPart then
                    -- Khóa camera mượt mà vào mục tiêu
                    local currentCF = Camera.CFrame
                    local targetCF = CFrame.new(Camera.CFrame.Position, targetPart.Position)
                    Camera.CFrame = currentCF:Lerp(targetCF, 1 / getgenv().EMBSettings.Smoothness)
                end
            end
        end
    end
end)
