-- 4. HỆ THỐNG FLY MOBILE (DÙNG THUMBSTICK & MOVER)
----------------------------------------------------------------
local FlyController = { bg = nil, bv = nil }

local function StartFlying()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    FlyController.bg = Instance.new("BodyGyro")
    FlyController.bg.P = 9e4
    FlyController.bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    FlyController.bg.cframe = rootPart.CFrame
    FlyController.bg.Parent = rootPart

    FlyController.bv = Instance.new("BodyVelocity")
    FlyController.bv.velocity = Vector3.new(0, 0, 0)
    FlyController.bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    FlyController.bv.Parent = rootPart

    if humanoid then humanoid.PlatformStand = true end
    FlyControlsFrame.Visible = true

    task.spawn(function()
        while FlyEnabled and character and character.Parent do
            local hum = character:FindFirstChildOfClass("Humanoid")
            local moveVector = hum and hum.MoveVector or Vector3.new(0, 0, 0) -- Nhận đầu vào từ Cần gạt Mobile
            
            local cameraCFrame = Camera.CFrame
            local flyDir = (cameraCFrame.RightVector * moveVector.X) + (cameraCFrame.LookVector * -moveVector.Z)

            if FlyUp then
                flyDir = flyDir + Vector3.new(0, 1, 0)
            elseif FlyDown then
                flyDir = flyDir - Vector3.new(0, 1, 0)
            end

            if FlyController.bv and FlyController.bg then
                FlyController.bv.velocity = flyDir * FlySpeed
                FlyController.bg.cframe = cameraCFrame
            end
            task.wait()
        end
    end)
end

local function StopFlying()
    if FlyController.bg then FlyController.bg:Destroy() end
    if FlyController.bv then FlyController.bv:Destroy() end
    FlyControlsFrame.Visible = false
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        char:FindFirstChildOfClass("Humanoid").PlatformStand = false
    end
end

