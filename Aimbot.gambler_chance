-- 2. HỆ THỐNG ÉP HỒI SINH TẠI CHỖ CHẾT
----------------------------------------------------------------
local function setupCharacter(char)
    -- Xử lý Ép Hồi Sinh (Bypass Game Spawn System)
    if autoRespawnActive and lastDeathCFrame then
        task.spawn(function()
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            if hrp then
                -- Lặp lại việc đặt tọa độ trong 1 giây đầu để chống game đẩy về bãi hồi sinh
                for i = 1, 10 do
                    hrp.CFrame = lastDeathCFrame
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    task.wait(0.1)
                end
                InfoLabel.Text = "Trạng thái: Đã hồi sinh tại chỗ chết thành công!"
            end
        end)
    end

    -- Theo dõi tọa độ khi còn sống
    task.spawn(function()
        local humanoid = char:WaitForChild("Humanoid", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if humanoid and hrp then
            local trackConn
            trackConn = RunService.Heartbeat:Connect(function()
                if humanoid.Health > 0 and hrp and hrp.Parent then
                    lastDeathCFrame = hrp.CFrame
                else
                    if trackConn then trackConn:Disconnect() end
                end
            end)
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(setupCharacter)
if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end

