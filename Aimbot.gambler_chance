-- 2. HỆ THỐNG TELEPORT LẠI CHỖ CHẾT
----------------------------------------------------------------
local function setupCharacter(char)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local humanoid = char:WaitForChild("Humanoid", 5)

    if not hrp or not humanoid then return end

    -- Dịch chuyển sau khi hồi sinh
    if autoRespawnActive and lastDeathCFrame then
        task.spawn(function()
            -- Đợi 1.5 giây để game load xong (Rất quan trọng)
            task.wait(1.5)
            if char:IsDescendantOf(workspace) and humanoid.Health > 0 then
                -- Dùng PivotTo để dịch chuyển toàn bộ nhân vật an toàn
                char:PivotTo(lastDeathCFrame)
                InfoLabel.Text = "Trạng thái: Đã TP lại chỗ chết!"
                lastDeathCFrame = nil -- Tránh TP liên tục
            end
        end)
    end

    -- Lưu tọa độ khi chết
    humanoid.Died:Connect(function()
        if hrp and hrp.Parent then
            lastDeathCFrame = hrp.CFrame
            InfoLabel.Text = "Trạng thái: Đã lưu vị trí chết!"
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(setupCharacter)
if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end

