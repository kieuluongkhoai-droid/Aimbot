local function setupCharacter(char)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)

    if autoRespawnActive and lastDeathCFrame and hrp then
        isRespawning = true
        local connection
        local startTime = tick()
        connection = RunService.Heartbeat:Connect(function()
            if hrp then
                hrp.CFrame = lastDeathCFrame
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            if tick() - startTime > 0.5 then
                isRespawning = false
                connection:Disconnect()
            end
        end)
    end

    if hum then
        hum.Died:Connect(function()
            if hrp then lastDeathCFrame = hrp.CFrame end
            if FlingMode ~= "OFF" then
                FlingMode = "OFF"
                BtnSpinFling.Text = "🌀 Spin Fling (Xoay): [ OFF ]"
                BtnSpinFling.BackgroundColor3 = Color3.fromRGB(40,40,50)
                BtnGhostFling.Text = "👻 Ghost Fling (Chạy): [ OFF ]"
                BtnGhostFling.BackgroundColor3 = Color3.fromRGB(40,40,50)
            end
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(setupCharacter)
if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end

