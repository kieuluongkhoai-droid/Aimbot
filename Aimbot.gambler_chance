-- 3. HỆ THỐNG AIMBOT & BẮT SỰ KIỆN CHUỘT MỚI
----------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == AimKey then
        isAiming = true
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == AimKey then
        isAiming = false
    end
end)

local function GetClosestTarget()
    local closest, shortestDist = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")

            if head and humanoid and humanoid.Health > 0 then
                if player.Team ~= LocalPlayer.Team or not player.Team then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        
                        if AimMode == "Normal" then
                            if dist <= FOVRadius and dist < shortestDist then
                                shortestDist = dist
                                closest = head
                            end
                        elseif AimMode == "Hard" then
                            if dist < shortestDist then
                                shortestDist = dist
                                closest = head
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

----------------------------------------------------------------
-- 4. HỆ THỐNG ESP TEXT (MÁU VÀ KHOẢNG CÁCH)
----------------------------------------------------------------
local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                -- 1. Xử lý Highlight (Viền sáng)
                local highlight = char:FindFirstChild("MEB_Highlight")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "MEB_Highlight"
                    highlight.Adornee = char
                    highlight.FillColor = Color3.fromRGB(0, 255, 100)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.6
                    highlight.Parent = char
                end
                highlight.Enabled = ESPEnabled

                -- 2. Xử lý Text (Máu & Khoảng cách)
                local bGui = head:FindFirstChild("MEB_ESPText")
                if not bGui then
                    bGui = Instance.new("BillboardGui")
                    bGui.Name = "MEB_ESPText"
                    bGui.AlwaysOnTop = true
                    bGui.Size = UDim2.new(0, 150, 0, 40)
                    bGui.StudsOffset = Vector3.new(0, 2, 0)
                    bGui.Parent = head

                    local textLabel = Instance.new("TextLabel")
                    textLabel.Name = "Info"
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.TextStrokeTransparency = 0.2 -- Viền chữ đen để dễ đọc
                    textLabel.Font = Enum.Font.GothamBold
                    textLabel.TextSize = 11
                    textLabel.Parent = bGui
                end

                bGui.Enabled = ESPEnabled

                -- Cập nhật số liệu liên tục nếu ESP đang bật
                if ESPEnabled then
                    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local distance = 0
                    if myHrp then
                        distance = math.floor((myHrp.Position - head.Position).Magnitude)
                    end
                    
                    local hp = math.floor(humanoid.Health)
                    local maxHp = math.floor(humanoid.MaxHealth)
                    
                    bGui.Info.Text = string.format("%s\nHP: %d/%d | [%dm]", player.Name, hp, maxHp, distance)
                    
                    -- Đổi màu chữ theo lượng máu
                    if (hp / maxHp) > 0.5 then
                        bGui.Info.TextColor3 = Color3.fromRGB(0, 255, 100) -- Xanh
                    else
                        bGui.Info.TextColor3 = Color3.fromRGB(255, 80, 80) -- Đỏ
                    end
                end
            else
                -- Tắt ESP nếu người chơi chết
                local highlight = char:FindFirstChild("MEB_Highlight")
                if highlight then highlight.Enabled = false end
                local bGui = char:FindFirstChild("Head") and char.Head:FindFirstChild("MEB_ESPText")
                if bGui then bGui.Enabled = false end
            end
        end
    end
end

