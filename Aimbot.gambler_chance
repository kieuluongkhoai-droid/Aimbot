----------------------------------------------------------------
-- 6. VÒNG LẶP CHẠY LIÊN TỤC (RENDERSTEPPED)
----------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    -- Xử lý Aimbot với cờ chuột `isAiming` an toàn
    if AimbotEnabled and isAiming then
        local targetHead = GetClosestTarget()
        if targetHead then
            if AimMode == "Hard" then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
            elseif AimMode == "Normal" then
                local targetCF = CFrame.new(Camera.CFrame.Position, targetHead.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCF, 0.2)
            end
        end
    end

    -- Xử lý cập nhật thông số ESP
    if ESPEnabled then
        UpdateESP()
    end
end)
